      "y": -9080,
      "width": 220,
      "height": 80,
      "text": "**写出方程的一般解。**"
    },
    {
      "id": "bbe4929762e340bc",
      "type": "text",
      "x": -109,
      "y": -9080,
      "width": 220,
      "height": 80,
      "text": "**写出齐次方程并求其全部齐次解。**"
    },
    {
      "id": "9b8fcf13d5854fc8",
      "type": "text",
      "x": 141,
      "y": -9080,
      "width": 220,
      "height": 80,
      "text": "**冲击乘数**"
    },
    {
      "id": "eea28c1baad04ade",
      "type": "text",
      "x": -359,
      "y": -8970,
      "width": 220,
      "height": 80,
      "text": "**冲击响应函数**"
    },
    {
      "id": "e3757d73ffea4b77",
      "type": "text",
      "x": -109,
      "y": -8970,
      "width": 220,
      "height": 80,
      "text": "**冲击的短期影响**"
    },
    {
      "id": "a637f2318c894135",
      "type": "text",
      "x": 141,
      "y": -8970,
      "width": 220,
      "height": 80,
      "text": "**几何收敛**"
    },
    {
      "id": "32d71c3a857240bc",
      "type": "text",
      "x": -359,
      "y": -8860,
      "width": 220,
      "height": 80,
      "text": "**分布近似服从正态分布**"
    },
    {
      "id": "360bb70bb47343b8",
      "type": "text",
      "x": -109,
      "y": -8860,
      "width": 220,
      "height": 80,
      "text": "**创新项**"
    },
    {
      "id": "3df6d2e62a854f34",
      "type": "text",
      "x": 141,
      "y": -8860,
      "width": 220,
      "height": 80,
      "text": "**初始偏离的影响**"
    },
    {
      "id": "a7e2433177e54de2",
      "type": "text",
      "x": -359,
      "y": -8750,
      "width": 220,
      "height": 80,
      "text": "**利用初始条件确定常数。**"
    },
    {
      "id": "0fc2f7a8f0f146ad",
      "type": "text",
      "x": -109,
      "y": -8750,
      "width": 220,
      "height": 80,
      "text": "**加入干预项并估计：**"
    },
    {
      "id": "e82f4d4a60f243fa",
      "type": "text",
      "x": 141,
      "y": -8750,
      "width": 220,
      "height": 80,
      "text": "**协整向量**"
    },
    {
      "id": "6ecfb9ca7eaf4b32",
      "type": "text",
      "x": -359,
      "y": -8640,
      "width": 220,
      "height": 80,
      "text": "**协方差平稳过程**"
    },
    {
      "id": "c316aa3074fe46bc",
      "type": "text",
      "x": -109,
      "y": -8640,
      "width": 220,
      "height": 80,
      "text": "**协方差：**"
    },
    {
      "id": "a6104fbc80194765",
      "type": "text",
      "x": 141,
      "y": -8640,
      "width": 220,
      "height": 80,
      "text": "**单整阶数预检**"
    },
    {
      "id": "87a28b73ac874683",
      "type": "text",
      "x": -359,
      "y": -8530,
      "width": 220,
      "height": 80,
      "text": "**即刻影响系数**"
    },
    {
      "id": "1ce549d5a37d422c",
      "type": "text",
      "x": -109,
      "y": -8530,
      "width": 220,
      "height": 80,
      "text": "**即时交叉依赖**"
    },
    {
      "id": "cc66d6a16cdb41c5",
      "type": "text",
      "x": 141,
      "y": -8530,
      "width": 220,
      "height": 80,
      "text": "**原始结构参数数降为9个**"
    },
    {
      "id": "b51885520dea4720",
      "type": "text",
      "x": -359,
      "y": -8420,
      "width": 220,
      "height": 80,
      "text": "**参数漂移**"
    },
    {
      "id": "8586bfa9137b481a",
      "type": "text",
      "x": -109,
      "y": -8420,
      "width": 220,
      "height": 80,
      "text": "**参数节省**"
    },
    {
      "id": "3a5e5d4de1084d76",
      "type": "text",
      "x": 141,
      "y": -8420,
      "width": 220,
      "height": 80,
      "text": "**参数解释**"
    },
    {
      "id": "22311d950c144f4c",
      "type": "text",
      "x": -359,
      "y": -8310,
      "width": 220,
      "height": 80,
      "text": "**发散**"
    },
    {
      "id": "b30d31528ffc4edc",
      "type": "text",
      "x": -109,
      "y": -8310,
      "width": 220,
      "height": 80,
      "text": "**发散的蜘蛛网**"
    },
    {
      "id": "58dfe3c0cb5c4b76",
      "type": "text",
      "x": 141,
      "y": -8310,
      "width": 220,
      "height": 80,
      "text": "**可逆性（invertibility）**"
    },
    {
      "id": "8ceffd08e92f434c",
      "type": "text",
      "x": -359,
      "y": -8200,
      "width": 220,
      "height": 80,
      "text": "**可逆的**"
    },
    {
      "id": "9429e413d11246e5",
      "type": "text",
      "x": -109,
      "y": -8200,
      "width": 220,
      "height": 80,
      "text": "**唯一影响**"
    },
    {
      "id": "ff713a09e0594f74",
      "type": "text",
      "x": 141,
      "y": -8200,
      "width": 220,
      "height": 80,
      "text": "**唯一表示、可识别、可估计**"
    },
    {
      "id": "b87d9f53574e4513",
      "type": "text",
      "x": -359,
      "y": -8090,
      "width": 220,
      "height": 80,
      "text": "**均值受到波动**"
    },
    {
      "id": "8332f113928541e7",
      "type": "text",
      "x": -109,
      "y": -8090,
      "width": 220,
      "height": 80,
      "text": "**均值：**"
    },
    {
      "id": "a801f4a91dd74371",
      "type": "text",
      "x": 141,
      "y": -8090,
      "width": 220,
      "height": 80,
      "text": "**均方预测误差**"
    },
    {
      "id": "7ef5f00adf4f4645",
      "type": "text",
      "x": -359,
      "y": -7980,
      "width": 220,
      "height": 80,
      "text": "**增大**"
    },
    {
      "id": "134eb90d2e7848d0",
      "type": "text",
      "x": -109,
      "y": -7980,
      "width": 220,
      "height": 80,
      "text": "**外生过程（Forcing Process）$x_t$**"
    },
    {
      "id": "59a6c9a4afbf4475",
      "type": "text",
      "x": 141,
      "y": -7980,
      "width": 220,
      "height": 80,
      "text": "**多步误差递推：**"
    },
    {
      "id": "c00cf320c6ba465a",
      "type": "text",
      "x": -359,
      "y": -7870,
      "width": 220,
      "height": 80,
      "text": "**子 $\\sigma$-代数**"
    },
    {
      "id": "3534dca22a8d4949",
      "type": "text",
      "x": -109,
      "y": -7870,
      "width": 220,
      "height": 80,
      "text": "**季节成分（Seasonal Component）$S_t$**"
    },
    {
      "id": "4a3b5830af2848bd",
      "type": "text",
      "x": 141,
      "y": -7870,
      "width": 220,
      "height": 80,
      "text": "**季节调整**"
    },
    {
      "id": "37f936de32d74074",
      "type": "text",
      "x": -359,
      "y": -7760,
      "width": 220,
      "height": 80,
      "text": "**完全静态的**"
    },
    {
      "id": "176927069a124fcd",
      "type": "text",
      "x": -109,
      "y": -7760,
      "width": 220,
      "height": 80,
      "text": "**定义：**"
    },
    {
      "id": "317fff1b415b4747",
      "type": "text",
      "x": 141,
      "y": -7760,
      "width": 220,
      "height": 80,
      "text": "**对于 $i < d$：**"
    },
    {
      "id": "b0a87af5033c43d6",
      "type": "text",
      "x": -359,
      "y": -7650,
      "width": 220,
      "height": 80,
      "text": "**对于 $i \\ge d$：**"
    },
    {
      "id": "9ee30837eac847ab",
      "type": "text",
      "x": -109,
      "y": -7650,
      "width": 220,
      "height": 80,
      "text": "**尖刺**"
    },
    {
      "id": "72a8411d6fec4e75",
      "type": "text",
      "x": 141,
      "y": -7650,
      "width": 220,
      "height": 80,
      "text": "**峰值**"
    },
    {
      "id": "f4a1aeb0a9764274",
      "type": "text",
      "x": -359,
      "y": -7540,
      "width": 220,
      "height": 80,
      "text": "**差分算子表示**"
    },
    {
      "id": "65172b506ed74d14",
      "type": "text",
      "x": -109,
      "y": -7540,
      "width": 220,
      "height": 80,
      "text": "**市场出清条件：**"
    },
    {
      "id": "959481e25f264ab7",
      "type": "text",
      "x": 141,
      "y": -7540,
      "width": 220,
      "height": 80,
      "text": "**带漂移的随机游走**"
    },
    {
      "id": "4c7e44fa583e4fe5",
      "type": "text",
      "x": -359,
      "y": -7430,
      "width": 220,
      "height": 80,
      "text": "**常数特解**"
    },
    {
      "id": "11d28f093de04890",
      "type": "text",
      "x": -109,
      "y": -7430,
      "width": 220,
      "height": 80,
      "text": "**平均落点在靶心上**"
    },
    {
      "id": "b7c36073b03d4d34",
      "type": "text",
      "x": 141,
      "y": -7430,
      "width": 220,
      "height": 80,
      "text": "**平稳 AR(1)**"
    },
    {
      "id": "8a0daa1db1f54ecf",
      "type": "text",
      "x": -359,
      "y": -7320,
      "width": 220,
      "height": 80,
      "text": "**平稳且简约**"
    },
    {
      "id": "1befc8add69348e2",
      "type": "text",
      "x": -109,
      "y": -7320,
      "width": 220,
      "height": 80,
      "text": "**年度季节性**"
    },
    {
      "id": "f17b8cd6dbd8437a",
      "type": "text",
      "x": 141,
      "y": -7320,
      "width": 220,
      "height": 80,
      "text": "**并且偏离**"
    },
    {
      "id": "7ac6fb1e266e4243",
      "type": "text",
      "x": -359,
      "y": -7210,
      "width": 220,
      "height": 80,
      "text": "**弱外生**"
    },
    {
      "id": "a1652afb675c4d42",
      "type": "text",
      "x": -109,
      "y": -7210,
      "width": 220,
      "height": 80,
      "text": "**弱平稳（weakly stationary）或二阶平稳（second-order stationary）**"
    },
    {
      "id": "5b37afb454ee4885",
      "type": "text",
      "x": 141,
      "y": -7210,
      "width": 220,
      "height": 80,
      "text": "**弱收敛**"
    },
    {
      "id": "5bda594d2b644a19",
      "type": "text",
      "x": -359,
      "y": -7100,
      "width": 220,
      "height": 80,
      "text": "**当你在一个更“粗”(信息更少)的σ-代数上取条件期望时，这个操作可以“统辖”(dominate)在更“细”(信息更多)的σ-代数上所做的条件期望**"
    },
    {
      "id": "955a40c8f0ec4342",
      "type": "text",
      "x": -109,
      "y": -7100,
      "width": 220,
      "height": 80,
      "text": "**当期直接影响**"
    },
    {
      "id": "216696bc15e14678",
      "type": "text",
      "x": 141,
      "y": -7100,
      "width": 220,
      "height": 80,
      "text": "**当样本变大时**"
    },
    {
      "id": "4e7cb903e51e4761",
      "type": "text",
      "x": -359,
      "y": -6990,
      "width": 220,
      "height": 80,
      "text": "**当样本量增加时，估计量越来越接近真实值**"
    },
    {
      "id": "737046af2dd544ad",
      "type": "text",
      "x": -109,
      "y": -6990,
      "width": 220,
      "height": 80,
      "text": "**当独立同分布（i.i.d.）的随机变量求和后，归一化后趋近于正态分布**"
    },
    {
      "id": "f9807a3079d0404d",
      "type": "text",
      "x": 141,
      "y": -6990,
      "width": 220,
      "height": 80,
      "text": "**必要条件：**"
    },
    {
      "id": "e961086ae902424b",
      "type": "text",
      "x": -359,
      "y": -6880,
      "width": 220,
      "height": 80,
      "text": "**必须保证**"
    },
    {
      "id": "bb4f70c4abab450a",
      "type": "text",
      "x": -109,
      "y": -6880,
      "width": 220,
      "height": 80,
      "text": "**总体平均（ensemble average）**"
    },
    {
      "id": "7d9afd18f65d4f05",
      "type": "text",
      "x": 141,
      "y": -6880,
      "width": 220,
      "height": 80,
      "text": "**情形1：**"
    },
    {
      "id": "effaeeee29754f49",
      "type": "text",
      "x": -359,
      "y": -6770,
      "width": 220,
      "height": 80,
      "text": "**情形2：**"
    },
    {
      "id": "aa4f309133184e56",
      "type": "text",
      "x": -109,
      "y": -6770,
      "width": 220,
      "height": 80,
      "text": "**情形3：**"
    },
    {
      "id": "4630740f9030414c",
      "type": "text",
      "x": 141,
      "y": -6770,
      "width": 220,
      "height": 80,
      "text": "**截尾**"
    },
    {
      "id": "c23612ccefb64dcc",
      "type": "text",
      "x": -359,
      "y": -6660,
      "width": 220,
      "height": 80,
      "text": "**所有特征根都位于单位圆内部**"
    },
    {
      "id": "3d78cebc591948ca",
      "type": "text",
      "x": -109,
      "y": -6660,
      "width": 220,
      "height": 80,
      "text": "**拖尾**"
    },
    {
      "id": "7b176b3b28d542da",
      "type": "text",
      "x": 141,
      "y": -6660,
      "width": 220,
      "height": 80,
      "text": "**持久性**"
    },
    {
      "id": "e0e2d4147a134835",
      "type": "text",
      "x": -359,
      "y": -6550,
      "width": 220,
      "height": 80,
      "text": "**持续震荡**"
    },
    {
      "id": "5867ec36e11d44f7",
      "type": "text",
      "x": -109,
      "y": -6550,
      "width": 220,
      "height": 80,
      "text": "**收敛的蜘蛛网**"
    },
    {
      "id": "3d63efc2f7504998",
      "type": "text",
      "x": 141,
      "y": -6550,
      "width": 220,
      "height": 80,
      "text": "**整个时间序列的渐近方差**"
    },
    {
      "id": "d0d8f61aa4f840fa",
      "type": "text",
      "x": -359,
      "y": -6440,
      "width": 220,
      "height": 80,
      "text": "**断点已知**"
    },
    {
      "id": "f99f92c3f7464ea1",
      "type": "text",
      "x": -109,
      "y": -6440,
      "width": 220,
      "height": 80,
      "text": "**方差-协方差矩阵**"
    },
    {
      "id": "f369c1a549a04007",
      "type": "text",
      "x": 141,
      "y": -6440,
      "width": 220,
      "height": 80,
      "text": "**方差：**"
    },
    {
      "id": "f8543465b4f14b29",
      "type": "text",
      "x": -359,
      "y": -6330,
      "width": 220,
      "height": 80,
      "text": "**无偏估计量（Unbiased Estimator）**"
    },
    {
      "id": "b23486192324407c",
      "type": "text",
      "x": -109,
      "y": -6330,
      "width": 220,
      "height": 80,
      "text": "**无单位根**"
    },
    {
      "id": "41cf3cbe20084fdd",
      "type": "text",
      "x": 141,
      "y": -6330,
      "width": 220,
      "height": 80,
      "text": "**无当期效应**"
    },
    {
      "id": "0c10cd99a4234882",
      "type": "text",
      "x": -359,
      "y": -6220,
      "width": 220,
      "height": 80,
      "text": "**时间平均（time average）**"
    },
    {
      "id": "b0dc329c768444f9",
      "type": "text",
      "x": -109,
      "y": -6220,
      "width": 220,
      "height": 80,
      "text": "**是时间序列的方差**"
    },
    {
      "id": "c041f20b84294271",
      "type": "text",
      "x": 141,
      "y": -6220,
      "width": 220,
      "height": 80,
      "text": "**是时间序列的自协方差**"
    },
    {
      "id": "c88c5b0999c44db8",
      "type": "text",
      "x": -359,
      "y": -6110,
      "width": 220,
      "height": 80,
      "text": "**显著的**"
    },
    {
      "id": "edda31c590314b19",
      "type": "text",
      "x": -109,
      "y": -6110,
      "width": 220,
      "height": 80,
      "text": "**更大的偏自相关系数**"
    },
    {
      "id": "a7ff90c27a3d4ce2",
      "type": "text",
      "x": 141,
      "y": -6110,
      "width": 220,
      "height": 80,
      "text": "**更陡峭**"
    },
    {
      "id": "6a415a2ad2644c89",
      "type": "text",
      "x": -359,
      "y": -6000,
      "width": 220,
      "height": 80,
      "text": "**最小**"
    },
    {
      "id": "dbd4665c0910463d",
      "type": "text",
      "x": -109,
      "y": -6000,
      "width": 220,
      "height": 80,
      "text": "**有偏的**"
    },
    {
      "id": "761c10ed0ec6487f",
      "type": "text",
      "x": 141,
      "y": -6000,
      "width": 220,
      "height": 80,
      "text": "**有界性条件**"
    },
    {
      "id": "7de88b655d24407c",
      "type": "text",
      "x": -359,
      "y": -5890,
      "width": 220,
      "height": 80,
      "text": "**有限常数均值**"
    },
    {
      "id": "ef4665bad13e4454",
      "type": "text",
      "x": -109,
      "y": -5890,
      "width": 220,
      "height": 80,
      "text": "**有限常数方差**"
    },
    {
      "id": "892594d0aa5c4e7b",
      "type": "text",
      "x": 141,
      "y": -5890,
      "width": 220,
      "height": 80,
      "text": "**有限阶移动平均(MA)过程**"
    },
    {
      "id": "24b6444287ca4b8c",
      "type": "text",
      "x": -359,
      "y": -5780,
      "width": 220,
      "height": 80,
      "text": "**未识别（under-identified）**"
    },
    {
      "id": "bb72351082ed4b29",
      "type": "text",
      "x": -109,
      "y": -5780,
      "width": 220,
      "height": 80,
      "text": "**条件期望为 0 更强**"
    },
    {
      "id": "e3a32932ba3a497c",
      "type": "text",
      "x": 141,
      "y": -5780,
      "width": 220,
      "height": 80,
      "text": "**构造置信区间**"
    },
    {
      "id": "65ee50139b1547c5",
      "type": "text",
      "x": -359,
      "y": -5670,
      "width": 220,
      "height": 80,
      "text": "**样本分段检验：**"
    },
    {
      "id": "393838d3b384491c",
      "type": "text",
      "x": -109,
      "y": -5670,
      "width": 220,
      "height": 80,
      "text": "**样本外预测评估**"
    },
    {
      "id": "3a22cea339ae4ace",
      "type": "text",
      "x": 141,
      "y": -5670,
      "width": 220,
      "height": 80,
      "text": "**样本方差**"
    },
    {
      "id": "2a66c338276e444e",
      "type": "text",
      "x": -359,
      "y": -5560,
      "width": 220,
      "height": 80,
      "text": "**样本自相关**"
    },
    {
      "id": "55edc12912b54a74",
      "type": "text",
      "x": -109,
      "y": -5560,
      "width": 220,
      "height": 80,
      "text": "**根都在单位圆外**"
    },
    {
      "id": "456d0c74678e4823",
      "type": "text",
      "x": 141,
      "y": -5560,
      "width": 220,
      "height": 80,
      "text": "**检测力度**"
    },
    {
      "id": "ce6609c9e677429b",
      "type": "text",
      "x": -359,
      "y": -5450,
      "width": 220,
      "height": 80,
      "text": "**检验二阶条件**"
    },
    {
      "id": "da78f97e759143d5",
      "type": "text",
      "x": -109,
      "y": -5450,
      "width": 220,
      "height": 80,
      "text": "**检验假设**"
    },
    {
      "id": "a8e39a72536c46db",
      "type": "text",
      "x": 141,
      "y": -5450,
      "width": 220,
      "height": 80,
      "text": "**概率测度**"
    },
    {
      "id": "e8b648a38f9b4adb",
      "type": "text",
      "x": -359,
      "y": -5340,
      "width": 220,
      "height": 80,
      "text": "**正向迭代（Forward Iteration）**"
    },
    {
      "id": "d287bc23fb5b43b9",
      "type": "text",
      "x": -109,
      "y": -5340,
      "width": 220,
      "height": 80,
      "text": "**残差拟合优度**"
    },
    {
      "id": "0572d0fcd07d404d",
      "type": "text",
      "x": 141,
      "y": -5340,
      "width": 220,
      "height": 80,
      "text": "**每次抽样都会有误差**"
    },
    {
      "id": "660d2b42ebdd4cf7",
      "type": "text",
      "x": -359,
      "y": -5230,
      "width": 220,
      "height": 80,
      "text": "**求一个特解（特定解）。**"
    },
    {
      "id": "8b6ea04a7c4442b7",
      "type": "text",
      "x": -109,
      "y": -5230,
      "width": 220,
      "height": 80,
      "text": "**求一阶条件**"
    },
    {
      "id": "00623b58050a4372",
      "type": "text",
      "x": 141,
      "y": -5230,
      "width": 220,
      "height": 80,
      "text": "**求解**"
    },
    {
      "id": "f265d08642054e1d",
      "type": "text",
      "x": -359,
      "y": -5120,
      "width": 220,
      "height": 80,
      "text": "**没有格兰杰因果作用**"
    },
    {
      "id": "13948b9f303e40a6",
      "type": "text",
      "x": -109,
      "y": -5120,
      "width": 220,
      "height": 80,
      "text": "**波动性**"
    },
    {
      "id": "854192e914c747d0",
      "type": "text",
      "x": 141,
      "y": -5120,
      "width": 220,
      "height": 80,
      "text": "**波动性的非对称性**"
    },
    {
      "id": "d9f43058b40f4703",
      "type": "text",
      "x": -359,
      "y": -5010,
      "width": 220,
      "height": 80,
      "text": "**波动性聚集现象**"
    },
    {
      "id": "9d9b23fc7688497d",
      "type": "text",
      "x": -109,
      "y": -5010,
      "width": 220,
      "height": 80,
      "text": "**注意事项**"
    },
    {
      "id": "a53f4b74e3f948fa",
      "type": "text",
      "x": 141,
      "y": -5010,
      "width": 220,
      "height": 80,
      "text": "**注释：**"
    },
    {
      "id": "a73b7584ba2d470b",
      "type": "text",
      "x": -359,
      "y": -4900,
      "width": 220,
      "height": 80,
      "text": "**注：**"
    },
    {
      "id": "a0e621d15e3f4380",
      "type": "text",
      "x": -109,
      "y": -4900,
      "width": 220,
      "height": 80,
      "text": "**特定解**"
    },
    {
      "id": "d0da067f1dfc41c8",
      "type": "text",
      "x": 141,
      "y": -4900,
      "width": 220,
      "height": 80,
      "text": "**特征方程**"
    },
    {
      "id": "4e003897164e460d",
      "type": "text",
      "x": -359,
      "y": -4790,
      "width": 220,
      "height": 80,
      "text": "**特点**"
    },
    {
      "id": "1e866634197a4c33",
      "type": "text",
      "x": -109,
      "y": -4790,
      "width": 220,
      "height": 80,
      "text": "**特解猜测形式 $y_t^p$**"
    },
    {
      "id": "dd9e902cbb1a40f8",
      "type": "text",
      "x": 141,
      "y": -4790,
      "width": 220,
      "height": 80,
      "text": "**独立白噪声**"
    },
    {
      "id": "5a051a9c68954347",
      "type": "text",
      "x": -359,
      "y": -4680,
      "width": 220,
      "height": 80,
      "text": "**猜测**"
    },
    {
      "id": "7e8cd47cd69a4b4d",
      "type": "text",
      "x": -109,
      "y": -4680,
      "width": 220,
      "height": 80,
      "text": "**猜测解的结构只包含：时间函数、常数和${\\varepsilon_t}$的项**"
    },
    {
      "id": "297b985563b5497f",
      "type": "text",
      "x": 141,
      "y": -4680,
      "width": 220,
      "height": 80,
      "text": "**的一致估计量（Consistent Estimator）**"
    },
    {
      "id": "e9a9896328d240a0",
      "type": "text",
      "x": -359,
      "y": -4570,
      "width": 220,
      "height": 80,
      "text": "**的增加，随机变量**"
    },
    {
      "id": "a7b8dfc2bf2640fd",
      "type": "text",
      "x": -109,
      "y": -4570,
      "width": 220,
      "height": 80,
      "text": "**的概率越来越小**"
    },
    {
      "id": "658680341abe4fd6",
      "type": "text",
      "x": 141,
      "y": -4570,
      "width": 220,
      "height": 80,
      "text": "**的正向影响**"
    },
    {
      "id": "d674dd42fef44ff4",
      "type": "text",
      "x": -359,
      "y": -4460,
      "width": 220,
      "height": 80,
      "text": "**知道**"
    },
    {
      "id": "e0eaeff4b03d433b",
      "type": "text",
      "x": -109,
      "y": -4460,
      "width": 220,
      "height": 80,
      "text": "**矩条件**"
    },
    {
      "id": "7e334a4c120b4034",
      "type": "text",
      "x": 141,
      "y": -4460,
      "width": 220,
      "height": 80,
      "text": "**短期关系**"
    },
    {
      "id": "ee5b0cd1d74f42dd",
      "type": "text",
      "x": -359,
      "y": -4350,
      "width": 220,
      "height": 80,
      "text": "**示例**"
    },
    {
      "id": "6f1eb933dcce4432",
      "type": "text",
      "x": -109,
      "y": -4350,
      "width": 220,
      "height": 80,
      "text": "**示例 1**"
    },
    {
      "id": "917adb2122d64f20",
      "type": "text",
      "x": 141,
      "y": -4350,
      "width": 220,
      "height": 80,
      "text": "**示例 2**"
    },
    {
      "id": "2c7b70fa61dc42e8",
      "type": "text",
      "x": -359,
      "y": -4240,
      "width": 220,
      "height": 80,
      "text": "**移动平均（MA）部分**"
    },
    {
      "id": "4ff878c8af2e4a75",
      "type": "text",
      "x": -109,
      "y": -4240,
      "width": 220,
      "height": 80,
      "text": "**稳定的特解**"
    },
    {
      "id": "a595e91b652a49e5",
      "type": "text",
      "x": 141,
      "y": -4240,
      "width": 220,
      "height": 80,
      "text": "**稳定的经济比例或等式**"
    },
    {
      "id": "530044374a1f4e9d",
      "type": "text",
      "x": -359,
      "y": -4130,
      "width": 220,
      "height": 80,
      "text": "**稳定要求所有特征根的绝对值都小于1**"
    },
    {
      "id": "cab1d73509d147c6",
      "type": "text",
      "x": -109,
      "y": -4130,
      "width": 220,
      "height": 80,
      "text": "**稳态均值**"
    },
    {
      "id": "e89de4ba82824e51",
      "type": "text",
      "x": 141,
      "y": -4130,
      "width": 220,
      "height": 80,
      "text": "**第$k$个结构冲击在滞后$i$期对第$j$个变量的影响**"
    },
    {
      "id": "2a381760a6584ba5",
      "type": "text",
      "x": -359,
      "y": -4020,
      "width": 220,
      "height": 80,
      "text": "**第1步（齐次方程）：**"
    },
    {
      "id": "e46c6f14344749f5",
      "type": "text",
      "x": -109,
      "y": -4020,
      "width": 220,
      "height": 80,
      "text": "**第2步（特解）：**"
    },
    {
      "id": "9caa272c9ac54fb8",
      "type": "text",
      "x": 141,
      "y": -4020,
      "width": 220,
      "height": 80,
      "text": "**第3步（一般解）：**"
    },
    {
      "id": "6ec88d7f792845bf",
      "type": "text",
      "x": -359,
      "y": -3910,
      "width": 220,
      "height": 80,
      "text": "**第4步（套用初始条件）：**"
    },
    {
      "id": "b77ed8a9a419445d",
      "type": "text",
      "x": -109,
      "y": -3910,
      "width": 220,
      "height": 80,
      "text": "**第一步：求解初始协方差 $\\gamma_0$、$\\gamma_1$**"
    },
    {
      "id": "87fe20656cd54a8a",
      "type": "text",
      "x": 141,
      "y": -3910,
      "width": 220,
      "height": 80,
      "text": "**第三步：转换为ACF**"
    },
    {
      "id": "e60b1667f11e4724",
      "type": "text",
      "x": -359,
      "y": -3800,
      "width": 220,
      "height": 80,
      "text": "**第二步：计算高阶协方差（$k>2$）**"
    },
    {
      "id": "ca11311e98514a30",
      "type": "text",
      "x": -109,
      "y": -3800,
      "width": 220,
      "height": 80,
      "text": "**累计冲击响应函数**"
    },
    {
      "id": "6acdb7e82cbc405c",
      "type": "text",
      "x": 141,
      "y": -3800,
      "width": 220,
      "height": 80,
      "text": "**线性趋势特解**"
    },
    {
      "id": "eba16ddcd644484d",
      "type": "text",
      "x": -359,
      "y": -3690,
      "width": 220,
      "height": 80,
      "text": "**组合预测**"
    },
    {
      "id": "699051ce1b1c4e02",
      "type": "text",
      "x": -109,
      "y": -3690,
      "width": 220,
      "height": 80,
      "text": "**结构冲击**"
    },
    {
      "id": "12d98d9cc4a24d88",
      "type": "text",
      "x": 141,
      "y": -3690,
      "width": 220,
      "height": 80,
      "text": "**结构变化的检验：Chow检验**"
    },
    {
      "id": "2a3709a7a81c4ddd",
      "type": "text",
      "x": -359,
      "y": -3580,
      "width": 220,
      "height": 80,
      "text": "**结构性突变**"
    },
    {
      "id": "852b496c093849cc",
      "type": "text",
      "x": -109,
      "y": -3580,
      "width": 220,
      "height": 80,
      "text": "**结构断裂**"
    },
    {
      "id": "c1f3c90a732a499e",
      "type": "text",
      "x": 141,
      "y": -3580,
      "width": 220,
      "height": 80,
      "text": "**结论：**"
    },
    {
      "id": "5d00d695f5b44485",
      "type": "text",
      "x": -359,
      "y": -3470,
      "width": 220,
      "height": 80,
      "text": "**脉冲响应**"
    },
    {
      "id": "278bb7c5bbeb4506",
      "type": "text",
      "x": -109,
      "y": -3470,
      "width": 220,
      "height": 80,
      "text": "**脉冲响应序列**"
    },
    {
      "id": "e75f008f3a174f3f",
      "type": "text",
      "x": 141,
      "y": -3470,
      "width": 220,
      "height": 80,
      "text": "**自动蕴含**"
    },
    {
      "id": "017d9bc01f914a70",
      "type": "text",
      "x": -359,
      "y": -3360,
      "width": 220,
      "height": 80,
      "text": "**自协方差仅与滞后有关**"
    },
    {
      "id": "c20159c0fcb84273",
      "type": "text",
      "x": -109,
      "y": -3360,
      "width": 220,
      "height": 80,
      "text": "**自相关图**"
    },
    {
      "id": "4504e0162b2341f9",
      "type": "text",
      "x": 141,
      "y": -3360,
      "width": 220,
      "height": 80,
      "text": "**自相关图（correlogram）**"
    },
    {
      "id": "11b3e1cad7754ad0",
      "type": "text",
      "x": -359,
      "y": -3250,
      "width": 220,
      "height": 80,
      "text": "**自相关性**"
    },
    {
      "id": "9e0b7e4d670a4b50",
      "type": "text",
      "x": -109,
      "y": -3250,
      "width": 220,
      "height": 80,
      "text": "**自身滞后**"
    },
    {
      "id": "c24d97e874ce4728",
      "type": "text",
      "x": 141,
      "y": -3250,
      "width": 220,
      "height": 80,
      "text": "**表示定理**"
    },
    {
      "id": "8f67c497e6ed42ff",
      "type": "text",
      "x": -359,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**许多时间序列的波动性并不恒定**"
    },
    {
      "id": "38dc2405fdcb4684",
      "type": "text",
      "x": -109,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**识别阶段（Identification）**"
    },
    {
      "id": "50c8396700a44248",
      "type": "text",
      "x": 141,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**误差**"
    },
    {
      "id": "b7cb3cdf3d9844cb",
      "type": "text",
      "x": -359,
      "y": -3030,
      "width": 220,
      "height": 80,
      "text": "**误差修正速度**"
    },
    {
      "id": "125ffc25b4784d07",
      "type": "text",
      "x": -109,
      "y": -3030,
      "width": 220,
      "height": 80,
      "text": "**误差项**"
    },
    {
      "id": "15a2b96badda470e",
      "type": "text",
      "x": 141,
      "y": -3030,
      "width": 220,
      "height": 80,
      "text": "**超过这个范围**"
    },
    {
      "id": "61eec8f872874e05",
      "type": "text",
      "x": -359,
      "y": -2920,
      "width": 220,
      "height": 80,
      "text": "**越来越接近某个固定的随机变量**"
    },
    {
      "id": "0cb8b2b9279d44c6",
      "type": "text",
      "x": -109,
      "y": -2920,
      "width": 220,
      "height": 80,
      "text": "**趋势平稳**"
    },
    {
      "id": "0758004a80a44085",
      "type": "text",
      "x": 141,
      "y": -2920,
      "width": 220,
      "height": 80,
      "text": "**趋势成分（Trend Component）$T_t$**"
    },
    {
      "id": "7e2e4e5d18bc44f3",
      "type": "text",
      "x": -359,
      "y": -2810,
      "width": 220,
      "height": 80,
      "text": "**较平缓**"
    },
    {
      "id": "59138fbd778747c6",
      "type": "text",
      "x": -109,
      "y": -2810,
      "width": 220,
      "height": 80,
      "text": "**递归地重构**"
    },
    {
      "id": "7ec5b6dcb43c4296",
      "type": "text",
      "x": 141,
      "y": -2810,
      "width": 220,
      "height": 80,
      "text": "**递推关系**"
    },
    {
      "id": "ec7a6b221cff46f6",
      "type": "text",
      "x": -359,
      "y": -2700,
      "width": 220,
      "height": 80,
      "text": "**部分和**"
    },
    {
      "id": "a75c6631b32a42bc",
      "type": "text",
      "x": -109,
      "y": -2700,
      "width": 220,
      "height": 80,
      "text": "**重要的是**"
    },
    {
      "id": "5e056ae4c69a437b",
      "type": "text",
      "x": 141,
      "y": -2700,
      "width": 220,
      "height": 80,
      "text": "**长期偏离**"
    },
    {
      "id": "861c8eb2b31741e8",
      "type": "text",
      "x": -359,
      "y": -2590,
      "width": 220,
      "height": 80,
      "text": "**长期均值**"
    },
    {
      "id": "cd695d0260b04960",
      "type": "text",
      "x": -109,
      "y": -2590,
      "width": 220,
      "height": 80,
      "text": "**长期均值的变化：**"
    },
    {
      "id": "144888a2e5eb4b8d",
      "type": "text",
      "x": 141,
      "y": -2590,
      "width": 220,
      "height": 80,
      "text": "**长期平均值是对的**"
    },
    {
      "id": "25c65c7968ed4800",
      "type": "text",
      "x": -359,
      "y": -2480,
      "width": 220,
      "height": 80,
      "text": "**长期稳定关系**"
    },
    {
      "id": "eb1308a182154a18",
      "type": "text",
      "x": -109,
      "y": -2480,
      "width": 220,
      "height": 80,
      "text": "**长期预测**"
    },
    {
      "id": "3950f9116afb4139",
      "type": "text",
      "x": 141,
      "y": -2480,
      "width": 220,
      "height": 80,
      "text": "**随机变量的分布**"
    },
    {
      "id": "357a07a759b04489",
      "type": "text",
      "x": -359,
      "y": -2370,
      "width": 220,
      "height": 80,
      "text": "**随机扰动**"
    },
    {
      "id": "9e0e71e3400f4214",
      "type": "text",
      "x": -109,
      "y": -2370,
      "width": 220,
      "height": 80,
      "text": "**随着样本数量**"
    },
    {
      "id": "cbbf5a69c9bb4642",
      "type": "text",
      "x": 141,
      "y": -2370,
      "width": 220,
