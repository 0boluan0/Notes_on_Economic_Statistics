      "id": "7582fd1f8ca946d6",
      "type": "text",
      "x": -359,
      "y": -7429,
      "width": 220,
      "height": 80,
      "text": "**对于 $i \\ge d$：**"
    },
    {
      "id": "5201f830d71d4ea8",
      "type": "text",
      "x": -109,
      "y": -7429,
      "width": 220,
      "height": 80,
      "text": "**尖刺**"
    },
