      "id": "0a21474b71844a47",
      "type": "text",
      "x": 141,
      "y": -5779,
      "width": 220,
      "height": 80,
      "text": "**时间序列分析的目标**"
    },
    {
      "id": "366b194079624980",
      "type": "text",
      "x": -359,
      "y": -5669,
      "width": 220,
      "height": 80,
      "text": "**是时间序列的方差**"
    },
    {
      "id": "f7e66ffdb88241e9",
      "type": "text",
      "x": -109,
      "y": -5669,
      "width": 220,
      "height": 80,
      "text": "**是时间序列的自协方差**"
    },
    {
      "id": "fad5d1a5b171498a",
      "type": "text",
      "x": 141,
      "y": -5669,
      "width": 220,
      "height": 80,
      "text": "**显著的**"
    },
    {
      "id": "6ad86b0f91344aaf",
      "type": "text",
      "x": -359,
      "y": -5559,
      "width": 220,
      "height": 80,
      "text": "**更大的偏自相关系数**"
    },
    {
      "id": "70ff2f53f6fd4d7a",
      "type": "text",
      "x": -109,
      "y": -5559,
      "width": 220,
      "height": 80,
      "text": "**更陡峭**"
    },
    {
      "id": "81749cc70505438c",
      "type": "text",
      "x": 141,
      "y": -5559,
      "width": 220,
      "height": 80,
      "text": "**最大特征值统计量（Max-eigenvalue test）**"
    },
    {
      "id": "e2cb8a5ecab345c7",
      "type": "text",
      "x": -359,
      "y": -5449,
      "width": 220,
      "height": 80,
      "text": "**最小**"
    },
    {
      "id": "b86d9ed4242b4a5c",
      "type": "text",
      "x": -109,
      "y": -5449,
      "width": 220,
      "height": 80,
      "text": "**有偏的**"
    },
    {
      "id": "07cf44317f1047d0",
      "type": "text",
      "x": 141,
      "y": -5449,
      "width": 220,
      "height": 80,
      "text": "**有界性条件**"
    },
    {
      "id": "e85e2378c08b4ec1",
      "type": "text",
      "x": -359,
      "y": -5339,
      "width": 220,
      "height": 80,
      "text": "**有限常数均值**"
    },
    {
      "id": "207b02c86a5d482e",
      "type": "text",
      "x": -109,
      "y": -5339,
      "width": 220,
      "height": 80,
      "text": "**有限常数方差**"
    },
    {
      "id": "a3b0073632d54b64",
      "type": "text",
      "x": 141,
      "y": -5339,
      "width": 220,
      "height": 80,
      "text": "**有限阶移动平均(MA)过程**"
    },
    {
      "id": "dc82ebd4de4142b1",
      "type": "text",
      "x": -359,
      "y": -5229,
      "width": 220,
      "height": 80,
      "text": "**未识别（under-identified）**"
    },
    {
      "id": "477e0ac072ef4250",
      "type": "text",
      "x": -109,
      "y": -5229,
      "width": 220,
      "height": 80,
      "text": "**条件期望为 0 更强**"
    },
    {
      "id": "0fb3234d9ac9497c",
      "type": "text",
      "x": 141,
      "y": -5229,
      "width": 220,
      "height": 80,
      "text": "**构造置信区间**"
    },
    {
      "id": "7dccb5769fec46c3",
      "type": "text",
      "x": -359,
      "y": -5119,
      "width": 220,
      "height": 80,
      "text": "**样本分段检验：**"
    },
    {
      "id": "1ec15edb392f4ffb",
      "type": "text",
      "x": -109,
      "y": -5119,
      "width": 220,
      "height": 80,
      "text": "**样本均值**"
    },
    {
      "id": "ecb19c59b34142aa",
      "type": "text",
      "x": 141,
      "y": -5119,
      "width": 220,
      "height": 80,
      "text": "**样本外预测评估**"
    },
    {
      "id": "5a3611ec94f5467f",
      "type": "text",
      "x": -359,
      "y": -5009,
      "width": 220,
      "height": 80,
      "text": "**样本方差**"
    },
    {
      "id": "4a57448607244c08",
      "type": "text",
      "x": -109,
      "y": -5009,
      "width": 220,
      "height": 80,
      "text": "**样本自相关**"
    },
    {
      "id": "c4655ae7e65540de",
      "type": "text",
      "x": 141,
      "y": -5009,
      "width": 220,
      "height": 80,
      "text": "**根都在单位圆外**"
    },
    {
      "id": "36764f33c2614802",
      "type": "text",
      "x": -359,
      "y": -4899,
      "width": 220,
      "height": 80,
      "text": "**检测力度**"
    },
    {
      "id": "404790d5beb949a5",
      "type": "text",
      "x": -109,
      "y": -4899,
      "width": 220,
      "height": 80,
      "text": "**检验二阶条件**"
    },
    {
      "id": "357e9155725b4538",
      "type": "text",
      "x": 141,
      "y": -4899,
      "width": 220,
      "height": 80,
      "text": "**检验假设**"
    },
    {
      "id": "ed772104ac4646d5",
      "type": "text",
      "x": -359,
      "y": -4789,
      "width": 220,
      "height": 80,
      "text": "**检验统计量**"
    },
    {
      "id": "2b3f9ff85f664c5e",
      "type": "text",
      "x": -109,
      "y": -4789,
      "width": 220,
      "height": 80,
      "text": "**概率测度**"
    },
    {
      "id": "b8037754cfef44c5",
      "type": "text",
      "x": 141,
      "y": -4789,
      "width": 220,
      "height": 80,
      "text": "**概率论复习**"
    },
    {
      "id": "89f4de17f0c2473a",
      "type": "text",
      "x": -359,
      "y": -4679,
      "width": 220,
      "height": 80,
      "text": "**正向迭代（Forward Iteration）**"
    },
    {
      "id": "5fb7f9b95a1b4bcb",
      "type": "text",
      "x": -109,
      "y": -4679,
      "width": 220,
      "height": 80,
      "text": "**残差拟合优度**"
    },
    {
      "id": "3e57deef663943e7",
      "type": "text",
      "x": 141,
      "y": -4679,
      "width": 220,
      "height": 80,
      "text": "**每次抽样都会有误差**"
    },
    {
      "id": "94670422cf044865",
      "type": "text",
      "x": -359,
      "y": -4569,
      "width": 220,
      "height": 80,
      "text": "**求一个特解（特定解）。**"
    },
    {
      "id": "0c881fad3ad447ef",
      "type": "text",
      "x": -109,
      "y": -4569,
      "width": 220,
      "height": 80,
      "text": "**求一阶条件**"
    },
    {
      "id": "fa8ddf9568df42ea",
      "type": "text",
      "x": 141,
      "y": -4569,
      "width": 220,
      "height": 80,
      "text": "**求解**"
    },
    {
      "id": "95fdc2243d8640a4",
      "type": "text",
      "x": -359,
      "y": -4459,
      "width": 220,
      "height": 80,
      "text": "**没有格兰杰因果作用**"
    },
    {
      "id": "6a5f28adb62341b0",
      "type": "text",
      "x": -109,
      "y": -4459,
      "width": 220,
      "height": 80,
      "text": "**波动建模**"
    },
    {
      "id": "85e4ed43c9334c83",
      "type": "text",
      "x": 141,
      "y": -4459,
      "width": 220,
      "height": 80,
      "text": "**波动性**"
    },
    {
      "id": "bcdb16b66ebf432b",
      "type": "text",
      "x": -359,
      "y": -4349,
      "width": 220,
      "height": 80,
      "text": "**波动性的非对称性**"
    },
    {
      "id": "c2f012169abf47a2",
      "type": "text",
      "x": -109,
      "y": -4349,
      "width": 220,
      "height": 80,
      "text": "**波动性聚集现象**"
    },
    {
      "id": "6d30c428771c41fb",
      "type": "text",
      "x": 141,
      "y": -4349,
      "width": 220,
      "height": 80,
      "text": "**注意事项**"
    },
    {
      "id": "863afd35125440ad",
      "type": "text",
      "x": -359,
      "y": -4239,
      "width": 220,
      "height": 80,
      "text": "**注意：**"
    },
    {
      "id": "fc4423fdb9744fc9",
      "type": "text",
      "x": -109,
      "y": -4239,
      "width": 220,
      "height": 80,
      "text": "**注释：**"
    },
    {
      "id": "a8b97ca7058343a6",
      "type": "text",
      "x": 141,
      "y": -4239,
      "width": 220,
      "height": 80,
      "text": "**注：**"
    },
    {
      "id": "8450bd5281e04d45",
      "type": "text",
      "x": -359,
      "y": -4129,
      "width": 220,
      "height": 80,
      "text": "**特定解**"
    },
    {
      "id": "78d6bd9c1d204f8c",
      "type": "text",
      "x": -109,
      "y": -4129,
      "width": 220,
      "height": 80,
      "text": "**特征方程**"
    },
    {
      "id": "1ab2be82ff0e4b19",
      "type": "text",
      "x": 141,
      "y": -4129,
      "width": 220,
      "height": 80,
      "text": "**特点**"
    },
    {
      "id": "a2defb3005b94d52",
      "type": "text",
      "x": -359,
      "y": -4019,
      "width": 220,
      "height": 80,
      "text": "**特解猜测形式 $y_t^p$**"
    },
    {
      "id": "3480ad4678224e71",
      "type": "text",
      "x": -109,
      "y": -4019,
      "width": 220,
      "height": 80,
      "text": "**独立白噪声**"
    },
    {
      "id": "e05dbd082dc846c6",
      "type": "text",
      "x": 141,
      "y": -4019,
      "width": 220,
      "height": 80,
      "text": "**猜测**"
    },
    {
      "id": "3663582ba7fc4e27",
      "type": "text",
      "x": -359,
      "y": -3909,
      "width": 220,
      "height": 80,
      "text": "**猜测解的结构只包含：时间函数、常数和${\\varepsilon_t}$的项**"
    },
    {
      "id": "ee1c1d6e599c4593",
      "type": "text",
      "x": -109,
      "y": -3909,
      "width": 220,
      "height": 80,
      "text": "**的一致估计量（Consistent Estimator）**"
    },
    {
      "id": "dba54400dbff4e37",
      "type": "text",
      "x": 141,
      "y": -3909,
      "width": 220,
      "height": 80,
      "text": "**的增加，随机变量**"
    },
    {
      "id": "8562defeb3024703",
      "type": "text",
      "x": -359,
      "y": -3799,
      "width": 220,
      "height": 80,
      "text": "**的概率越来越小**"
    },
    {
      "id": "b87419721ecc42c2",
      "type": "text",
      "x": -109,
      "y": -3799,
      "width": 220,
      "height": 80,
      "text": "**的正向影响**"
    },
    {
      "id": "a1294ddf9e5d45fc",
      "type": "text",
      "x": 141,
      "y": -3799,
      "width": 220,
      "height": 80,
      "text": "**目的**"
    },
    {
      "id": "5cad072d6b714e84",
      "type": "text",
      "x": -359,
      "y": -3689,
      "width": 220,
      "height": 80,
      "text": "**直观理解**"
    },
    {
      "id": "aa7f0650563b4a69",
      "type": "text",
      "x": -109,
      "y": -3689,
      "width": 220,
      "height": 80,
      "text": "**知道**"
    },
    {
      "id": "4c1406c3fa4d4ffc",
      "type": "text",
      "x": 141,
      "y": -3689,
      "width": 220,
      "height": 80,
      "text": "**矩条件**"
    },
    {
      "id": "ec15c3f1e2714af8",
      "type": "text",
      "x": -359,
      "y": -3579,
      "width": 220,
      "height": 80,
      "text": "**短期关系**"
    },
    {
      "id": "e714a5857f424186",
      "type": "text",
      "x": -109,
      "y": -3579,
      "width": 220,
      "height": 80,
      "text": "**示例**"
    },
    {
      "id": "a8bafe939be24945",
      "type": "text",
      "x": 141,
      "y": -3579,
      "width": 220,
      "height": 80,
      "text": "**示例 1**"
    },
    {
      "id": "c7081054150b432e",
      "type": "text",
      "x": -359,
      "y": -3469,
      "width": 220,
      "height": 80,
      "text": "**示例 2**"
    },
    {
      "id": "d6710346dfab4efe",
      "type": "text",
      "x": -109,
      "y": -3469,
      "width": 220,
      "height": 80,
      "text": "**移动平均（MA）部分**"
    },
    {
      "id": "735daf7574b444e1",
      "type": "text",
      "x": 141,
      "y": -3469,
      "width": 220,
      "height": 80,
      "text": "**稳定的特解**"
    },
    {
      "id": "e366aca7631e4a9c",
      "type": "text",
      "x": -359,
      "y": -3359,
      "width": 220,
      "height": 80,
      "text": "**稳定的经济比例或等式**"
    },
    {
      "id": "b8a61baebb8b4ab3",
      "type": "text",
      "x": -109,
      "y": -3359,
      "width": 220,
      "height": 80,
      "text": "**稳定要求所有特征根的绝对值都小于1**"
    },
    {
      "id": "c9a0b06736224c0b",
      "type": "text",
      "x": 141,
      "y": -3359,
      "width": 220,
      "height": 80,
      "text": "**稳态均值**"
    },
    {
      "id": "653e30ce61994faa",
      "type": "text",
      "x": -359,
      "y": -3249,
      "width": 220,
      "height": 80,
      "text": "**第$k$个结构冲击在滞后$i$期对第$j$个变量的影响**"
    },
    {
      "id": "4c060e6e6630495c",
      "type": "text",
      "x": -109,
      "y": -3249,
      "width": 220,
      "height": 80,
      "text": "**第1步（齐次方程）：**"
    },
    {
      "id": "d33a95d160db4d0f",
      "type": "text",
      "x": 141,
      "y": -3249,
      "width": 220,
      "height": 80,
      "text": "**第2步（特解）：**"
    },
    {
      "id": "a39bbe861301459a",
      "type": "text",
      "x": -359,
      "y": -3139,
      "width": 220,
      "height": 80,
      "text": "**第3步（一般解）：**"
    },
    {
      "id": "3a1d9464068544ec",
      "type": "text",
      "x": -109,
      "y": -3139,
      "width": 220,
      "height": 80,
      "text": "**第4步（套用初始条件）：**"
    },
    {
      "id": "3bb59e12493c4317",
      "type": "text",
      "x": 141,
      "y": -3139,
      "width": 220,
      "height": 80,
      "text": "**第一步：求解初始协方差 $\\gamma_0$、$\\gamma_1$**"
    },
    {
      "id": "d73faa24a15b41b9",
      "type": "text",
      "x": -359,
      "y": -3029,
      "width": 220,
      "height": 80,
      "text": "**第三步：转换为ACF**"
    },
    {
      "id": "e49a06f62ef84516",
      "type": "text",
      "x": -109,
      "y": -3029,
      "width": 220,
      "height": 80,
      "text": "**第二步：计算高阶协方差（$k>2$）**"
    },
    {
      "id": "f6788a20fc724aee",
      "type": "text",
      "x": 141,
      "y": -3029,
      "width": 220,
      "height": 80,
      "text": "**累计冲击响应函数**"
    },
    {
      "id": "b30e3b8059bc445a",
      "type": "text",
      "x": -359,
      "y": -2919,
      "width": 220,
      "height": 80,
      "text": "**线性差分方程和其解Linear Difference Equation and Its Solution**"
    },
    {
      "id": "941909b90162471f",
      "type": "text",
      "x": -109,
      "y": -2919,
      "width": 220,
      "height": 80,
      "text": "**线性时间序列ARMA**"
    },
    {
      "id": "74e7aa4a4cbb45ce",
      "type": "text",
      "x": 141,
      "y": -2919,
      "width": 220,
      "height": 80,
      "text": "**线性趋势特解**"
    },
    {
      "id": "7e0cc2cbf8954696",
      "type": "text",
      "x": -359,
      "y": -2809,
      "width": 220,
      "height": 80,
      "text": "**组合预测**"
    },
    {
      "id": "51c40c4a6da84de1",
      "type": "text",
      "x": -109,
      "y": -2809,
      "width": 220,
      "height": 80,
      "text": "**结构冲击**"
    },
    {
      "id": "4a3a81514ad94a37",
      "type": "text",
      "x": 141,
      "y": -2809,
      "width": 220,
      "height": 80,
      "text": "**结构变化的检验：Chow检验**"
    },
    {
      "id": "e4342f6d315d4138",
      "type": "text",
      "x": -359,
      "y": -2699,
      "width": 220,
      "height": 80,
      "text": "**结构性突变**"
    },
    {
      "id": "e92b73abd6fb4589",
      "type": "text",
      "x": -109,
      "y": -2699,
      "width": 220,
      "height": 80,
      "text": "**结构断裂**"
    },
    {
      "id": "bdd15f374c52406d",
      "type": "text",
      "x": 141,
      "y": -2699,
      "width": 220,
      "height": 80,
      "text": "**结论：**"
    },
    {
      "id": "7e72e38d0af9442f",
      "type": "text",
      "x": -359,
      "y": -2589,
      "width": 220,
      "height": 80,
      "text": "**统计学复习**"
    },
    {
      "id": "53c539a9daa74aac",
      "type": "text",
      "x": -109,
      "y": -2589,
      "width": 220,
      "height": 80,
      "text": "**脉冲响应**"
    },
    {
      "id": "67afbba1ea554096",
      "type": "text",
      "x": 141,
      "y": -2589,
      "width": 220,
      "height": 80,
      "text": "**脉冲响应序列**"
    },
    {
      "id": "e1b39005636f4954",
      "type": "text",
      "x": -359,
      "y": -2479,
      "width": 220,
      "height": 80,
      "text": "**自动蕴含**"
    },
    {
      "id": "fc8e98106da1435b",
      "type": "text",
      "x": -109,
      "y": -2479,
      "width": 220,
      "height": 80,
      "text": "**自协方差**"
    },
    {
      "id": "ae273bf1b87244f1",
      "type": "text",
      "x": 141,
      "y": -2479,
      "width": 220,
      "height": 80,
      "text": "**自协方差仅与滞后有关**"
    },
    {
      "id": "eb512f909b794635",
      "type": "text",
      "x": -359,
      "y": -2369,
      "width": 220,
      "height": 80,
      "text": "**自回归分布滞后ADL  Autoregressive Distributed Lag**"
    },
