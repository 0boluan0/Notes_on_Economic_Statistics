      "id": "44d54e31818c4be7",
      "type": "text",
      "x": -359,
      "y": -10399,
      "width": 220,
      "height": 80,
      "text": "**严格平稳**"
    },
    {
      "id": "d03caca2feaa43f0",
      "type": "text",
      "x": -109,
      "y": -10399,
      "width": 220,
      "height": 80,
      "text": "**中是已知的**"
    },
