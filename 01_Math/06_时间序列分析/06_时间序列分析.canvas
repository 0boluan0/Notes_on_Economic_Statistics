      "id": "b8ce87cca00b415a",
      "type": "text",
      "x": -359,
      "y": -10509,
      "width": 220,
      "height": 80,
      "text": "**不平稳**"
    },
    {
      "id": "ee51b235741a4b85",
      "type": "text",
      "x": -109,
      "y": -10509,
      "width": 220,
      "height": 80,
      "text": "**不规则成分（Irregular Component）$I_t$**"
