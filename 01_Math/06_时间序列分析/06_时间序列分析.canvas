      "y": 4974,
      "width": 220,
      "height": 80,
      "text": "**OLS Estimation Steps**"
    },
    {
      "id": "2d1e17073f2d41ea",
      "type": "text",
      "x": 8480,
      "y": 4974,
      "width": 220,
      "height": 80,
      "text": "**3 干预效应的识别与估计步骤**"
    },
