      "id": "9166ae2b759c4ea1",
      "type": "text",
      "x": -109,
      "y": -10179,
      "width": 220,
      "height": 80,
      "text": "**介绍**"
    },
    {
      "id": "dc7eebf65e5d45b3",
      "type": "text",
      "x": 141,
      "y": -10179,
      "width": 220,
      "height": 80,
      "text": "**价格与供给-需求**"
    },
    {
      "id": "3d9ea4d43d014212",
      "type": "text",
      "x": -359,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**任意**"
    },
    {
      "id": "ef220529b2984be9",
      "type": "text",
      "x": -109,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**优于**"
    },
    {
      "id": "950cb6d1c8514645",
      "type": "text",
      "x": 141,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**传递函数**"
    },
    {
      "id": "9abbb87ed42e4599",
      "type": "text",
      "x": -359,
      "y": -9959,
      "width": 220,
      "height": 80,
      "text": "**传递函数 $C(L)$ 无法唯一确定**"
    },
    {
      "id": "a78f95eb830c4020",
      "type": "text",
      "x": -109,
      "y": -9959,
      "width": 220,
      "height": 80,
      "text": "**传递函数权重**"
    },
    {
      "id": "36fe57ba0ad64ea4",
      "type": "text",
      "x": 141,
      "y": -9959,
      "width": 220,
      "height": 80,
      "text": "**估计长期关系并检验残差平稳**"
    },
    {
      "id": "288fc6eb59154d4a",
      "type": "text",
      "x": -359,
      "y": -9849,
      "width": 220,
      "height": 80,
      "text": "**估计阶段（Estimation）**"
    },
    {
      "id": "118d1ad77a3a4f42",
      "type": "text",
      "x": -109,
      "y": -9849,
      "width": 220,
      "height": 80,
      "text": "**但是**"
    },
    {
      "id": "cd6cc44727c24428",
      "type": "text",
      "x": 141,
      "y": -9849,
      "width": 220,
      "height": 80,
      "text": "**作业**"
    },
    {
      "id": "a6085ec387b147d1",
      "type": "text",
      "x": -359,
      "y": -9739,
      "width": 220,
      "height": 80,
      "text": "**例子：二阶线性差分方程的求解**"
    },
    {
      "id": "7f0eb4a495c449d8",
      "type": "text",
      "x": -109,
      "y": -9739,
      "width": 220,
      "height": 80,
      "text": "**供给方程：**"
    },
    {
      "id": "300868e9bd92454e",
      "type": "text",
      "x": 141,
      "y": -9739,
      "width": 220,
      "height": 80,
      "text": "**依分布收敛**"
    },
    {
      "id": "5c8f25945d5e4f55",
      "type": "text",
      "x": -359,
      "y": -9629,
      "width": 220,
      "height": 80,
      "text": "**依概率收敛于总体均值**"
    },
    {
      "id": "cb55cbd725a14fe3",
      "type": "text",
      "x": -109,
      "y": -9629,
      "width": 220,
      "height": 80,
      "text": "**充分条件：**"
    },
    {
      "id": "e04de19afc454b38",
      "type": "text",
      "x": 141,
      "y": -9629,
      "width": 220,
      "height": 80,
      "text": "**公平抛硬币**"
    },
    {
      "id": "efdc6863c84a49ef",
      "type": "text",
      "x": -359,
      "y": -9519,
      "width": 220,
      "height": 80,
      "text": "**共同的随机趋势**"
    },
    {
      "id": "b41157c0bb644a7e",
      "type": "text",
      "x": -109,
      "y": -9519,
      "width": 220,
      "height": 80,
      "text": "**共同趋势**"
    },
    {
      "id": "7aded86e525d4aff",
      "type": "text",
      "x": 141,
      "y": -9519,
      "width": 220,
      "height": 80,
      "text": "**共轭复根**"
    },
    {
      "id": "c91bf76df779440f",
      "type": "text",
      "x": -359,
      "y": -9409,
      "width": 220,
      "height": 80,
      "text": "**关系类型**"
    },
    {
      "id": "ad6e29b4313d4010",
      "type": "text",
      "x": -109,
      "y": -9409,
      "width": 220,
      "height": 80,
      "text": "**其中$h_t$依赖于$q$阶误差平方**"
    },
    {
      "id": "ad9d563289d147e9",
      "type": "text",
      "x": 141,
      "y": -9409,
      "width": 220,
      "height": 80,
      "text": "**内生变量**"
    },
    {
      "id": "46ec42c089034837",
      "type": "text",
      "x": -359,
      "y": -9299,
      "width": 220,
      "height": 80,
      "text": "**内生结构变化**"
    },
    {
      "id": "b30144ddcfb04830",
      "type": "text",
      "x": -109,
      "y": -9299,
      "width": 220,
      "height": 80,
      "text": "**写出似然函数并取对数**"
    },
    {
      "id": "6ee0845c1f724b39",
      "type": "text",
      "x": 141,
      "y": -9299,
      "width": 220,
      "height": 80,
      "text": "**写出方程的一般解。**"
    },
    {
      "id": "4ba6efd7f5ce4393",
      "type": "text",
      "x": -359,
      "y": -9189,
      "width": 220,
      "height": 80,
      "text": "**写出齐次方程并求其全部齐次解。**"
    },
    {
      "id": "2d1a98f551d04998",
      "type": "text",
      "x": -109,
      "y": -9189,
      "width": 220,
      "height": 80,
      "text": "**冲击乘数**"
    },
    {
      "id": "f02f6e873fa345ee",
      "type": "text",
      "x": 141,
      "y": -9189,
