    {
      "id": "9d98a64acd93481b",
      "type": "text",
      "x": -359,
      "y": -4019,
      "width": 220,
      "height": 80,
      "text": "**Submodular and Supermodular Games**"
    },
    {
      "id": "47da019af0e342c3",
      "type": "text",
      "x": -109,
      "y": -4019,
      "width": 220,
      "height": 80,
      "text": "**type**"
    },
    {
      "id": "0ca0c813d88a42c5",
      "type": "text",
      "x": 141,
      "y": -4019,
      "width": 220,
      "height": 80,
      "text": "**一个案例**"
    },
    {
      "id": "b97ad690d4954378",
      "type": "text",
      "x": -359,
      "y": -3909,
      "width": 220,
      "height": 80,
      "text": "**一种不同的情况**"
    },
    {
      "id": "847a37df6be94e21",
      "type": "text",
      "x": -109,
      "y": -3909,
      "width": 220,
      "height": 80,
      "text": "**两个犯人先后审问**"
    },
    {
      "id": "75d38ade6896427e",
      "type": "text",
      "x": 141,
      "y": -3909,
      "width": 220,
      "height": 80,
      "text": "**严格优势策略定义（Definition 4）**"
    },
    {
      "id": "6ef58daad9784870",
      "type": "text",
      "x": -359,
      "y": -3799,
      "width": 220,
      "height": 80,
      "text": "**严格劣于**"
    },
    {
      "id": "03c16493941b434b",
      "type": "text",
      "x": -109,
      "y": -3799,
      "width": 220,
      "height": 80,
      "text": "**严格劣势策略定义（Definition 3）**"
    },
    {
      "id": "cd0f1a45d67e4030",
      "type": "text",
      "x": 141,
      "y": -3799,
      "width": 220,
      "height": 80,
      "text": "**严格占优**"
    },
    {
      "id": "47191e32d67b44bc",
      "type": "text",
      "x": -359,
      "y": -3689,
      "width": 220,
      "height": 80,
      "text": "**严格占优策略定义（Definition 2）**"
    },
    {
      "id": "c6690c8f01b64385",
      "type": "text",
      "x": -109,
      "y": -3689,
      "width": 220,
      "height": 80,
      "text": "**为什会先增加后减少？**"
    },
    {
      "id": "09cfa0f1ff3145a2",
      "type": "text",
      "x": 141,
      "y": -3689,
      "width": 220,
      "height": 80,
      "text": "**五元素**"
    },
    {
      "id": "f795f182dd7d4bce",
      "type": "text",
      "x": -359,
      "y": -3579,
      "width": 220,
      "height": 80,
      "text": "**介绍**"
    },
    {
      "id": "72037c76340a466d",
      "type": "text",
      "x": -109,
      "y": -3579,
      "width": 220,
      "height": 80,
      "text": "**价格竞争(Price Competition)**"
    },
    {
      "id": "8af2217becf442a2",
      "type": "text",
      "x": 141,
      "y": -3579,
      "width": 220,
      "height": 80,
      "text": "**优势策略均衡**"
    },
    {
      "id": "be167a8c0e644dc1",
      "type": "text",
      "x": -359,
      "y": -3469,
      "width": 220,
      "height": 80,
      "text": "**使用精炼贝叶斯均衡的案例**"
    },
    {
      "id": "e1bf9a808a074175",
      "type": "text",
      "x": -109,
      "y": -3469,
      "width": 220,
      "height": 80,
      "text": "**信息集information set**"
    },
    {
      "id": "1b120f826d42454e",
      "type": "text",
      "x": 141,
      "y": -3469,
      "width": 220,
      "height": 80,
      "text": "**信息集概念**"
    },
    {
      "id": "934db5b5c4e443c9",
      "type": "text",
      "x": -359,
      "y": -3359,
      "width": 220,
      "height": 80,
      "text": "**其他相似情形**"
    },
    {
      "id": "5c8ce92dfc754f12",
      "type": "text",
      "x": -109,
      "y": -3359,
      "width": 220,
      "height": 80,
      "text": "**内容**"
    },
    {
      "id": "dabd89a7cf2d4c28",
      "type": "text",
      "x": 141,
      "y": -3359,
      "width": 220,
      "height": 80,
      "text": "**分析**"
    },
    {
      "id": "f1698831e3834040",
      "type": "text",
      "x": -359,
      "y": -3249,
      "width": 220,
      "height": 80,
      "text": "**分析-最优反应函数的求解**"
    },
    {
      "id": "c0df8e1639f74183",
      "type": "text",
      "x": -109,
      "y": -3249,
      "width": 220,
      "height": 80,
      "text": "**分类**"
    },
    {
      "id": "e5c84455fcf9421b",
      "type": "text",
      "x": 141,
      "y": -3249,
      "width": 220,
      "height": 80,
      "text": "**变体:belief的引入**"
    },
    {
      "id": "19966251954a4c5d",
      "type": "text",
      "x": -359,
      "y": -3139,
      "width": 220,
      "height": 80,
      "text": "**变体：correlated types**"
    },
    {
      "id": "79425cf719c74a2e",
      "type": "text",
      "x": -109,
      "y": -3139,
      "width": 220,
      "height": 80,
      "text": "**可理性化 Rationalisability**"
    },
    {
      "id": "409606ed87e247ae",
