    },
    {
      "id": "25d60c1c1d444366",
      "type": "text",
      "x": -109,
      "y": -11280,
      "width": 220,
      "height": 80,
      "text": "**协方差矩阵：**"
    },
    {
      "id": "ed8e0d509a2441ed",
      "type": "text",
      "x": 141,
      "y": -11280,
      "width": 220,
      "height": 80,
      "text": "**单个变量检验**"
    },
    {
      "id": "e7b3ffe53bd24750",
