      "id": "50ffc9a1339f4f63",
      "type": "text",
      "x": 141,
      "y": -12050,
      "width": 220,
      "height": 80,
      "text": "**分布转化为 F 分布**"
    },
    {
      "id": "41faf1d309484c6d",
      "type": "text",
      "x": -359,
      "y": -11940,
      "width": 220,
      "height": 80,
      "text": "**分布：**"
    },
    {
      "id": "17765b761c964e16",
      "type": "text",
      "x": -109,
      "y": -11940,
      "width": 220,
      "height": 80,
      "text": "**分类**"
