      "id": "a0589429cf974577",
      "type": "text",
      "x": -359,
      "y": -11830,
      "width": 220,
      "height": 80,
      "text": "**分类规则**"
    },
    {
      "id": "5ea892a57c5d49fc",
      "type": "text",
      "x": -109,
      "y": -11830,
      "width": 220,
      "height": 80,
      "text": "**分解形式：**"
    },
    {
      "id": "fd6939eb852b4b50",
      "type": "text",
      "x": 141,
      "y": -11830,
      "width": 220,
      "height": 80,
      "text": "**判别**"
    },
