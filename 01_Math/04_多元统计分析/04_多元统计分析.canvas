      "height": 80,
      "text": "**半正定矩阵**"
    },
    {
      "id": "7093e0519c3649e9",
      "type": "text",
      "x": 141,
      "y": -11500,
      "width": 220,
      "height": 80,
      "text": "**半正定矩阵 (Non-Negative Definite Matrix)**"
