    },
    {
      "id": "59266a27287a450d",
      "type": "text",
      "x": 141,
      "y": -14360,
      "width": 220,
      "height": 80,
      "text": "**Relationship Between Covariance and Correlation Matrices (协方差矩阵与相关系数矩阵的关系)**"
    },
    {
      "id": "627d8c8268864fb2",
      "type": "text",
      "x": -359,
      "y": -14250,
      "width": 220,
      "height": 80,
      "text": "**Scree Plot**"
    },
    {
      "id": "cae2f338d04744ea",
      "type": "text",
      "x": -109,
      "y": -14250,
      "width": 220,
      "height": 80,
      "text": "**Shapiro-Wilk 或 Kolmogorov-Smirnov 检验**"
    },
    {
      "id": "32338a32421b4bb6",
      "type": "text",
      "x": 141,
      "y": -14250,
      "width": 220,
      "height": 80,
      "text": "**Singular Matrix**"
    },
    {
      "id": "e6c4f8c9b7464682",
      "type": "text",
      "x": -359,
      "y": -14140,
      "width": 220,
      "height": 80,
      "text": "**Source of Variation**"
    },
    {
      "id": "b39d447c40e04915",
      "type": "text",
      "x": -109,
      "y": -14140,
      "width": 220,
      "height": 80,
      "text": "**SSP 矩阵**"
    },
    {
      "id": "42bbb7fe19dc4f60",
      "type": "text",
      "x": 141,
      "y": -14140,
      "width": 220,
      "height": 80,
      "text": "**Standardization (标准化)**"
    },
    {
      "id": "47d386c8eed84b08",
      "type": "text",
      "x": -359,
      "y": -14030,
      "width": 220,
      "height": 80,
      "text": "**Testing Hypotheses about the Mean Vector**"
    },
    {
      "id": "502242465abd4958",
      "type": "text",
      "x": -109,
      "y": -14030,
      "width": 220,
      "height": 80,
      "text": "**Testing Hypotheses about the Mean Vector (均值向量的假设检验)**"
    },
    {
      "id": "bf2442a2179b44f2",
      "type": "text",
      "x": 141,
      "y": -14030,
      "width": 220,
      "height": 80,
      "text": "**Transformed Parametric Functions**"
    },
    {
      "id": "d31dbdfab19645fd",
      "type": "text",
      "x": -359,
      "y": -13920,
      "width": 220,
      "height": 80,
      "text": "**Wilks’ Lambda**"
    },
    {
      "id": "c6035a61ac994f09",
      "type": "text",
      "x": -109,
      "y": -13920,
      "width": 220,
      "height": 80,
      "text": "**Wishart 分布 (Wishart Distribution)**"
    },
    {
      "id": "3fa6210aeca44bf6",
      "type": "text",
      "x": 141,
      "y": -13920,
      "width": 220,
      "height": 80,
      "text": "**Wishart分布的形成原理**"
    },
    {
      "id": "24a6681d96f94fb3",
      "type": "text",
      "x": -359,
      "y": -13810,
      "width": 220,
      "height": 80,
      "text": "**一个简单例子：**"
    },
    {
      "id": "ad4a3bccaf6046c0",
      "type": "text",
      "x": -109,
      "y": -13810,
      "width": 220,
      "height": 80,
      "text": "**一个简单的直观认识**"
    },
    {
      "id": "321f1021edbf4e34",
      "type": "text",
      "x": 141,
      "y": -13810,
      "width": 220,
      "height": 80,
      "text": "**一句话概括**"
    },
