      "id": "47e660466e4442c4",
      "type": "text",
      "x": -359,
      "y": -13700,
      "width": 220,
      "height": 80,
      "text": "**三维空间**"
    },
    {
      "id": "141cd485f0cc4ade",
      "type": "text",
      "x": -109,
      "y": -13700,
      "width": 220,
      "height": 80,
      "text": "**上调**"
    },
    {
      "id": "ad30b8c8c8b64dba",
      "type": "text",
      "x": 141,
      "y": -13700,
      "width": 220,
      "height": 80,
      "text": "**与主成分分析（PCA）的关系**"
    },
    {
      "id": "6daec8eccc61460e",
      "type": "text",
      "x": -359,
      "y": -13590,
      "width": 220,
      "height": 80,
      "text": "**两个总体的协方差矩阵不同**"
    },
    {
      "id": "6a0ad4452b8c45da",
      "type": "text",
      "x": -109,
      "y": -13590,
      "width": 220,
      "height": 80,
      "text": "**中位数**"
    },
    {
      "id": "bd0675859c78423c",
      "type": "text",
      "x": 141,
      "y": -13590,
      "width": 220,
      "height": 80,
      "text": "**中心极限定理 (Central Limit Theorem, CLT)**"
    },
    {
      "id": "86dc73129ee94c0a",
      "type": "text",
      "x": -359,
      "y": -13480,
      "width": 220,
      "height": 80,
      "text": "**中心极限定理(多元)**"
    },
    {
      "id": "a080db490c7c4c79",
      "type": "text",
      "x": -109,
      "y": -13480,
      "width": 220,
      "height": 80,
      "text": "**临界值：**"
    },
    {
      "id": "8a9fe1daef8d4118",
      "type": "text",
      "x": 141,
      "y": -13480,
      "width": 220,
      "height": 80,
      "text": "**主成分分析 (Principal Component Analysis, PCA)**"
    },
    {
      "id": "13454c4ed3414f00",
      "type": "text",
      "x": -359,
      "y": -13370,
      "width": 220,
      "height": 80,
      "text": "**主成分分析（PCA）简介**"
    },
    {
      "id": "42558b01e5944259",
      "type": "text",
      "x": -109,
      "y": -13370,
      "width": 220,
      "height": 80,
      "text": "**主成分的选择**"
    },
    {
      "id": "561fbc78ee0249bf",
      "type": "text",
      "x": 141,
      "y": -13370,
      "width": 220,
      "height": 80,
      "text": "**主要结论与应用**"
    },
    {
      "id": "2c17cd284e354875",
      "type": "text",
      "x": -359,
      "y": -13260,
      "width": 220,
      "height": 80,
      "text": "**举例**"
    },
    {
      "id": "445682092d8243c7",
      "type": "text",
      "x": -109,
      "y": -13260,
      "width": 220,
      "height": 80,
      "text": "**乘法性质**"
    },
    {
      "id": "575d6e7f54c848d9",
      "type": "text",
      "x": 141,
      "y": -13260,
      "width": 220,
      "height": 80,
      "text": "**二次型 (Quadratic Form)**"
    },
    {
      "id": "f9a20f77c5a74a28",
      "type": "text",
      "x": -359,
      "y": -13150,
      "width": 220,
      "height": 80,
      "text": "**二次型的作用：**"
    },
    {
      "id": "96fc2a0ceead46f0",
      "type": "text",
      "x": -109,
      "y": -13150,
      "width": 220,
      "height": 80,
      "text": "**二维**"
    },
    {
      "id": "cd1bbe8573a14880",
      "type": "text",
      "x": 141,
      "y": -13150,
      "width": 220,
      "height": 80,
      "text": "**二维空间**"
    },
    {
      "id": "7b278afb812d41a7",
      "type": "text",
      "x": -359,
      "y": -13040,
      "width": 220,
      "height": 80,
      "text": "**互不依赖的Wishart随机矩阵之和**"
    },
    {
      "id": "b684a763e17046a8",
      "type": "text",
      "x": -109,
      "y": -13040,
      "width": 220,
      "height": 80,
      "text": "**以 $\\mu$ 为中心的椭球体**"
    },
    {
      "id": "da271a6ffbec4310",
      "type": "text",
      "x": 141,
      "y": -13040,
      "width": 220,
      "height": 80,
      "text": "**似然比检验（Likelihood Ratio Test, LRT）**"
    },
    {
      "id": "4e506572414c4538",
      "type": "text",
      "x": -359,
      "y": -12930,
      "width": 220,
      "height": 80,
      "text": "**似然比检验：**"
    },
    {
      "id": "58f3eb2b22b04b7e",
      "type": "text",
      "x": -109,
      "y": -12930,
      "width": 220,
      "height": 80,
      "text": "**似然比统计量：**"
    },
    {
      "id": "9e6594b0890f4203",
      "type": "text",
      "x": 141,
      "y": -12930,
      "width": 220,
      "height": 80,
      "text": "**使用相关矩阵（Correlation Matrix）替代**"
    },
    {
      "id": "38634c2073044b20",
      "type": "text",
      "x": -359,
      "y": -12820,
      "width": 220,
      "height": 80,
      "text": "**例子 1: 二阶矩阵**"
    },
    {
      "id": "54bd91fa8ad44405",
      "type": "text",
      "x": -109,
      "y": -12820,
      "width": 220,
      "height": 80,
      "text": "**例子 1: 对称正定矩阵**"
    },
    {
      "id": "e6139197d6f040e1",
      "type": "text",
      "x": 141,
      "y": -12820,
      "width": 220,
      "height": 80,
      "text": "**例子 1: 简单对称正定矩阵**"
    },
    {
      "id": "d165d8565a0741c8",
      "type": "text",
      "x": -359,
      "y": -12710,
      "width": 220,
      "height": 80,
      "text": "**例子 2: 三阶矩阵**"
    },
    {
      "id": "27d1f0b99fd84068",
      "type": "text",
      "x": -109,
      "y": -12710,
      "width": 220,
      "height": 80,
      "text": "**例子 2: 半正定矩阵**"
    },
    {
      "id": "9d5c025631e042a4",
      "type": "text",
      "x": 141,
      "y": -12710,
      "width": 220,
      "height": 80,
      "text": "**例子 2: 非对角矩阵**"
    },
    {
      "id": "7722aa0f90cf4aaf",
      "type": "text",
      "x": -359,
      "y": -12600,
      "width": 220,
      "height": 80,
      "text": "**例子与直观理解**"
    },
    {
      "id": "aede02fa4ae24032",
      "type": "text",
      "x": -109,
      "y": -12600,
      "width": 220,
      "height": 80,
      "text": "**例题**"
    },
    {
      "id": "69fc3acbaa9840b4",
      "type": "text",
      "x": 141,
      "y": -12600,
      "width": 220,
      "height": 80,
      "text": "**假设**"
    },
    {
      "id": "5536654c492445d6",
      "type": "text",
      "x": -359,
      "y": -12490,
      "width": 220,
      "height": 80,
      "text": "**假设检验**"
    },
    {
      "id": "90871e7334b04aa5",
      "type": "text",
      "x": -109,
      "y": -12490,
      "width": 220,
      "height": 80,
      "text": "**假设检验的目标 (Objective of Hypothesis Testing)**"
    },
    {
      "id": "e0dfc140340a4b9f",
      "type": "text",
      "x": 141,
      "y": -12490,
      "width": 220,
      "height": 80,
      "text": "**偏度与峰度检验 (Skewness and Kurtosis Test)**"
    },
    {
      "id": "307e6f4a57514637",
      "type": "text",
      "x": -359,
      "y": -12380,
      "width": 220,
      "height": 80,
      "text": "**充分统计量**"
    },
    {
      "id": "e8f70095e53e4f09",
      "type": "text",
      "x": -109,
      "y": -12380,
      "width": 220,
      "height": 80,
      "text": "**先估计参数$\\theta$，再对估计结果$\\hat{\\theta}$做函数变换$h(\\hat{\\theta})$**"
    },
    {
      "id": "5591dffd2890480f",
      "type": "text",
      "x": 141,
      "y": -12380,
      "width": 220,
      "height": 80,
      "text": "**先对$\\theta$做函数变换$h(\\theta)$，再对$h(\\theta)$做最大似然估计**"
    },
    {
      "id": "4a6d1f1bd46b43e2",
      "type": "text",
      "x": -359,
      "y": -12270,
      "width": 220,
      "height": 80,
      "text": "**先验概率**"
    },
    {
      "id": "da127e45dd4041dd",
      "type": "text",
      "x": -109,
      "y": -12270,
      "width": 220,
      "height": 80,
      "text": "**具体案例分析**"
    },
    {
      "id": "ef3c2e03f1aa4ead",
      "type": "text",
      "x": 141,
      "y": -12270,
      "width": 220,
      "height": 80,
      "text": "**内积为零**"
    },
    {
      "id": "012f151cb1284f32",
      "type": "text",
      "x": -359,
      "y": -12160,
      "width": 220,
      "height": 80,
      "text": "**几何/直观理解**"
    },
    {
      "id": "8fd3fab348d8453f",
      "type": "text",
      "x": -109,
      "y": -12160,
      "width": 220,
      "height": 80,
      "text": "**几何意义：**"
    },
    {
      "id": "c7071ee026b34352",
      "type": "text",
      "x": 141,
      "y": -12160,
      "width": 220,
      "height": 80,
      "text": "**几何或统计推断应用**"
    },
    {
      "id": "733449d4504149a9",
      "type": "text",
      "x": -359,
      "y": -12050,
      "width": 220,
      "height": 80,
      "text": "**分块向量与协方差的分块**"
    },
    {
      "id": "d552c2c86b8e43c9",
      "type": "text",
      "x": -109,
      "y": -12050,
      "width": 220,
      "height": 80,
      "text": "**分布**"
    },
