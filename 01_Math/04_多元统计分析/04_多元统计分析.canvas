    {
      "id": "d5472ebfe71744fb",
      "type": "text",
      "x": 141,
      "y": -11610,
      "width": 220,
      "height": 80,
      "text": "**区域 $R_2$**"
    },
    {
      "id": "ac3f7713e6ef402e",
      "type": "text",
      "x": -359,
      "y": -11500,
      "width": 220,
      "height": 80,
      "text": "**区间长度**"
    },
    {
      "id": "138c7167b38f40ad",
