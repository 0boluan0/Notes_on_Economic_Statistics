      "x": 141,
      "y": -11720,
      "width": 220,
      "height": 80,
      "text": "**前置示例设定**"
    },
    {
      "id": "d528097a556d43bc",
      "type": "text",
      "x": -359,
      "y": -11610,
      "width": 220,
      "height": 80,
      "text": "**加权距离**"
    },
    {
      "id": "a7a8ad8de5d440aa",
