      "id": "38df4073a27c42db",
      "type": "text",
      "x": 141,
      "y": -11389,
      "width": 220,
      "height": 80,
      "text": "**互不依赖**"
    },
    {
      "id": "639552149ecb4278",
      "type": "text",
      "x": -359,
      "y": -11279,
      "width": 220,
      "height": 80,
      "text": "**互相关函数**"
    },
