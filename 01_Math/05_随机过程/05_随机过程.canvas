      "id": "a83d78ac4b1a4596",
      "type": "text",
      "x": 141,
      "y": -10729,
      "width": 220,
      "height": 80,
      "text": "**几何分布**"
    },
    {
      "id": "febdcc24df764f1a",
      "type": "text",
      "x": -359,
      "y": -10619,
      "width": 220,
      "height": 80,
      "text": "**几何概率**"
    },
    {
      "id": "e804bfdd4247450c",
      "type": "text",
      "x": -109,
      "y": -10619,
      "width": 220,
      "height": 80,
      "text": "**几种重要的随机过程**"
    },
    {
      "id": "456e55eb35814e01",
      "type": "text",
      "x": 141,
      "y": -10619,
      "width": 220,
      "height": 80,
      "text": "**分块**"
    },
    {
      "id": "8a3e63a71a8d4c47",
      "type": "text",
      "x": -359,
      "y": -10509,
      "width": 220,
      "height": 80,
      "text": "**分布名称**"
    },
    {
      "id": "d015a215f6144902",
      "type": "text",
      "x": -109,
      "y": -10509,
      "width": 220,
      "height": 80,
      "text": "**分析：**"
    },
    {
      "id": "30c1055cb81441fb",
      "type": "text",
      "x": 141,
      "y": -10509,
      "width": 220,
      "height": 80,
      "text": "**初值**"
    },
