      "id": "89f7177ef6484e34",
      "type": "text",
      "x": 141,
      "y": -10070,
      "width": 220,
      "height": 80,
      "text": "**· 柯尔莫哥洛夫存在定理：**"
    },
    {
      "id": "4b728d93452b4daa",
      "type": "text",
      "x": -359,
      "y": -9960,
      "width": 220,
      "height": 80,
      "text": "**“独立增量 + 平稳增量 + 泊松分布”**"
    },
    {
      "id": "f85bb4817cb947ae",
      "type": "text",
      "x": -109,
      "y": -9960,
      "width": 220,
      "height": 80,
      "text": "**一、选择题**"
    },
    {
      "id": "bf9a1a91782f4f8c",
      "type": "text",
      "x": 141,
      "y": -9960,
      "width": 220,
      "height": 80,
      "text": "**一、选择题 (每题 4 分，共 20 分)**"
    },
    {
      "id": "a8d3445ce61c45ef",
      "type": "text",
      "x": -359,
      "y": -9850,
      "width": 220,
      "height": 80,
      "text": "**一步转移概率矩阵**"
    },
    {
      "id": "f2813c0fb6af4d65",
      "type": "text",
      "x": -109,
      "y": -9850,
      "width": 220,
      "height": 80,
      "text": "**三、计算题**"
    },
    {
      "id": "0b3d171d88054bb8",
      "type": "text",
      "x": 141,
      "y": -9850,
      "width": 220,
      "height": 80,
      "text": "**三、计算题 (每题 10 分，共 60 分)**"
    },
    {
      "id": "f1a501767d464513",
      "type": "text",
      "x": -359,
      "y": -9740,
      "width": 220,
      "height": 80,
      "text": "**三个相关分布**"
    },
    {
      "id": "04732b534399454a",
      "type": "text",
      "x": -109,
      "y": -9740,
      "width": 220,
      "height": 80,
      "text": "**不可约(irreducible)**"
    },
    {
      "id": "a6b4e42a130d41b2",
      "type": "text",
      "x": 141,
      "y": -9740,
      "width": 220,
      "height": 80,
      "text": "**不可约性**"
    },
    {
      "id": "719fa8dd4efd4d7e",
      "type": "text",
      "x": -359,
      "y": -9630,
      "width": 220,
      "height": 80,
      "text": "**不可约的**"
    },
    {
      "id": "ec4214cd86c34afb",
      "type": "text",
      "x": -109,
      "y": -9630,
      "width": 220,
      "height": 80,
      "text": "**不可约非周期链**"
    },
    {
      "id": "1c29602530c741a9",
      "type": "text",
      "x": 141,
      "y": -9630,
      "width": 220,
      "height": 80,
      "text": "**不属于考试范围**"
    },
    {
      "id": "392a8a1033694b9a",
      "type": "text",
      "x": -359,
      "y": -9520,
      "width": 220,
      "height": 80,
      "text": "**不独立事件**"
    },
    {
      "id": "6f1031fc16c24e06",
      "type": "text",
      "x": -109,
      "y": -9520,
      "width": 220,
      "height": 80,
      "text": "**不相关**"
    },
    {
      "id": "2e297d607a7c46fb",
      "type": "text",
      "x": 141,
      "y": -9520,
      "width": 220,
      "height": 80,
      "text": "**不随时间变化**"
    },
    {
      "id": "29c5c30018fb4613",
      "type": "text",
      "x": -359,
      "y": -9410,
      "width": 220,
      "height": 80,
      "text": "**两两独立不等于相互独立**"
