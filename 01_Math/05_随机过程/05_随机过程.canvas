      "x": 141,
      "y": -12599,
      "width": 220,
      "height": 80,
      "text": "**一、选择题**"
    },
    {
      "id": "8b31814c34b34285",
      "type": "text",
      "x": -359,
      "y": -12489,
      "width": 220,
      "height": 80,
      "text": "**一、选择题 (每题 4 分，共 20 分)**"
    },
    {
      "id": "6847e5e1004643d3",
      "type": "text",
      "x": -109,
      "y": -12489,
      "width": 220,
      "height": 80,
      "text": "**一步转移概率矩阵**"
    },
    {
      "id": "280fb505f8504e9c",
      "type": "text",
      "x": 141,
      "y": -12489,
      "width": 220,
      "height": 80,
      "text": "**三、计算题**"
    },
    {
      "id": "e5e726edae3a4927",
      "type": "text",
      "x": -359,
      "y": -12379,
      "width": 220,
      "height": 80,
      "text": "**三、计算题 (每题 10 分，共 60 分)**"
    },
    {
      "id": "9506d55631ee4ad4",
      "type": "text",
      "x": -109,
      "y": -12379,
      "width": 220,
      "height": 80,
      "text": "**三个相关分布**"
    },
    {
      "id": "41f173de71514249",
      "type": "text",
      "x": 141,
      "y": -12379,
      "width": 220,
      "height": 80,
      "text": "**不可约(irreducible)**"
    },
    {
      "id": "76021da14d2e4fc8",
      "type": "text",
      "x": -359,
      "y": -12269,
      "width": 220,
      "height": 80,
      "text": "**不可约性**"
    },
    {
      "id": "d4f1bfa5c7e441fd",
      "type": "text",
      "x": -109,
      "y": -12269,
      "width": 220,
      "height": 80,
      "text": "**不可约的**"
    },
    {
      "id": "7a600c43be964f33",
      "type": "text",
      "x": 141,
      "y": -12269,
      "width": 220,
      "height": 80,
      "text": "**不可约闭集**"
    },
    {
      "id": "49b02c69496f455f",
      "type": "text",
      "x": -359,
      "y": -12159,
      "width": 220,
      "height": 80,
      "text": "**不可约非周期链**"
    },
    {
      "id": "0944c056764b474e",
      "type": "text",
      "x": -109,
      "y": -12159,
      "width": 220,
      "height": 80,
      "text": "**不属于考试范围**"
    },
    {
      "id": "0bf09df031874661",
      "type": "text",
      "x": 141,
      "y": -12159,
      "width": 220,
      "height": 80,
      "text": "**不独立事件**"
    },
    {
      "id": "17eb7940284e49bc",
      "type": "text",
      "x": -359,
      "y": -12049,
      "width": 220,
      "height": 80,
      "text": "**不相关**"
    },
    {
      "id": "cd64a9ea7b6a4412",
      "type": "text",
      "x": -109,
      "y": -12049,
      "width": 220,
      "height": 80,
      "text": "**不考滤过**"
    },
    {
      "id": "79d664cbaf4e4d21",
      "type": "text",
      "x": 141,
      "y": -12049,
      "width": 220,
      "height": 80,
      "text": "**不随时间变化**"
    },
    {
      "id": "89eadf1fb2bb4267",
      "type": "text",
      "x": -359,
      "y": -11939,
      "width": 220,
      "height": 80,
      "text": "**两两独立不等于相互独立**"
    },
    {
      "id": "377635bb82b74242",
      "type": "text",
      "x": -109,
      "y": -11939,
      "width": 220,
      "height": 80,
      "text": "**两个分解**"
    },
    {
      "id": "4a06bc41181b4f5d",
      "type": "text",
      "x": 141,
      "y": -11939,
      "width": 220,
      "height": 80,
      "text": "**两个平稳过程之和的相关函数**"
    },
    {
      "id": "8e7e00c5e64c45e5",
      "type": "text",
      "x": -359,
      "y": -11829,
      "width": 220,
      "height": 80,
      "text": "**严平稳**"
    },
    {
      "id": "cd67f8508f914583",
      "type": "text",
      "x": -109,
      "y": -11829,
      "width": 220,
      "height": 80,
      "text": "**严平稳 (Strict-sense stationary)**"
    },
    {
      "id": "b8db61feb1bd4053",
      "type": "text",
      "x": 141,
      "y": -11829,
      "width": 220,
      "height": 80,
      "text": "**严平稳与宽平稳**"
    },
