    {
      "id": "7539e25d1104450b",
      "type": "text",
      "x": -109,
      "y": -10399,
      "width": 220,
      "height": 80,
      "text": "**判断均值是否具有各态历经性的方法**"
    },
    {
      "id": "ea8c4b6526014501",
      "type": "text",
      "x": 141,
      "y": -10399,
      "width": 220,
      "height": 80,
      "text": "**判断相关函数是否具有各态历经性的方法**"
    },
    {
      "id": "61f33533daf84010",
      "type": "text",
      "x": -359,
      "y": -10289,
      "width": 220,
      "height": 80,
      "text": "**到达时间的条件分布**"
    },
    {
      "id": "8e700760c4a14076",
      "type": "text",
      "x": -109,
      "y": -10289,
      "width": 220,
      "height": 80,
      "text": "**加权采样性质**"
    },
    {
      "id": "e713b1348fd44a9d",
      "type": "text",
      "x": 141,
      "y": -10289,
      "width": 220,
      "height": 80,
      "text": "**包含与相等**"
    },
    {
      "id": "a7ce1b8ae98640f0",
      "type": "text",
      "x": -359,
      "y": -10179,
      "width": 220,
      "height": 80,
      "text": "**医学领域**"
    },
    {
      "id": "144b044840f849ff",
      "type": "text",
      "x": -109,
      "y": -10179,
      "width": 220,
      "height": 80,
      "text": "**协方差函数**"
    },
    {
      "id": "9272e3d6d4514fce",
      "type": "text",
      "x": 141,
      "y": -10179,
      "width": 220,
      "height": 80,
      "text": "**协方差函数（Covariance Function）**"
    },
    {
      "id": "17a49dd1915e4b7c",
      "type": "text",
      "x": -359,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**参数为 $\\lambda t$ 的泊松分布**"
    },
    {
      "id": "7b18329533cd4bbd",
      "type": "text",
      "x": -109,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**参数为 $\\lambda>0$ 的泊松过程**"
    },
    {
      "id": "3c07ff5693624712",
      "type": "text",
      "x": 141,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**参考答案**"
    },
    {
      "id": "9827668b66214b63",
      "type": "text",
      "x": -359,
      "y": -9959,
      "width": 220,
      "height": 80,
      "text": "**取值范围**"
    },
    {
      "id": "55144c373820494e",
      "type": "text",
      "x": -109,
      "y": -9959,
      "width": 220,
      "height": 80,
      "text": "**古典概率**"
    },
    {
      "id": "dac7ab0d725b46f2",
      "type": "text",
      "x": 141,
      "y": -9959,
      "width": 220,
      "height": 80,
      "text": "**可加性**"
    },
    {
      "id": "a95a38055a19495f",
      "type": "text",
      "x": -359,
      "y": -9849,
      "width": 220,
      "height": 80,
      "text": "**右连续性**"
    },
    {
      "id": "dad4dbbc3f2b44d6",
      "type": "text",
      "x": -109,
      "y": -9849,
      "width": 220,
      "height": 80,
      "text": "**各态历经性 (Ergodicity)**"
    },
    {
      "id": "333e375a778943d7",
      "type": "text",
      "x": 141,
      "y": -9849,
      "width": 220,
      "height": 80,
      "text": "**同余类**"
    },
    {
      "id": "54678843fcba4b3d",
      "type": "text",
      "x": -359,
      "y": -9739,
      "width": 220,
      "height": 80,
      "text": "**同分布**"
    },
    {
      "id": "f53119d79c134be5",
      "type": "text",
      "x": -109,
      "y": -9739,
      "width": 220,
      "height": 80,
      "text": "**后验概率**"
    },
    {
      "id": "bf5f43855e6846f2",
      "type": "text",
      "x": 141,
      "y": -9739,
      "width": 220,
      "height": 80,
      "text": "**后验概率（Posterior Probability）**"
    },
    {
      "id": "47a0d362342e4038",
      "type": "text",
      "x": -359,
      "y": -9629,
      "width": 220,
      "height": 80,
      "text": "**含义**"
    },
    {
      "id": "a2df34e9de664472",
      "type": "text",
      "x": -109,
      "y": -9629,
      "width": 220,
      "height": 80,
      "text": "**吸收概率**"
    },
    {
      "id": "beeabc8cbadd4f44",
      "type": "text",
      "x": 141,
      "y": -9629,
      "width": 220,
      "height": 80,
      "text": "**吸收状态(absorbing state)**"
    },
    {
      "id": "5e5828bc95f94c19",
      "type": "text",
      "x": -359,
      "y": -9519,
      "width": 220,
      "height": 80,
      "text": "**吸收马尔可夫链(absorbing Markov Chain)**"
