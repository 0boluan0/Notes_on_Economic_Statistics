    },
    {
      "id": "5c8a545dae3d45a8",
      "type": "text",
      "x": 141,
      "y": -19860,
      "width": 220,
      "height": 80,
      "text": "**遍历状态**"
    },
    {
      "id": "23731cb59bbe4687",
      "type": "text",
      "x": -359,
      "y": -19750,
      "width": 220,
      "height": 80,
      "text": "**非周期性的**"
    },
    {
      "id": "367913e8e25a49cb",
      "type": "text",
      "x": -109,
      "y": -19750,
      "width": 220,
      "height": 80,
      "text": "**$\\delta$函数（Dirac Delta函数）**"
    },
    {
      "id": "1dc85017eca84c7c",
      "type": "text",
      "x": 141,
      "y": -19750,
      "width": 220,
      "height": 80,
      "text": "**$p_{ij}$渐进性质,平稳分布,吸收链**"
    },
    {
      "id": "d72560bad1c940b6",
      "type": "text",
      "x": -359,
      "y": -19640,
      "width": 220,
      "height": 80,
      "text": "**(1)$(Ω, F, P)$是概率空间**"
    },
    {
      "id": "7b0f1608d7814b28",
      "type": "text",
      "x": -109,
      "y": -19640,
      "width": 220,
      "height": 80,
      "text": "**(1)$n$维随机变量定义**"
    },
    {
      "id": "0022b02d874b457e",
      "type": "text",
      "x": 141,
      "y": -19640,
      "width": 220,
      "height": 80,
      "text": "**(1)离散型随机变量**"
    },
    {
      "id": "16520325a19646f8",
      "type": "text",
      "x": -359,
      "y": -19530,
      "width": 220,
      "height": 80,
      "text": "**(2)$X=X(e)$是定义在$Ω$上的实函数**"
    },
    {
      "id": "1b60152a1d6641d2",
      "type": "text",
      "x": -109,
      "y": -19530,
      "width": 220,
      "height": 80,
      "text": "**(2). $\\delta$函数的性质**"
    },
    {
      "id": "90472d0215374577",
      "type": "text",
      "x": 141,
      "y": -19530,
      "width": 220,
      "height": 80,
      "text": "**(2)连续型随机变量**"
    },
    {
      "id": "57d36fcc97774c11",
      "type": "text",
      "x": -359,
      "y": -19420,
      "width": 220,
      "height": 80,
      "text": "**(3). 如果对任意实数$x$，$\\{e:X(e) \\leq x\\} \\in F$**"
    },
    {
      "id": "7f477c10fe33453a",
      "type": "text",
      "x": -109,
      "y": -19420,
      "width": 220,
      "height": 80,
      "text": "**(3)常见分布**"
    },
    {
      "id": "158da2f9262f4eb6",
      "type": "text",
      "x": 141,
      "y": -19420,
      "width": 220,
      "height": 80,
      "text": "**(4)则称$X(e)$是$F$上的随机变量**"
    },
    {
      "id": "fccf0fe6e8164702",
      "type": "text",
      "x": -359,
      "y": -19310,
      "width": 220,
      "height": 80,
      "text": "**(5)$\\delta$函数的意义**"
    },
    {
      "id": "1d6c325c65904a9f",
      "type": "text",
      "x": -109,
      "y": -19310,
      "width": 220,
      "height": 80,
      "text": "****(1). $\\delta$函数的定义****"
    },
    {
      "id": "ecffea4b345e40d5",
      "type": "text",
      "x": 141,
      "y": -19310,
      "width": 220,
      "height": 80,
      "text": "****(1). 问题背景****"
    },
    {
