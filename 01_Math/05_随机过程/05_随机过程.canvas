      "id": "b8147fb6393b4ebb",
      "type": "text",
      "x": -109,
      "y": -8529,
      "width": 220,
      "height": 80,
      "text": "**定义 6.1：联合平稳过程**"
    },
    {
      "id": "83d7c0397ca24d02",
      "type": "text",
      "x": 141,
      "y": -8529,
      "width": 220,
      "height": 80,
      "text": "**定义与相关概念**"
    },
    {
      "id": "01aaa399c927451b",
      "type": "text",
      "x": -359,
      "y": -8419,
      "width": 220,
      "height": 80,
      "text": "**定义性质**"
    },
    {
      "id": "b69750dcf6de4c7c",
      "type": "text",
      "x": -109,
      "y": -8419,
      "width": 220,
      "height": 80,
      "text": "**定义：**"
    },
    {
      "id": "1dc3adf1f5c645cb",
      "type": "text",
      "x": 141,
      "y": -8419,
      "width": 220,
      "height": 80,
      "text": "**定理**"
    },
    {
      "id": "206c835a6fc447d8",
      "type": "text",
      "x": -359,
      "y": -8309,
      "width": 220,
      "height": 80,
      "text": "**定理 6.10 (均值各态历经性)**"
    },
    {
      "id": "56e6867a59724953",
      "type": "text",
      "x": -109,
      "y": -8309,
      "width": 220,
      "height": 80,
      "text": "**定理 6.11 (相关函数各态历经性)**"
    },
    {
      "id": "86ed44c7a8774edf",
      "type": "text",
      "x": 141,
      "y": -8309,
      "width": 220,
      "height": 80,
      "text": "**宽平稳**"
    },
    {
      "id": "fff875a12a854a35",
      "type": "text",
      "x": -359,
      "y": -8199,
      "width": 220,
      "height": 80,
      "text": "**宽平稳 (Wide-sense stationary)**"
    },
    {
      "id": "5d63b136c1a4468b",
      "type": "text",
      "x": -109,
      "y": -8199,
      "width": 220,
      "height": 80,
      "text": "**宽平稳和严平稳是一样的**"
    },
    {
      "id": "407f893fd6584026",
      "type": "text",
      "x": 141,
      "y": -8199,
      "width": 220,
      "height": 80,
      "text": "**宽平稳性与严平稳性是等价的**"
    },
    {
      "id": "7229f480fbf34881",
      "type": "text",
      "x": -359,
      "y": -8089,
      "width": 220,
      "height": 80,
      "text": "**宽平稳过程相关函数的性质**"
    },
    {
      "id": "f011808e197247f4",
      "type": "text",
      "x": -109,
      "y": -8089,
      "width": 220,
      "height": 80,
      "text": "**密度函数$f(x)$并不是概率本身，而是概率的密度**"
    },
    {
      "id": "bf40650412174a7a",
      "type": "text",
      "x": 141,
      "y": -8089,
      "width": 220,
      "height": 80,
      "text": "**密度函数$f(x)$的非负性**"
    },
    {
      "id": "09e205ea4e104664",
      "type": "text",
      "x": -359,
      "y": -7979,
      "width": 220,
      "height": 80,
      "text": "**密度函数的归一性**"
    },
    {
      "id": "cd0cecfd5ebe482a",
      "type": "text",
      "x": -109,
      "y": -7979,
      "width": 220,
      "height": 80,
      "text": "**对于任意 $0 \\le t < t+s$，有**"
    },
    {
      "id": "fdeeac80fa2243b8",
      "type": "text",
      "x": 141,
      "y": -7979,
      "width": 220,
      "height": 80,
      "text": "**对于正态过程**"
    },
    {
      "id": "f94c06102d32457a",
      "type": "text",
      "x": -359,
      "y": -7869,
      "width": 220,
      "height": 80,
      "text": "**对称性**"
    },
    {
      "id": "d1026c17d13b461f",
      "type": "text",
      "x": -109,
      "y": -7869,
      "width": 220,
      "height": 80,
      "text": "**导数与矩**"
    },
    {
      "id": "6940f2d6e8894246",
      "type": "text",
      "x": 141,
      "y": -7869,
      "width": 220,
      "height": 80,
      "text": "**将 $s = t$、$t=0$ 代入上式，可得到**"
    },
    {
      "id": "94ce547cf49a4208",
      "type": "text",
      "x": -359,
      "y": -7759,
      "width": 220,
      "height": 80,
      "text": "**展开：**"
    },
    {
      "id": "fdc04f75c9a44daf",
      "type": "text",
      "x": -109,
      "y": -7759,
      "width": 220,
      "height": 80,
      "text": "**布朗运动和鞅**"
    },
