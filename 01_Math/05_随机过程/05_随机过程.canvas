      "id": "d65330301acb46d4",
      "type": "text",
      "x": -359,
      "y": -11499,
      "width": 220,
      "height": 80,
      "text": "**二、填空题**"
    },
    {
      "id": "d3dd842f74d94764",
      "type": "text",
      "x": -109,
      "y": -11499,
      "width": 220,
      "height": 80,
      "text": "**二、填空题 (每题 5 分，共 20 分)**"
    },
    {
      "id": "5f2b130347784387",
      "type": "text",
      "x": 141,
      "y": -11499,
      "width": 220,
      "height": 80,
      "text": "**二阶矩过程**"
    },
    {
      "id": "44829d542bc64abf",
      "type": "text",
      "x": -359,
      "y": -11389,
      "width": 220,
      "height": 80,
      "text": "**二阶矩过程均值常数，相关函数仅与时间差有关**"
    },
    {
      "id": "988f9fedc50640fa",
      "type": "text",
      "x": -109,
      "y": -11389,
      "width": 220,
      "height": 80,
      "text": "**二项分布**"
    },
