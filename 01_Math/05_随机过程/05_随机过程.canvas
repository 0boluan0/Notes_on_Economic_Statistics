      "id": "d8de4ae2d911407a",
      "type": "text",
      "x": -359,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**关键点**"
    },
    {
      "id": "c3e07338aa4b4c08",
      "type": "text",
      "x": -109,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**其他**"
