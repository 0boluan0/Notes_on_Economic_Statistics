      "id": "3c39472f8dc44d77",
      "type": "text",
      "x": -359,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**结论**"
    },
    {
      "id": "0562a85313c94d9d",
      "type": "text",
      "x": -109,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**统一公式**"
    },
    {
      "id": "35603219e7b74f43",
      "type": "text",
      "x": 141,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**统计关系不随时间改变**"
    },
    {
      "id": "1cef946ebe6a4296",
      "type": "text",
      "x": -359,
      "y": -3030,
      "width": 220,
      "height": 80,
