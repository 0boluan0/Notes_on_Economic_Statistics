      "id": "eaee1c97c04a4b52",
      "type": "text",
      "x": 141,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**典型示例**"
    },
    {
      "id": "7c99a244c1a5447a",
      "type": "text",
      "x": -359,
      "y": -10729,
      "width": 220,
      "height": 80,
      "text": "**再通俗一点解释**"
    },
