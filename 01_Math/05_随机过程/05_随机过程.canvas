      "id": "cb9b663259cd46b9",
      "type": "text",
      "x": -109,
      "y": -9300,
      "width": 220,
      "height": 80,
      "text": "**主要性质**"
    },
    {
      "id": "f022fb77459c4954",
      "type": "text",
      "x": 141,
      "y": -9300,
      "width": 220,
      "height": 80,
      "text": "**举例说明**"
    },
    {
      "id": "9422e1ec7efe422d",
      "type": "text",
      "x": -359,
      "y": -9190,
      "width": 220,
      "height": 80,
      "text": "**事件的独立性**"
    },
    {
      "id": "8618e4c847004191",
      "type": "text",
      "x": -109,
      "y": -9190,
      "width": 220,
      "height": 80,
      "text": "**二、填空题**"
    },
    {
      "id": "bf5b97b7972d4893",
      "type": "text",
      "x": 141,
      "y": -9190,
      "width": 220,
      "height": 80,
      "text": "**二、填空题 (每题 5 分，共 20 分)**"
    },
    {
      "id": "74d280d58ad04183",
      "type": "text",
      "x": -359,
      "y": -9080,
      "width": 220,
      "height": 80,
      "text": "**二阶矩过程**"
    },
    {
      "id": "800b73ab91814deb",
      "type": "text",
      "x": -109,
      "y": -9080,
      "width": 220,
      "height": 80,
      "text": "**二阶矩过程均值常数，相关函数仅与时间差有关**"
    },
    {
      "id": "8991684746fb4b04",
      "type": "text",
      "x": 141,
      "y": -9080,
      "width": 220,
      "height": 80,
      "text": "**二项分布**"
    },
    {
      "id": "6507115f83b84147",
      "type": "text",
      "x": -359,
      "y": -8970,
      "width": 220,
      "height": 80,
      "text": "**互不依赖**"
    },
    {
      "id": "f6f8a4a32cdd48e1",
      "type": "text",
      "x": -109,
      "y": -8970,
      "width": 220,
      "height": 80,
      "text": "**互相关函数**"
    },
    {
      "id": "9f3c81de402c4692",
      "type": "text",
      "x": 141,
      "y": -8970,
      "width": 220,
      "height": 80,
      "text": "**互相关函数 (Cross-correlation function)**"
    },
    {
      "id": "513c4596d3fe4e28",
      "type": "text",
      "x": -359,
      "y": -8860,
      "width": 220,
      "height": 80,
      "text": "**互相关函数对称性**"
    },
    {
      "id": "969d9b7c16854201",
      "type": "text",
      "x": -109,
      "y": -8860,
      "width": 220,
      "height": 80,
      "text": "**互相关函数幅值界限**"
    },
    {
      "id": "4b2e62513cb446d0",
      "type": "text",
      "x": 141,
      "y": -8860,
      "width": 220,
      "height": 80,
      "text": "**互通的**"
    },
    {
      "id": "4eaa3a3ac4d843ea",
      "type": "text",
      "x": -359,
      "y": -8750,
      "width": 220,
      "height": 80,
      "text": "**例子：呼叫分布的均值与方差**"
    },
    {
      "id": "a44fe05a9962485d",
      "type": "text",
      "x": -109,
      "y": -8750,
      "width": 220,
      "height": 80,
      "text": "**例子：故障发生次数**"
    },
    {
      "id": "974d98d89e874665",
      "type": "text",
      "x": 141,
      "y": -8750,
      "width": 220,
      "height": 80,
      "text": "**例子：电话呼入次数**"
    },
    {
      "id": "a6d490ad540b49af",
      "type": "text",
      "x": -359,
      "y": -8640,
      "width": 220,
      "height": 80,
      "text": "**先验概率**"
    },
    {
      "id": "c17a79716cba4ca4",
      "type": "text",
      "x": -109,
      "y": -8640,
      "width": 220,
      "height": 80,
      "text": "**先验概率（Prior Probability）**"
    },
    {
      "id": "e750b1c7783e42cf",
      "type": "text",
      "x": 141,
      "y": -8640,
      "width": 220,
      "height": 80,
      "text": "**关键点**"
    },
    {
      "id": "aba4244bfe2444d1",
      "type": "text",
      "x": -359,
      "y": -8530,
      "width": 220,
      "height": 80,
      "text": "**典型示例**"
    },
    {
      "id": "784fc2d8f83b4f7b",
      "type": "text",
      "x": -109,
      "y": -8530,
      "width": 220,
      "height": 80,
      "text": "**再通俗一点解释**"
    },
    {
      "id": "1d084609ca4e4ed4",
      "type": "text",
      "x": 141,
      "y": -8530,
      "width": 220,
      "height": 80,
      "text": "**准上三角**"
    },
    {
      "id": "d9ff28d1f9044f25",
      "type": "text",
      "x": -359,
      "y": -8420,
      "width": 220,
      "height": 80,
      "text": "**几何分布**"
    },
    {
      "id": "f6732eab7a8e4f6d",
      "type": "text",
      "x": -109,
      "y": -8420,
      "width": 220,
      "height": 80,
      "text": "**分块**"
    },
    {
      "id": "d62d9c7de7594da0",
      "type": "text",
      "x": 141,
      "y": -8420,
      "width": 220,
      "height": 80,
      "text": "**分布名称**"
    },
    {
      "id": "082a04fb0b534fd9",
      "type": "text",
      "x": -359,
      "y": -8310,
      "width": 220,
      "height": 80,
      "text": "**分析：**"
    },
    {
      "id": "4dc9b953b6334f1a",
      "type": "text",
      "x": -109,
      "y": -8310,
      "width": 220,
      "height": 80,
      "text": "**初始分布与绝对概率**"
    },
    {
      "id": "a4117367ae0b4837",
      "type": "text",
      "x": 141,
      "y": -8310,
      "width": 220,
      "height": 80,
      "text": "**判断均值是否具有各态历经性的方法**"
    },
    {
      "id": "61a3117e358f4f7f",
      "type": "text",
      "x": -359,
      "y": -8200,
      "width": 220,
      "height": 80,
      "text": "**判断相关函数是否具有各态历经性的方法**"
    },
    {
      "id": "a5359a7aeae64bb8",
      "type": "text",
      "x": -109,
      "y": -8200,
      "width": 220,
      "height": 80,
      "text": "**到达时间的条件分布**"
    },
    {
      "id": "6634007005504368",
      "type": "text",
      "x": 141,
      "y": -8200,
      "width": 220,
      "height": 80,
      "text": "**加权采样性质**"
    },
    {
      "id": "60a6630e11664d6e",
      "type": "text",
      "x": -359,
      "y": -8090,
      "width": 220,
      "height": 80,
      "text": "**协方差函数**"
    },
    {
      "id": "3db7dec166ca4225",
      "type": "text",
      "x": -109,
      "y": -8090,
      "width": 220,
      "height": 80,
      "text": "**协方差函数（Covariance Function）**"
    },
    {
      "id": "ee7a24eb14d3423b",
      "type": "text",
      "x": 141,
      "y": -8090,
      "width": 220,
      "height": 80,
      "text": "**参数为 $\\lambda t$ 的泊松分布**"
    },
    {
      "id": "ca8d5c84e3bc43de",
      "type": "text",
      "x": -359,
      "y": -7980,
      "width": 220,
      "height": 80,
      "text": "**参数为 $\\lambda>0$ 的泊松过程**"
    },
    {
      "id": "ba7793441c26495b",
      "type": "text",
      "x": -109,
      "y": -7980,
      "width": 220,
      "height": 80,
      "text": "**参考答案**"
    },
    {
      "id": "c8f99672e246431a",
      "type": "text",
      "x": 141,
      "y": -7980,
      "width": 220,
      "height": 80,
      "text": "**取值范围**"
    },
    {
      "id": "503427f2e2634075",
      "type": "text",
      "x": -359,
      "y": -7870,
      "width": 220,
      "height": 80,
      "text": "**可加性**"
    },
    {
      "id": "4fbfe5ecc6a94db5",
      "type": "text",
      "x": -109,
      "y": -7870,
      "width": 220,
      "height": 80,
      "text": "**右连续性**"
    },
    {
      "id": "ca5edc29b61b494f",
      "type": "text",
      "x": 141,
      "y": -7870,
      "width": 220,
      "height": 80,
      "text": "**各态历经性 (Ergodicity)**"
    },
    {
      "id": "cd4e46be9bf94da1",
      "type": "text",
      "x": -359,
      "y": -7760,
      "width": 220,
      "height": 80,
      "text": "**同余类**"
    },
    {
      "id": "6253cbd1d3794bc6",
      "type": "text",
      "x": -109,
      "y": -7760,
      "width": 220,
      "height": 80,
      "text": "**同分布**"
    },
    {
      "id": "f0530bbf1cb54d32",
      "type": "text",
      "x": 141,
      "y": -7760,
      "width": 220,
      "height": 80,
      "text": "**后验概率**"
    },
    {
      "id": "77a33201aa77453e",
      "type": "text",
      "x": -359,
      "y": -7650,
      "width": 220,
      "height": 80,
      "text": "**后验概率（Posterior Probability）**"
    },
    {
      "id": "5ccb2b2ed5c949f2",
      "type": "text",
      "x": -109,
      "y": -7650,
      "width": 220,
      "height": 80,
      "text": "**吸收概率**"
    },
    {
      "id": "11dbd131afc14777",
      "type": "text",
      "x": 141,
      "y": -7650,
      "width": 220,
      "height": 80,
      "text": "**吸收状态(absorbing state)**"
    },
    {
      "id": "5adb6bd2c94e42c3",
      "type": "text",
      "x": -359,
      "y": -7540,
      "width": 220,
      "height": 80,
      "text": "**吸收马尔可夫链(absorbing Markov Chain)**"
    },
    {
      "id": "77f84f504e6f4441",
      "type": "text",
      "x": -109,
      "y": -7540,
      "width": 220,
      "height": 80,
      "text": "**周期**"
    },
    {
      "id": "3dd9b9b7fb33439f",
      "type": "text",
      "x": 141,
      "y": -7540,
      "width": 220,
      "height": 80,
      "text": "**周期(d(i))**"
    },
    {
      "id": "4052fbce010d4912",
      "type": "text",
      "x": -359,
      "y": -7430,
      "width": 220,
      "height": 80,
      "text": "**周期同余分解**"
    },
    {
      "id": "4648c52dbfab4859",
      "type": "text",
      "x": -109,
      "y": -7430,
      "width": 220,
      "height": 80,
      "text": "**周期性的**"
    },
    {
      "id": "663b90893280481f",
      "type": "text",
      "x": 141,
      "y": -7430,
      "width": 220,
      "height": 80,
      "text": "**唯一性**"
    },
    {
      "id": "20597730dd094ab4",
      "type": "text",
      "x": -359,
      "y": -7320,
      "width": 220,
      "height": 80,
      "text": "**唯一的平稳分布**"
    },
    {
      "id": "9a0fa327929d4cc1",
      "type": "text",
      "x": -109,
      "y": -7320,
      "width": 220,
      "height": 80,
      "text": "**均值 $E[X]$**"
    },
    {
      "id": "606fae796cbc4322",
      "type": "text",
      "x": 141,
      "y": -7320,
      "width": 220,
      "height": 80,
      "text": "**均值与方差**"
    },
    {
      "id": "31b6d7e48efb4d1c",
      "type": "text",
      "x": -359,
      "y": -7210,
      "width": 220,
      "height": 80,
      "text": "**均值函数（Mean Function）**"
    },
    {
      "id": "6b1c29138cfe4a0d",
      "type": "text",
      "x": -109,
      "y": -7210,
      "width": 220,
      "height": 80,
      "text": "**均值各态历经性**"
    },
    {
      "id": "ec1e73ae5c4c4ab4",
      "type": "text",
      "x": 141,
      "y": -7210,
      "width": 220,
      "height": 80,
      "text": "**均匀分布**"
    },
    {
      "id": "906ff08f30874df5",
      "type": "text",
      "x": -359,
      "y": -7100,
      "width": 220,
      "height": 80,
      "text": "**均方导数**"
    },
    {
      "id": "44320e2559a2436f",
      "type": "text",
      "x": -109,
      "y": -7100,
      "width": 220,
      "height": 80,
      "text": "**均方积分**"
    },
    {
      "id": "bc57f0f4d7df4cef",
      "type": "text",
      "x": 141,
      "y": -7100,
      "width": 220,
      "height": 80,
      "text": "**均方连续**"
    },
    {
      "id": "432de585454a43eb",
      "type": "text",
      "x": -359,
      "y": -6990,
      "width": 220,
      "height": 80,
      "text": "**基本性质**"
    },
    {
      "id": "2075cd71a8154e69",
      "type": "text",
      "x": -109,
      "y": -6990,
      "width": 220,
      "height": 80,
      "text": "**增函数性**"
    },
    {
      "id": "ec3db9cb8fbc4196",
      "type": "text",
      "x": 141,
      "y": -6990,
      "width": 220,
      "height": 80,
      "text": "**复数表示**"
    },
    {
      "id": "df0405bf7d1244b6",
      "type": "text",
      "x": -359,
      "y": -6880,
      "width": 220,
      "height": 80,
      "text": "**复数运算和欧拉公式**"
    },
    {
      "id": "6fd3b87d82fd4ec4",
      "type": "text",
      "x": -109,
      "y": -6880,
      "width": 220,
      "height": 80,
      "text": "**复随机过程统计特性**"
    },
    {
      "id": "6b21a8776e894c2d",
      "type": "text",
      "x": 141,
      "y": -6880,
      "width": 220,
      "height": 80,
      "text": "**多个事件的独立性**"
    },
    {
      "id": "5b56427befe348f5",
      "type": "text",
      "x": -359,
      "y": -6770,
      "width": 220,
      "height": 80,
      "text": "**定义 6.1：联合平稳过程**"
    },
    {
      "id": "86f9e27815e14876",
      "type": "text",
      "x": -109,
      "y": -6770,
      "width": 220,
      "height": 80,
      "text": "**定义性质**"
    },
    {
      "id": "edc03bd1f0384ad0",
      "type": "text",
      "x": 141,
      "y": -6770,
      "width": 220,
      "height": 80,
      "text": "**定理**"
    },
    {
      "id": "877bf97353294ea3",
      "type": "text",
      "x": -359,
      "y": -6660,
      "width": 220,
      "height": 80,
      "text": "**定理 6.10 (均值各态历经性)**"
    },
    {
      "id": "cbc3fc33e4604a92",
      "type": "text",
      "x": -109,
      "y": -6660,
      "width": 220,
      "height": 80,
      "text": "**定理 6.11 (相关函数各态历经性)**"
    },
    {
      "id": "95c2b9bab4e54064",
      "type": "text",
      "x": 141,
      "y": -6660,
      "width": 220,
      "height": 80,
      "text": "**宽平稳**"
    },
    {
      "id": "1c8db31fdf084f04",
      "type": "text",
      "x": -359,
      "y": -6550,
      "width": 220,
      "height": 80,
      "text": "**宽平稳 (Wide-sense stationary)**"
    },
    {
      "id": "32c1d7b8066d4934",
      "type": "text",
      "x": -109,
      "y": -6550,
      "width": 220,
      "height": 80,
      "text": "**宽平稳和严平稳是一样的**"
    },
    {
      "id": "78d0b37e31014fce",
      "type": "text",
      "x": 141,
      "y": -6550,
      "width": 220,
      "height": 80,
      "text": "**宽平稳性与严平稳性是等价的**"
    },
    {
      "id": "5c4c93bc13ac4773",
      "type": "text",
      "x": -359,
      "y": -6440,
      "width": 220,
      "height": 80,
      "text": "**宽平稳过程相关函数的性质**"
    },
    {
      "id": "da630c1850d646d3",
      "type": "text",
      "x": -109,
      "y": -6440,
      "width": 220,
      "height": 80,
      "text": "**密度函数$f(x)$并不是概率本身，而是概率的密度**"
    },
    {
      "id": "eb9ea508af1b491c",
      "type": "text",
      "x": 141,
      "y": -6440,
      "width": 220,
      "height": 80,
      "text": "**密度函数$f(x)$的非负性**"
    },
    {
      "id": "92a6d74a01d2467c",
      "type": "text",
      "x": -359,
      "y": -6330,
      "width": 220,
      "height": 80,
      "text": "**密度函数的归一性**"
    },
    {
      "id": "bd4ee06c450f43eb",
      "type": "text",
      "x": -109,
      "y": -6330,
      "width": 220,
      "height": 80,
      "text": "**对于任意 $0 \\le t < t+s$，有**"
    },
    {
      "id": "f98ad1c1ab4c403e",
      "type": "text",
      "x": 141,
      "y": -6330,
      "width": 220,
      "height": 80,
      "text": "**对于正态过程**"
    },
    {
      "id": "109a8b7f3827460e",
      "type": "text",
      "x": -359,
      "y": -6220,
      "width": 220,
      "height": 80,
      "text": "**对称性**"
    },
    {
      "id": "91ccd509aa28454a",
      "type": "text",
      "x": -109,
      "y": -6220,
      "width": 220,
      "height": 80,
      "text": "**导数与矩**"
    },
    {
      "id": "bf19f4bd322d463d",
      "type": "text",
      "x": 141,
      "y": -6220,
      "width": 220,
      "height": 80,
      "text": "**将 $s = t$、$t=0$ 代入上式，可得到**"
    },
    {
      "id": "4564539b2ac54c23",
      "type": "text",
      "x": -359,
      "y": -6110,
      "width": 220,
      "height": 80,
      "text": "**展开：**"
    },
    {
      "id": "880d07ff1efe4b75",
      "type": "text",
      "x": -109,
      "y": -6110,
      "width": 220,
      "height": 80,
      "text": "**常反性定义**"
    },
    {
      "id": "99efa0921f5f40b0",
      "type": "text",
      "x": 141,
      "y": -6110,
      "width": 220,
      "height": 80,
      "text": "**常用记号与分布关系**"
    },
    {
      "id": "07505a79b7774f97",
      "type": "text",
      "x": -359,
      "y": -6000,
      "width": 220,
      "height": 80,
      "text": "**常返**"
    },
    {
      "id": "0c3b6783caac44d7",
      "type": "text",
      "x": -109,
      "y": -6000,
      "width": 220,
      "height": 80,
      "text": "**常返态**"
    },
    {
      "id": "bf5b3c0c429d4111",
      "type": "text",
      "x": 141,
      "y": -6000,
      "width": 220,
      "height": 80,
      "text": "**常返状态**"
    },
    {
      "id": "c0c2a828d4714e3d",
      "type": "text",
      "x": -359,
      "y": -5890,
      "width": 220,
      "height": 80,
      "text": "**常返链**"
    },
    {
      "id": "f1a3b37995644d48",
      "type": "text",
      "x": -109,
      "y": -5890,
      "width": 220,
      "height": 80,
      "text": "**平移性质**"
    },
    {
      "id": "991f31dc59bf4408",
      "type": "text",
      "x": 141,
      "y": -5890,
      "width": 220,
      "height": 80,
      "text": "**平稳增量**"
    },
    {
      "id": "a89a6dcf05484f50",
      "type": "text",
      "x": -359,
      "y": -5780,
      "width": 220,
      "height": 80,
      "text": "**平稳增量过程**"
    },
    {
      "id": "44c53a528e88465f",
      "type": "text",
      "x": -109,
      "y": -5780,
      "width": 220,
      "height": 80,
      "text": "**平稳随机过程的统计特性可以用一个样本函数的时间平均来代替**"
    },
    {
      "id": "4915c79f5fab4851",
      "type": "text",
      "x": 141,
      "y": -5780,
      "width": 220,
      "height": 80,
      "text": "**归一性**"
    },
    {
      "id": "b95aff6050da4290",
      "type": "text",
      "x": -359,
      "y": -5670,
      "width": 220,
