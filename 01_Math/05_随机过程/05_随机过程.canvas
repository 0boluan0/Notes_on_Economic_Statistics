      "id": "f29f0a662d0f4186",
      "type": "text",
      "x": 141,
      "y": -9519,
      "width": 220,
      "height": 80,
      "text": "**周期(d(i))**"
    },
    {
      "id": "954bd3e73d294ce7",
      "type": "text",
      "x": -359,
      "y": -9409,
      "width": 220,
      "height": 80,
      "text": "**周期同余分解**"
    },
    {
      "id": "3f3c1622089c47b2",
      "type": "text",
      "x": -109,
      "y": -9409,
      "width": 220,
      "height": 80,
      "text": "**周期性**"
    },
    {
      "id": "9b34b97b63b146bc",
      "type": "text",
      "x": 141,
      "y": -9409,
      "width": 220,
      "height": 80,
      "text": "**周期性的**"
    },
    {
      "id": "0e3c52a335db4a97",
      "type": "text",
      "x": -359,
      "y": -9299,
      "width": 220,
      "height": 80,
      "text": "**和运算**"
    },
    {
      "id": "71769f7aa6654d68",
      "type": "text",
      "x": -109,
      "y": -9299,
      "width": 220,
      "height": 80,
      "text": "**唯一性**"
    },
    {
      "id": "6786d313f3594ce2",
      "type": "text",
      "x": 141,
      "y": -9299,
      "width": 220,
      "height": 80,
      "text": "**唯一的平稳分布**"
    },
    {
      "id": "7b06c94476e94a92",
      "type": "text",
      "x": -359,
      "y": -9189,
      "width": 220,
      "height": 80,
      "text": "**均值 $E[X]$**"
    },
    {
      "id": "cae0a4a11a7a47fb",
      "type": "text",
