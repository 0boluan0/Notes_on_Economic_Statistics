@online{khattab2020ColBERTEfficientEffective,
  title = {{{ColBERT}}: {{Efficient}} and {{Effective Passage Search}} via {{Contextualized Late Interaction}} over {{BERT}}},
  shorttitle = {{{ColBERT}}},
  author = {Khattab, Omar and Zaharia, Matei},
  date = {2020-06-04},
