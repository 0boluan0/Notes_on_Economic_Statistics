  pubstate = {prepublished},
  keywords = {Computer Science - Computation and Language},
  file = {/Users/fengyihang/Zotero/storage/Z2ABEQU9/Izacard et al. - 2022 - Atlas Few-shot Learning with Retrieval Augmented Language Models.pdf}
}

