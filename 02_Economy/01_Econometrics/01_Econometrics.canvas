    {
      "id": "ebd5e91057c543cd",
      "type": "text",
      "x": -359,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**PP检验与ADF检验的差别**"
    },
    {
      "id": "60080bfc1a5d46c9",
      "type": "text",
      "x": -109,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**PP检验的基本思想**"
    },
    {
      "id": "61ed817f05d44cde",
      "type": "text",
      "x": 141,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**p值**"
    },
    {
      "id": "ccfef5b0841e456b",
      "type": "text",
      "x": -359,
      "y": -10729,
      "width": 220,
      "height": 80,
      "text": "**Recording 20241001150650.webm**"
    },
    {
      "id": "2bd41fcb8b744213",
      "type": "text",
      "x": -109,
      "y": -10729,
      "width": 220,
      "height": 80,
      "text": "**Trace检验统计量**"
    },
    {
      "id": "1ee7d8403f4940ec",
      "type": "text",
      "x": 141,
      "y": -10729,
      "width": 220,
      "height": 80,
      "text": "**VAR转VMA**"
    },
    {
      "id": "b5f98cf778244be2",
      "type": "text",
      "x": -359,
      "y": -10619,
      "width": 220,
      "height": 80,
      "text": "**Wald检验**"
    },
    {
      "id": "7a1a02c32d9e45c4",
      "type": "text",
      "x": -109,
      "y": -10619,
      "width": 220,
      "height": 80,
      "text": "**y的取值最终会向由解释变量x所决定的平均水平上回复，这种回复的趋势叫做回归（regression）。**"
    },
    {
      "id": "09bd32af1dd446cf",
      "type": "text",
      "x": 141,
      "y": -10619,
      "width": 220,
      "height": 80,
      "text": "**~~零值回复~~ 均值回归**"
    },
    {
      "id": "4fa9218458ac4aa3",
      "type": "text",
      "x": -359,
      "y": -10509,
      "width": 220,
      "height": 80,
      "text": "**一元线性回归(Simple Linear Regression)（书上第三章）**"
    },
    {
      "id": "0783c5c88eeb4e90",
      "type": "text",
      "x": -109,
      "y": -10509,
      "width": 220,
      "height": 80,
      "text": "**不完全多重共线性对OLS估计量的影响**"
    },
    {
      "id": "dca74095d08a4a93",
      "type": "text",
      "x": 141,
      "y": -10509,
      "width": 220,
      "height": 80,
      "text": "**不完全的多重共线性**"
    },
    {
      "id": "6c80e70ae76a40e8",
      "type": "text",
      "x": -359,
      "y": -10399,
      "width": 220,
      "height": 80,
      "text": "**不补救,保证检验**"
    },
    {
      "id": "dc6675fa258f44f7",
      "type": "text",
      "x": -109,
      "y": -10399,
      "width": 220,
      "height": 80,
      "text": "**两个解释变量**"
    },
    {
      "id": "bf5eeac4988848f9",
      "type": "text",
      "x": 141,
      "y": -10399,
      "width": 220,
      "height": 80,
      "text": "**两阶段最小二乘法（2SLS）**"
    },
    {
      "id": "5bb1323094ac4c91",
      "type": "text",
      "x": -359,
      "y": -10289,
      "width": 220,
      "height": 80,
      "text": "**个体内离差**"
    },
    {
      "id": "be0242add86f4ef7",
      "type": "text",
      "x": -109,
      "y": -10289,
      "width": 220,
      "height": 80,
      "text": "**中期乘数**"
    },
    {
      "id": "0bb736a1517642e7",
      "type": "text",
      "x": 141,
      "y": -10289,
      "width": 220,
      "height": 80,
      "text": "**举例**"
    },
    {
      "id": "a82555e0eadd4a5c",
      "type": "text",
      "x": -359,
      "y": -10179,
      "width": 220,
      "height": 80,
      "text": "**举例:牛奶市场中的不可识别**"
    },
    {
      "id": "ad6e14c846d2404a",
      "type": "text",
      "x": -109,
      "y": -10179,
      "width": 220,
      "height": 80,
      "text": "**产生多重共线性的原因**"
    },
    {
      "id": "06f9fae340424ee6",
      "type": "text",
      "x": 141,
      "y": -10179,
      "width": 220,
      "height": 80,
      "text": "**什么是虚拟变量**"
    },
    {
      "id": "b049e9edb0644c22",
      "type": "text",
      "x": -359,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**估计参数**"
    },
    {
      "id": "28b9c08f776b4ccf",
      "type": "text",
      "x": -109,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**估计方程**"
    },
    {
      "id": "5660e034d13949f9",
      "type": "text",
      "x": 141,
      "y": -10069,
      "width": 220,
      "height": 80,
      "text": "**估计自相关系数**"
    },
