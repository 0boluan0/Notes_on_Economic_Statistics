      "id": "884cf6f8e7ee4e99",
      "type": "text",
      "x": 141,
      "y": -5669,
      "width": 220,
      "height": 80,
      "text": "**一. 债券的有关概念(Relevant Concepts of Bonds)**"
    },
    {
      "id": "a5b863b533e74d89",
      "type": "text",
      "x": -359,
      "y": -5559,
      "width": 220,
      "height": 80,
      "text": "**一.企业组织形式(Forms of Business Organization)**"
    },
    {
      "id": "4ea8f4a76fb54e30",
      "type": "text",
      "x": -109,
      "y": -5559,
      "width": 220,
      "height": 80,
      "text": "**一.内含增长率的测算**"
    },
    {
      "id": "5e33514944de4b54",
      "type": "text",
      "x": 141,
      "y": -5559,
      "width": 220,
      "height": 80,
      "text": "**一.净现值法(Net Present Value Method)**"
    },
    {
      "id": "77537b44cf05497b",
      "type": "text",
      "x": -359,
      "y": -5449,
      "width": 220,
      "height": 80,
      "text": "**一.基准利率及特征(Benchmark Interest Rate and Characteristics)**"
    },
    {
      "id": "02963a1e58bd405f",
      "type": "text",
      "x": -109,
      "y": -5449,
      "width": 220,
      "height": 80,
      "text": "**一.投资项目现金流量的构成**"
    },
    {
      "id": "b46159cef5f34c07",
      "type": "text",
      "x": 141,
      "y": -5449,
      "width": 220,
      "height": 80,
      "text": "**一.短期偿债能力比率**"
    },
    {
      "id": "45fba8f78f564e63",
      "type": "text",
      "x": -359,
      "y": -5339,
      "width": 220,
      "height": 80,
      "text": "**一.股票的有关概念**"
    },
    {
      "id": "8f0210973750481a",
      "type": "text",
      "x": -109,
      "y": -5339,
      "width": 220,
      "height": 80,
      "text": "**一.财务报表分析的目的(Purpose of Financial Statement Analysis)**"
    },
    {
      "id": "6bc953dc596b4f47",
      "type": "text",
      "x": 141,
      "y": -5339,
      "width": 220,
      "height": 80,
      "text": "**一.财务管理的目标**"
    },
    {
      "id": "be6818dbb9fb427b",
      "type": "text",
      "x": -359,
      "y": -5229,
      "width": 220,
      "height": 80,
      "text": "**一.财务预测的意义**"
    },
    {
      "id": "27cc20e5f96d4f5a",
      "type": "text",
      "x": -109,
      "y": -5229,
      "width": 220,
      "height": 80,
      "text": "**一.货币时间价值概念(Concept of Time Value of Money)**"
    },
    {
      "id": "62eb75e86df94de5",
      "type": "text",
      "x": 141,
      "y": -5229,
      "width": 220,
      "height": 80,
      "text": "**一.金融工具的类型**"
    },
    {
      "id": "f9199255407c4431",
      "type": "text",
      "x": -359,
      "y": -5119,
      "width": 220,
      "height": 80,
      "text": "**七.管理用财务报表体系**"
    },
    {
      "id": "e88d31c7330c4940",
      "type": "text",
      "x": -109,
      "y": -5119,
      "width": 220,
      "height": 80,
      "text": "**三.债券的收益率**"
    },
