    },
    {
      "id": "b877733b909d454e",
      "type": "text",
      "x": -359,
      "y": -20739,
      "width": 220,
      "height": 80,
      "text": "**SML 与 CML 区别易混？一句话区分**"
    },
    {
      "id": "eb7376a0ae394819",
      "type": "text",
      "x": -109,
      "y": -20739,
      "width": 220,
      "height": 80,
      "text": "**① 代入 CAPM 公式求必要收益率**"
    },
    {
      "id": "a1c8c4b48857465c",
      "type": "text",
      "x": 141,
      "y": -20739,
      "width": 220,
      "height": 80,
      "text": "**② 判断估值高低**"
    },
    {
      "id": "ac151994dfed403f",
      "type": "text",
      "x": -359,
      "y": -20629,
      "width": 220,
      "height": 80,
      "text": "**③ 在 SML 图上定位**"
    },
    {
      "id": "c2cd574b4ffd47ca",
      "type": "text",
      "x": -109,
      "y": -20629,
      "width": 220,
      "height": 80,
      "text": "**《国民经济行业分类与代码》（GB/T 4754-2002）**"
    },
    {
      "id": "a07a940535a140b7",
      "type": "text",
      "x": 141,
      "y": -20629,
      "width": 220,
      "height": 80,
      "text": "**一、CAPM 的基本假设**"
    },
    {
      "id": "4bff6ee38d3e4905",
      "type": "text",
      "x": -359,
      "y": -20519,
      "width": 220,
      "height": 80,
      "text": "**一手资料**"
    },
    {
      "id": "a042074fa98e414a",
      "type": "text",
      "x": -109,
      "y": -20519,
      "width": 220,
      "height": 80,
      "text": "**三、资产组合的投资选择**"
    },
    {
      "id": "4e18fd8928aa43bd",
      "type": "text",
      "x": 141,
      "y": -20519,
      "width": 220,
      "height": 80,
      "text": "**三年竞争优势的现值**"
    },
    {
      "id": "5f25bc7def064d8f",
      "type": "text",
      "x": -359,
      "y": -20409,
      "width": 220,
      "height": 80,
      "text": "**上方**"
    },
    {
      "id": "52ce53b147f24282",
      "type": "text",
      "x": -109,
      "y": -20409,
      "width": 220,
      "height": 80,
      "text": "**上海证券交易所成分指数分类**"
    },
    {
      "id": "b03e44a666c34261",
      "type": "text",
      "x": 141,
      "y": -20409,
      "width": 220,
      "height": 80,
      "text": "**下方**"
    },
    {
      "id": "1203fccdfb8245ba",
      "type": "text",
      "x": -359,
      "y": -20299,
      "width": 220,
      "height": 80,
      "text": "**不可替代性**"
    },
    {
      "id": "2fe886b638d74a5f",
      "type": "text",
      "x": -109,
      "y": -20299,
      "width": 220,
      "height": 80,
      "text": "**不确定性下的价值函数**"
    },
    {
      "id": "0df1a48b182543b5",
      "type": "text",
      "x": 141,
      "y": -20299,
      "width": 220,
      "height": 80,
      "text": "**不等额分期偿还**"
    },
    {
      "id": "d3203c0bdbe244bf",
      "type": "text",
      "x": -359,
      "y": -20189,
      "width": 220,
      "height": 80,
      "text": "**与 $n$ 无关**"
    },
    {
      "id": "fe0c35d1b5cf4466",
