      "y": -23489,
      "width": 220,
      "height": 80,
      "text": "**5市场人气指标**"
    },
    {
      "id": "587ff13cc6754401",
      "type": "text",
      "x": -109,
      "y": -23489,
      "width": 220,
      "height": 80,
      "text": "**5浪**"
    },
    {
      "id": "6307e2278da946b1",
      "type": "text",
      "x": 141,
      "y": -23489,
      "width": 220,
      "height": 80,
      "text": "**5盈利能力分析**"
    },
    {
      "id": "71b0d4493679417b",
      "type": "text",
      "x": -359,
      "y": -23379,
      "width": 220,
      "height": 80,
      "text": "**5证券监管机构**"
    },
    {
      "id": "46b298d7a8b646eb",
      "type": "text",
      "x": -109,
      "y": -23379,
      "width": 220,
      "height": 80,
      "text": "**6 扇形原理,速度线 甘氏线**"
    },
    {
      "id": "adbe241dd1574848",
      "type": "text",
      "x": 141,
      "y": -23379,
      "width": 220,
      "height": 80,
      "text": "**6公司基本分析在上市公司调研中的实际运用**"
    },
    {
      "id": "09c483d56bd846a1",
      "type": "text",
      "x": -359,
      "y": -23269,
      "width": 220,
      "height": 80,
      "text": "**6刺穿线**"
    },
    {
      "id": "d8dfdf8f346d4c40",
      "type": "text",
      "x": -109,
      "y": -23269,
      "width": 220,
      "height": 80,
      "text": "**7 启明星**"
    },
    {
      "id": "8cd3e62f1b8042df",
      "type": "text",
      "x": 141,
      "y": -23269,
      "width": 220,
      "height": 80,
      "text": "**7乌云盖顶**"
    },
    {
      "id": "ab9c4400a243442e",
      "type": "text",
      "x": -359,
      "y": -23159,
      "width": 220,
      "height": 80,
      "text": "**7公司竞争优势分析**"
    },
    {
      "id": "a501da0d16704e76",
      "type": "text",
      "x": -109,
      "y": -23159,
      "width": 220,
      "height": 80,
      "text": "**7现金流量分析**"
    },
    {
      "id": "12fe3dfafc704b51",
      "type": "text",
      "x": 141,
      "y": -23159,
      "width": 220,
      "height": 80,
      "text": "**8 白色三兵(红色三兵),三乌鸦**"
    },
    {
      "id": "9a3bf86b28544933",
      "type": "text",
      "x": -359,
      "y": -23049,
      "width": 220,
      "height": 80,
      "text": "**9 上升三法,下降三法**"
    },
    {
      "id": "921da8469b6e4a3a",
      "type": "text",
      "x": -109,
      "y": -23049,
      "width": 220,
      "height": 80,
      "text": "**APT**"
    },
    {
      "id": "7525f3238b244522",
      "type": "text",
      "x": 141,
      "y": -23049,
      "width": 220,
      "height": 80,
      "text": "**A浪**"
    },
    {
      "id": "539df6bbdfb94a98",
      "type": "text",
      "x": -359,
      "y": -22939,
      "width": 220,
      "height": 80,
      "text": "**Beginning-of-period interest calculation (discount rate)**"
    },
    {
      "id": "1f7338a0b68c4816",
      "type": "text",
      "x": -109,
      "y": -22939,
      "width": 220,
      "height": 80,
      "text": "**B浪**"
    },
    {
      "id": "6dbe7db4b17342e4",
      "type": "text",
      "x": 141,
      "y": -22939,
      "width": 220,
      "height": 80,
      "text": "**CAPM / SML 的主要局限**"
    },
    {
      "id": "94dc43d9ffc7460c",
      "type": "text",
      "x": -359,
      "y": -22829,
      "width": 220,
      "height": 80,
      "text": "**CAPM 核心公式**"
    },
    {
      "id": "a2e79cb4d96345c8",
      "type": "text",
      "x": -109,
      "y": -22829,
      "width": 220,
      "height": 80,
      "text": "**C浪**"
    },
    {
      "id": "5c939909ee9246e0",
      "type": "text",
      "x": 141,
      "y": -22829,
      "width": 220,
      "height": 80,
      "text": "**discount rate = interest ÷ final amount**"
    },
    {
      "id": "5a1e1c2211c64308",
      "type": "text",
      "x": -359,
      "y": -22719,
      "width": 220,
      "height": 80,
      "text": "**End-of-period interest calculation (interest rate)**"
    },
    {
      "id": "f3684cc0913a400c",
      "type": "text",
      "x": -109,
      "y": -22719,
      "width": 220,
      "height": 80,
      "text": "**Example**"
    },
    {
      "id": "3fd15fb7104d49e3",
      "type": "text",
      "x": 141,
      "y": -22719,
      "width": 220,
      "height": 80,
      "text": "**Fama-French 三因子**"
    },
    {
      "id": "854247a44feb4006",
      "type": "text",
      "x": -359,
      "y": -22609,
      "width": 220,
      "height": 80,
      "text": "**In \"compound interest scenario\"**"
    },
    {
      "id": "ad2a5ef0238248d5",
      "type": "text",
      "x": -109,
      "y": -22609,
      "width": 220,
      "height": 80,
      "text": "**In \"simple interest scenario\"**"
    },
    {
      "id": "2c6c687d35ea4c84",
      "type": "text",
      "x": 141,
      "y": -22609,
      "width": 220,
      "height": 80,
      "text": "**independent of $n$**"
    },
    {
      "id": "a1fa7b3df1e5449b",
      "type": "text",
      "x": -359,
      "y": -22499,
      "width": 220,
      "height": 80,
