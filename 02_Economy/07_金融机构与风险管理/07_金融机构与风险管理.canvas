      "id": "4dec6c824899468f",
      "type": "text",
      "x": 141,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**自家债券**"
    },
    {
      "id": "4f710d5faf9146ea",
      "type": "text",
      "x": -359,
      "y": -10729,
      "width": 220,
      "height": 80,
