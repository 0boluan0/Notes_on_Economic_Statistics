      "y": -44389,
      "width": 220,
      "height": 80,
      "text": "**主题**"
    },
    {
      "id": "69e50dd47bdb4a7e",
      "type": "text",
      "x": -109,
      "y": -44389,
      "width": 220,
      "height": 80,
      "text": "**举例：**"
    },
    {
      "id": "1eafb7ccd6ff40a7",
      "type": "text",
      "x": 141,
      "y": -44389,
      "width": 220,
      "height": 80,
      "text": "**久期估计：**"
    },
    {
      "id": "5b2d097fe19742bc",
      "type": "text",
      "x": -359,
      "y": -44279,
      "width": 220,
      "height": 80,
      "text": "**久期或其衍生指标**"
    },
    {
      "id": "bc6f32d83565456a",
      "type": "text",
      "x": -109,
      "y": -44279,
      "width": 220,
      "height": 80,
      "text": "**久期提供了方便的近似**"
    },
    {
      "id": "483d8680949e4c51",
      "type": "text",
      "x": 141,
      "y": -44279,
      "width": 220,
      "height": 80,
      "text": "**买保护方**"
