      "type": "text",
      "x": -359,
      "y": -11279,
      "width": 220,
      "height": 80,
      "text": "**美式期权定价：**"
    },
    {
      "id": "a55edaf514d149bf",
      "type": "text",
      "x": -109,
      "y": -11279,
      "width": 220,
      "height": 80,
      "text": "**美式期权行权策略判断：**"
    },
    {
      "id": "6ffe2a6074744167",
      "type": "text",
      "x": 141,
      "y": -11279,
      "width": 220,
      "height": 80,
      "text": "**美式看涨不应提前行权**"
    },
    {
      "id": "bde6f9f9c0944c12",
      "type": "text",
      "x": -359,
      "y": -11169,
      "width": 220,
      "height": 80,
      "text": "**美式看涨期权**"
    },
    {
      "id": "2bc18c5267e74a08",
      "type": "text",
      "x": -109,
      "y": -11169,
      "width": 220,
      "height": 80,
      "text": "**美式看涨期权=欧式看涨期权价≈3.5元；美式看跌期权≥欧式看跌期权价≈2.24元**"
    },
    {
      "id": "8acdc2e37931428c",
      "type": "text",
      "x": 141,
      "y": -11169,
      "width": 220,
      "height": 80,
      "text": "**美式看涨期权（无红利）：**"
    },
    {
      "id": "5d49183e32f44beb",
      "type": "text",
      "x": -359,
      "y": -11059,
      "width": 220,
      "height": 80,
      "text": "**美式看跌期权**"
    },
    {
      "id": "9fa3ca463941480d",
      "type": "text",
      "x": -109,
      "y": -11059,
      "width": 220,
      "height": 80,
      "text": "**美式看跌期权：**"
    },
    {
      "id": "af82727d3b41418e",
      "type": "text",
      "x": 141,
      "y": -11059,
      "width": 220,
      "height": 80,
      "text": "**联合冲击：**"
    },
