      "id": "0679b60103a843f0",
      "type": "text",
      "x": -359,
      "y": -10949,
      "width": 220,
      "height": 80,
      "text": "**聚束在某些时期**"
    },
    {
      "id": "49d022f1e5644cc8",
      "type": "text",
      "x": -109,
      "y": -10949,
      "width": 220,
      "height": 80,
      "text": "**股票远期合约定价**"
    },
    {
      "id": "64acdbfe4b0d46d6",
      "type": "text",
      "x": 141,
      "y": -10949,
      "width": 220,
      "height": 80,
      "text": "**股票远期合约的公平远期价格**"
    },
    {
      "id": "22b5bdc0805047b2",
      "type": "text",
      "x": -359,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**能够自然反映真实分布的胖尾和异常波动**"
    },
    {
      "id": "250f607dfb7e4624",
      "type": "text",
      "x": -109,
      "y": -10839,
      "width": 220,
      "height": 80,
      "text": "**自助法（Bootstrap）模拟：**"
