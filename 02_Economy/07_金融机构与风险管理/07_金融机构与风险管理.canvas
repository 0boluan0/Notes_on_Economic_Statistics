      "type": "text",
      "x": -359,
      "y": -41200,
      "width": 220,
      "height": 80,
      "text": "**主成分分析（利率因子：平移/扭动/弯曲等）**"
    },
    {
      "id": "f2d00de870044dfd",
      "type": "text",
      "x": -109,
      "y": -41200,
      "width": 220,
      "height": 80,
