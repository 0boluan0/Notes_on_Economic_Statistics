      "width": 220,
      "height": 80,
      "text": "**卖出**"
    },
    {
      "id": "2f3a36a6788e4347",
      "type": "text",
      "x": -109,
      "y": -33170,
      "width": 220,
      "height": 80,
      "text": "**卖出1950英镑现货**"
    },
    {
      "id": "3a6da317d66f4e80",
      "type": "text",
      "x": 141,
      "y": -33170,
      "width": 220,
      "height": 80,
      "text": "**卖出20手Eurodollar利率期货**"
    },
    {
      "id": "52f26ed4f5d04137",
      "type": "text",
      "x": -359,
      "y": -33060,
      "width": 220,
      "height": 80,
      "text": "**卖出20手Eurodollar期货**"
    },
    {
      "id": "b6ffbbdbd1bb421e",
      "type": "text",
      "x": -109,
      "y": -33060,
      "width": 220,
      "height": 80,
      "text": "**卖出2550英镑现货**"
    },
    {
      "id": "5c00715822884ae3",
      "type": "text",
      "x": 141,
      "y": -33060,
      "width": 220,
      "height": 80,
      "text": "**卖出外汇**"
    },
    {
      "id": "d2e3709b6ea54e50",
      "type": "text",
      "x": -359,
      "y": -32950,
      "width": 220,
      "height": 80,
      "text": "**卖出方**"
    },
    {
      "id": "90d7446f50474512",
      "type": "text",
      "x": -109,
      "y": -32950,
      "width": 220,
      "height": 80,
      "text": "**卖出（空）远期合约**"
    },
    {
      "id": "a6168401bfc84cd2",
      "type": "text",
      "x": 141,
      "y": -32950,
      "width": 220,
      "height": 80,
      "text": "**卖空$30000$欧元现货**"
    },
    {
      "id": "8981a725883146ef",
      "type": "text",
      "x": -359,
      "y": -32840,
      "width": 220,
      "height": 80,
      "text": "**卖空现货并投资**"
    },
    {
      "id": "b58d59cda54641ba",
      "type": "text",
      "x": -109,
      "y": -32840,
      "width": 220,
      "height": 80,
      "text": "**危险在哪**"
    },
    {
      "id": "cf0fe6631f294f75",
      "type": "text",
      "x": 141,
      "y": -32840,
      "width": 220,
      "height": 80,
      "text": "**即价格约下降 $\\boxed{0.00595}$**"
    },
    {
      "id": "c575667030994241",
      "type": "text",
      "x": -359,
      "y": -32730,
      "width": 220,
      "height": 80,
      "text": "**历史极端情景：**"
    },
    {
      "id": "b138ee5092034bf9",
      "type": "text",
      "x": -109,
      "y": -32730,
      "width": 220,
      "height": 80,
      "text": "**历史模拟法练习题**"
    },
    {
      "id": "ef989d54da7247b2",
      "type": "text",
      "x": 141,
      "y": -32730,
      "width": 220,
      "height": 80,
      "text": "**历史模拟法（Historical Simulation Method）**"
    },
    {
      "id": "a5b98511b4ac4d44",
      "type": "text",
      "x": -359,
      "y": -32620,
      "width": 220,
      "height": 80,
      "text": "**历史违约概率**"
    },
    {
      "id": "f12e972227b643d4",
      "type": "text",
      "x": -109,
      "y": -32620,
      "width": 220,
      "height": 80,
      "text": "**历史重现**"
    },
    {
      "id": "8aa2415c3f6f448f",
      "type": "text",
      "x": 141,
      "y": -32620,
      "width": 220,
      "height": 80,
      "text": "**压低**"
    },
    {
      "id": "451fe88915134d12",
      "type": "text",
      "x": -359,
      "y": -32510,
      "width": 220,
      "height": 80,
      "text": "**压力测试、sVaR、IRC、CRM、杠杆率与流动性指标**"
    },
    {
      "id": "745aae76d0984164",
      "type": "text",
      "x": -109,
      "y": -32510,
      "width": 220,
      "height": 80,
      "text": "**压力测试类型：**"
    },
    {
      "id": "df3f2b8125304ba1",
      "type": "text",
      "x": 141,
      "y": -32510,
      "width": 220,
      "height": 80,
      "text": "**压力测试结果应用与VaR结合**"
    },
    {
      "id": "2fb9f9c71fc848f0",
      "type": "text",
      "x": -359,
      "y": -32400,
      "width": 220,
      "height": 80,
      "text": "**压力风险价值度（Stressed VaR）**"
    },
    {
      "id": "c87e72e7de3f4c8a",
      "type": "text",
      "x": -109,
      "y": -32400,
      "width": 220,
      "height": 80,
      "text": "**厚尾分布实例：**"
    },
    {
      "id": "8fad534d51f648d9",
      "type": "text",
      "x": 141,
      "y": -32400,
      "width": 220,
      "height": 80,
      "text": "**厚尾特征**"
    },
    {
      "id": "e2d62a1f4d9e489a",
      "type": "text",
      "x": -359,
      "y": -32290,
      "width": 220,
      "height": 80,
      "text": "**厚尾的影响及应对：**"
    },
    {
      "id": "9c97d3965dcb4e5a",
      "type": "text",
      "x": -109,
      "y": -32290,
      "width": 220,
      "height": 80,
      "text": "**参数估计（最大似然法）：**"
    },
    {
      "id": "422c04e3f68a4332",
      "type": "text",
      "x": 141,
      "y": -32290,
      "width": 220,
      "height": 80,
      "text": "**参数可变时**"
    },
    {
      "id": "4df0a166ee1b4c8d",
      "type": "text",
      "x": -359,
      "y": -32180,
      "width": 220,
      "height": 80,
      "text": "**参数选择：**"
    },
    {
      "id": "90274c297eb34a5f",
      "type": "text",
      "x": -109,
      "y": -32180,
      "width": 220,
      "height": 80,
      "text": "**参考利率基准不同**"
    },
    {
      "id": "44920538eebf4042",
      "type": "text",
      "x": 141,
      "y": -32180,
      "width": 220,
      "height": 80,
      "text": "**参考文献：**"
    },
    {
      "id": "3dd5e58335b047dc",
      "type": "text",
      "x": -359,
      "y": -32070,
      "width": 220,
      "height": 80,
      "text": "**双边清算**"
    },
    {
      "id": "1e6961327017475c",
      "type": "text",
      "x": -109,
      "y": -32070,
      "width": 220,
      "height": 80,
      "text": "**双边清算（Bilateral Clearing）**"
    },
    {
      "id": "1ba37d3347174144",
      "type": "text",
      "x": 141,
      "y": -32070,
      "width": 220,
      "height": 80,
      "text": "**发生时点 $t$ (年)**"
    },
    {
      "id": "610de82c92ed4be3",
      "type": "text",
      "x": -359,
      "y": -31960,
      "width": 220,
      "height": 80,
      "text": "**取分位数作为VaR：**"
    },
    {
      "id": "495c758e58be40d2",
      "type": "text",
      "x": -109,
      "y": -31960,
      "width": 220,
      "height": 80,
      "text": "**取对数转正态**"
    },
    {
      "id": "ec7de0c60dd04055",
      "type": "text",
      "x": 141,
      "y": -31960,
      "width": 220,
      "height": 80,
      "text": "**取正态分位点 $Y_t = \\Phi^{-1}(l_t)$**"
    },
    {
      "id": "8ae6983f135f4f12",
      "type": "text",
      "x": -359,
      "y": -31850,
      "width": 220,
      "height": 80,
      "text": "**变动保证金则不受限制**"
    },
    {
      "id": "96b1df8233a04ba3",
      "type": "text",
      "x": -109,
      "y": -31850,
      "width": 220,
      "height": 80,
      "text": "**变动保证金（Variation Margin, VM）**"
    },
    {
      "id": "c469f231337444c8",
      "type": "text",
      "x": 141,
      "y": -31850,
      "width": 220,
      "height": 80,
      "text": "**变更**"
    },
    {
      "id": "8ea8df43be574e5b",
      "type": "text",
      "x": -359,
      "y": -31740,
      "width": 220,
      "height": 80,
      "text": "**叠加到原组合每条路径的价值上，以更新计算敞口均值$v_i$的变化 。新旧$v_i$之差代入公式$(1-R)\\sum q_i \\Delta v_i$，即可得到**"
    },
    {
      "id": "5ead8752ff544105",
      "type": "text",
      "x": -109,
      "y": -31740,
      "width": 220,
      "height": 80,
      "text": "**口径**"
    },
    {
      "id": "f4230e0ba4fd4cf1",
      "type": "text",
      "x": 141,
      "y": -31740,
      "width": 220,
      "height": 80,
      "text": "**口诀**"
    },
    {
      "id": "f1fe7f5c540e4e10",
      "type": "text",
      "x": -359,
      "y": -31630,
      "width": 220,
      "height": 80,
      "text": "**口诀：**"
    },
    {
      "id": "2a3ef2664b9445f5",
      "type": "text",
      "x": -109,
      "y": -31630,
      "width": 220,
      "height": 80,
      "text": "**口语速记**"
    },
    {
      "id": "c58921639d244ca1",
      "type": "text",
      "x": 141,
      "y": -31630,
      "width": 220,
      "height": 80,
      "text": "**只有 1 年期的部分**"
    },
    {
      "id": "5bfd0a668eb744db",
      "type": "text",
      "x": -359,
      "y": -31520,
      "width": 220,
      "height": 80,
      "text": "**只考虑波动，忽略方向和极端事件**"
    },
    {
      "id": "8f02a8b509f842ef",
      "type": "text",
      "x": -109,
      "y": -31520,
      "width": 220,
      "height": 80,
      "text": "**可变动利率的资产超出负债5亿元**"
    },
    {
      "id": "e358473525bd46f4",
      "type": "text",
      "x": 141,
      "y": -31520,
      "width": 220,
      "height": 80,
      "text": "**可操作性**"
    },
    {
      "id": "1dd0f8b9029d4609",
      "type": "text",
      "x": -359,
      "y": -31410,
      "width": 220,
      "height": 80,
      "text": "**合约末期**"
    },
    {
      "id": "c2a3882c80954d65",
      "type": "text",
      "x": -109,
      "y": -31410,
      "width": 220,
      "height": 80,
      "text": "**合约类型**"
    },
    {
      "id": "a9366c045dbf440a",
      "type": "text",
      "x": 141,
      "y": -31410,
      "width": 220,
      "height": 80,
      "text": "**合计总资本**"
    },
    {
      "id": "02c7717a78b14a02",
      "type": "text",
      "x": -359,
      "y": -31300,
      "width": 220,
      "height": 80,
      "text": "**合计资本要求 ≈ 1.10 百万美元**"
    },
    {
      "id": "ef9ccf44b8e04c0c",
      "type": "text",
      "x": -109,
      "y": -31300,
      "width": 220,
      "height": 80,
      "text": "**合计（Gap）**"
    },
    {
      "id": "98206ce3fe074532",
      "type": "text",
      "x": 141,
      "y": -31300,
      "width": 220,
      "height": 80,
      "text": "**同业负债成本↑**"
    },
    {
      "id": "de364e1be9814d30",
      "type": "text",
      "x": -359,
      "y": -31190,
      "width": 220,
      "height": 80,
      "text": "**同时处于极端**"
    },
    {
      "id": "3c88bafe12fd4ada",
      "type": "text",
      "x": -109,
      "y": -31190,
      "width": 220,
      "height": 80,
      "text": "**同时大量索取现金担保**"
    },
    {
      "id": "74fd7163f15541f1",
      "type": "text",
      "x": 141,
      "y": -31190,
      "width": 220,
      "height": 80,
      "text": "**同时违约**"
    },
    {
      "id": "1f80aa3241d54867",
      "type": "text",
      "x": -359,
      "y": -31080,
      "width": 220,
      "height": 80,
      "text": "**名义1000万美元**"
    },
    {
      "id": "304cc5e29f2c464d",
      "type": "text",
      "x": -109,
      "y": -31080,
      "width": 220,
      "height": 80,
      "text": "**含义**"
    },
    {
      "id": "8ee036dfe1e34ef5",
      "type": "text",
      "x": 141,
      "y": -31080,
      "width": 220,
      "height": 80,
      "text": "**和 Basel 数字对着看，更易记！**"
    },
    {
      "id": "8486e3c768e64a2d",
      "type": "text",
      "x": -359,
      "y": -30970,
      "width": 220,
      "height": 80,
      "text": "**响应快速：**"
    },
    {
      "id": "bd26b61a2a13450f",
      "type": "text",
      "x": -109,
      "y": -30970,
      "width": 220,
      "height": 80,
      "text": "**哪个方法最好？**"
    },
    {
      "id": "e56658ce9fca42ff",
      "type": "text",
      "x": 141,
      "y": -30970,
      "width": 220,
      "height": 80,
      "text": "**商品†**"
    },
    {
      "id": "4de0e8b69c8043ef",
      "type": "text",
      "x": -359,
      "y": -30860,
      "width": 220,
      "height": 80,
      "text": "**四、信用等级下降 & 抵押品不足导致损失 (19 · 3 “担保品与补救期”)**"
    },
    {
      "id": "dda837fa206b4486",
      "type": "text",
      "x": -109,
      "y": -30860,
      "width": 220,
      "height": 80,
      "text": "**四、概念总结**"
    },
    {
      "id": "ec65ec5aa11740ce",
      "type": "text",
      "x": 141,
      "y": -30860,
      "width": 220,
      "height": 80,
      "text": "**回溯检验（Backtesting）**"
    },
    {
      "id": "bb80fefaaec041bd",
      "type": "text",
      "x": -359,
      "y": -30750,
      "width": 220,
      "height": 80,
      "text": "**因为$\\Gamma$为负**"
    },
    {
      "id": "09a708baa7034dbb",
      "type": "text",
      "x": -109,
      "y": -30750,
      "width": 220,
      "height": 80,
      "text": "**固定利率接收方**"
    },
    {
      "id": "bb9e361b4d804348",
      "type": "text",
      "x": 141,
      "y": -30750,
      "width": 220,
      "height": 80,
      "text": "**固定息票 $C$**"
    },
    {
      "id": "58e77fc4e23c48e2",
      "type": "text",
      "x": -359,
      "y": -30640,
      "width": 220,
      "height": 80,
      "text": "**固定接收方**"
    },
    {
      "id": "f190489fa0a14775",
      "type": "text",
      "x": -109,
      "y": -30640,
      "width": 220,
      "height": 80,
      "text": "**固定支付方**"
    },
    {
      "id": "f4a87bb0913d4210",
      "type": "text",
      "x": 141,
      "y": -30640,
      "width": 220,
      "height": 80,
      "text": "**国库券**"
    },
    {
      "id": "e27c930c2e50485d",
      "type": "text",
      "x": -359,
      "y": -30530,
      "width": 220,
      "height": 80,
      "text": "**在 $5\\%$ 显著性水平下，**"
    },
    {
      "id": "ecf48528795740de",
      "type": "text",
      "x": -109,
      "y": -30530,
      "width": 220,
      "height": 80,
      "text": "**在实际建模时，$X$和$Y$各自的$\\omega$参数通常要**"
    },
    {
      "id": "2f3f66df02784e18",
      "type": "text",
      "x": 141,
      "y": -30530,
      "width": 220,
      "height": 80,
      "text": "**在考虑现金流可随市场利率变化（如含期权、可赎回债券等复杂产品）时，债券价格对利率小幅变化的敏感度**"
    },
    {
      "id": "0fb7fcfdd89c4168",
      "type": "text",
      "x": -359,
      "y": -30420,
      "width": 220,
      "height": 80,
      "text": "**地区系统重要性银行（D-SIBs）**"
    },
    {
      "id": "7b859d26681d42cf",
      "type": "text",
      "x": -109,
      "y": -30420,
      "width": 220,
      "height": 80,
      "text": "**场外交易电子化与清算所化**"
    },
    {
      "id": "bbe86eeb7f734bb4",
      "type": "text",
      "x": 141,
      "y": -30420,
      "width": 220,
      "height": 80,
      "text": "**场外衍生品信用风险资本**"
    },
    {
      "id": "d3f25acc5a504a21",
      "type": "text",
      "x": -359,
      "y": -30310,
      "width": 220,
      "height": 80,
      "text": "**场景**"
    },
    {
      "id": "83bc07fd69c640f6",
      "type": "text",
      "x": -109,
      "y": -30310,
      "width": 220,
      "height": 80,
      "text": "**场景A**"
    },
    {
      "id": "22ae77c429244357",
      "type": "text",
      "x": 141,
      "y": -30310,
      "width": 220,
      "height": 80,
      "text": "**场景A：**"
    },
    {
      "id": "54d19764c49a4bb1",
      "type": "text",
      "x": -359,
      "y": -30200,
      "width": 220,
      "height": 80,
      "text": "**场景B**"
    },
    {
      "id": "006b79317d254f9a",
      "type": "text",
      "x": -109,
      "y": -30200,
      "width": 220,
      "height": 80,
      "text": "**场景B：**"
    },
    {
      "id": "bf564caf5e3145a8",
      "type": "text",
      "x": 141,
      "y": -30200,
      "width": 220,
      "height": 80,
      "text": "**场景举例**"
    },
    {
      "id": "0461677b49dd48e3",
      "type": "text",
