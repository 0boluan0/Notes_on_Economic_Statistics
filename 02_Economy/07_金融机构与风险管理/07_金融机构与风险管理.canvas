      "id": "6dbf00cd661645b4",
      "type": "text",
      "x": -109,
      "y": -40320,
      "width": 220,
      "height": 80,
      "text": "**五、举例说明**"
    },
    {
      "id": "3ca4ecc1526a45aa",
      "type": "text",
      "x": 141,
      "y": -40320,
      "width": 220,
      "height": 80,
      "text": "**交易对手风险**"
    },
    {
      "id": "2d948e45b4cd42df",
      "type": "text",
      "x": -359,
      "y": -40210,
      "width": 220,
      "height": 80,
      "text": "**交易对手风险 (Counterparty Risk)**"
    },
    {
      "id": "74b70965a0e342e9",
      "type": "text",
      "x": -109,
      "y": -40210,
      "width": 220,
      "height": 80,
      "text": "**交易所提供场外产品**"
    },
    {
      "id": "a4a8c06f234f47fe",
      "type": "text",
      "x": 141,
      "y": -40210,
      "width": 220,
      "height": 80,
      "text": "**交易报告与仓库**"
    },
    {
      "id": "26be22477ce34aba",
      "type": "text",
      "x": -359,
      "y": -40100,
      "width": 220,
      "height": 80,
      "text": "**交易日与日历日：**"
    },
    {
      "id": "128dd6f89d864b0f",
      "type": "text",
      "x": -109,
      "y": -40100,
      "width": 220,
      "height": 80,
      "text": "**交易簿 (Trading Book)**"
    },
    {
      "id": "6595c81337924b43",
      "type": "text",
      "x": 141,
      "y": -40100,
      "width": 220,
      "height": 80,
      "text": "**交易簿 VaR 用 10 d × mc**"
    },
    {
      "id": "7af6fba2e24f47d9",
      "type": "text",
