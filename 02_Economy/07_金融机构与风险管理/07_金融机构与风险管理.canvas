      "x": -359,
      "y": -1159,
      "width": 220,
      "height": 80,
      "text": "**高频数据阶段：**"
    },
    {
      "id": "92c793721d1c44ee",
      "type": "text",
      "x": -109,
      "y": -1159,
      "width": 220,
      "height": 80,
      "text": "**麦考利久期**"
