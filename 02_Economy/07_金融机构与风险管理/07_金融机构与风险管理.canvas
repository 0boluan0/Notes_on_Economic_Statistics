      "y": -43949,
      "width": 220,
      "height": 80,
      "text": "**争议1:**"
    },
    {
      "id": "a95ebdb90e08478a",
      "type": "text",
      "x": -359,
      "y": -43839,
      "width": 220,
      "height": 80,
      "text": "**争议2:**"
    },
    {
      "id": "65562dbb2a904428",
      "type": "text",
      "x": -109,
      "y": -43839,
      "width": 220,
      "height": 80,
      "text": "**事件**"
    },
    {
      "id": "4074a3f11ce24bda",
      "type": "text",
      "x": 141,
      "y": -43839,
      "width": 220,
      "height": 80,
      "text": "**二、CDS 合同：多情景下买卖双方收益 (19 · 2 “CDS 合约收益比较”)**"
    },
    {
      "id": "efbcd4b2abf04f4c",
      "type": "text",
      "x": -359,
      "y": -43729,
      "width": 220,
      "height": 80,
      "text": "**二、有分红的欧式期权定价**"
    },
    {
      "id": "9c39ad24e5b34d69",
      "type": "text",
      "x": -109,
      "y": -43729,
      "width": 220,
      "height": 80,
      "text": "**二阶矩**"
    },
    {
      "id": "33ee1aee5b784a6b",
      "type": "text",
      "x": 141,
      "y": -43729,
      "width": 220,
      "height": 80,
      "text": "**互换价值减少**"
    },
    {
      "id": "6b0ba97fa82c4478",
      "type": "text",
      "x": -359,
      "y": -43619,
      "width": 220,
      "height": 80,
      "text": "**互操作（Interoperability）**"
    },
    {
      "id": "db9a6acb68604079",
      "type": "text",
      "x": -109,
      "y": -43619,
      "width": 220,
      "height": 80,
      "text": "**五、举例说明**"
    },
    {
      "id": "b73d6689cbb947ec",
      "type": "text",
      "x": 141,
      "y": -43619,
      "width": 220,
      "height": 80,
      "text": "**交易产品的风险度量指标**"
    },
    {
      "id": "a941635e6dba46a7",
      "type": "text",
      "x": -359,
      "y": -43509,
      "width": 220,
      "height": 80,
      "text": "**交易对手**"
    },
    {
      "id": "6b35ff7ef9fc435e",
      "type": "text",
      "x": -109,
      "y": -43509,
      "width": 220,
      "height": 80,
      "text": "**交易对手风险**"
    },
    {
      "id": "2799617ae9be47e4",
      "type": "text",
      "x": 141,
      "y": -43509,
      "width": 220,
      "height": 80,
      "text": "**交易对手风险 (Counterparty Risk)**"
    },
    {
      "id": "cad77b8c14684e80",
      "type": "text",
      "x": -359,
      "y": -43399,
      "width": 220,
      "height": 80,
      "text": "**交易所提供场外产品**"
    },
    {
      "id": "a3f063c6dec04061",
      "type": "text",
      "x": -109,
      "y": -43399,
      "width": 220,
      "height": 80,
      "text": "**交易报告与仓库**"
    },
    {
      "id": "5eb6f57487624708",
      "type": "text",
      "x": 141,
      "y": -43399,
      "width": 220,
      "height": 80,
      "text": "**交易日与日历日：**"
    },
    {
      "id": "c4b99e1b6ead4b8e",
      "type": "text",
      "x": -359,
      "y": -43289,
      "width": 220,
      "height": 80,
      "text": "**交易簿 (Trading Book)**"
    },
