      "height": 80,
      "text": "**事件**"
    },
    {
      "id": "249e7561c4bc4ab2",
      "type": "text",
      "x": 141,
      "y": -40540,
      "width": 220,
      "height": 80,
      "text": "**二、CDS 合同：多情景下买卖双方收益 (19 · 2 “CDS 合约收益比较”)**"
    },
    {
      "id": "38efc3c385934db7",
      "type": "text",
      "x": -359,
      "y": -40430,
      "width": 220,
      "height": 80,
      "text": "**二、有分红的欧式期权定价**"
    },
    {
      "id": "a1517d2c62574f0a",
      "type": "text",
      "x": -109,
      "y": -40430,
      "width": 220,
      "height": 80,
      "text": "**二阶矩**"
    },
    {
      "id": "bcfc80e3560a413b",
      "type": "text",
      "x": 141,
      "y": -40430,
      "width": 220,
      "height": 80,
      "text": "**互换价值减少**"
    },
    {
      "id": "c52a061dd43d4de7",
      "type": "text",
      "x": -359,
      "y": -40320,
      "width": 220,
      "height": 80,
