      "id": "d48930af61c04975",
      "type": "text",
      "x": -359,
      "y": -9630,
      "width": 220,
      "height": 80,
      "text": "**不同人均收入水平$Y_1, Y_2, Y_3, Y_4$**"
    },
    {
      "id": "9ea892ced4af45fb",
      "type": "text",
      "x": -109,
      "y": -9630,
      "width": 220,
      "height": 80,
      "text": "**东亚选择性保护工业化战略分析：以韩国和台湾为中心 (20世纪中后期)**"
    },
    {
      "id": "a13b282638b8449a",
      "type": "text",
      "x": 141,
      "y": -9630,
      "width": 220,
      "height": 80,
      "text": "**东亚选择性保护的成功**"
    },
    {
      "id": "e7ae75627cda432c",
      "type": "text",
      "x": -359,
      "y": -9520,
      "width": 220,
      "height": 80,
      "text": "**两年额外采购目标仅完成约60%**"
    },
    {
      "id": "ba39e134ddea4e62",
      "type": "text",
      "x": -109,
      "y": -9520,
      "width": 220,
      "height": 80,
      "text": "**两条需求曲线：$d_0$ 与 $d_1$**"
