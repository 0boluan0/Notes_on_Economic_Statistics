      "id": "07615de01acb4a8c",
      "type": "text",
      "x": 141,
      "y": -3909,
      "width": 220,
      "height": 80,
      "text": "**纵轴：工资 or 边际产出**"
    },
    {
      "id": "3a8ed1ff9e9745a6",
      "type": "text",
      "x": -359,
      "y": -3799,
      "width": 220,
      "height": 80,
      "text": "**纵轴：粮食价格**"
    },
    {
      "id": "4d48768e7c084770",
      "type": "text",
      "x": -109,
      "y": -3799,
      "width": 220,
      "height": 80,
      "text": "**经济增长在世界范围内有限扩散**"
    },
