      "id": "eb6a558b11f04e93",
      "type": "text",
      "x": -359,
      "y": -4679,
      "width": 220,
      "height": 80,
      "text": "**消费品价格上升压力**"
    },
    {
      "id": "d2a5b5a6abc24aac",
      "type": "text",
      "x": -109,
      "y": -4679,
      "width": 220,
      "height": 80,
      "text": "**深化对华经贸合作**"
    },
