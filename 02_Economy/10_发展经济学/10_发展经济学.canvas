      "id": "9abc9fda5f684763",
      "type": "text",
      "x": -109,
      "y": -3690,
      "width": 220,
      "height": 80,
      "text": "**结构性改革**"
    },
    {
      "id": "9681b7f9d0aa4da0",
      "type": "text",
      "x": 141,
      "y": -3690,
      "width": 220,
      "height": 80,
      "text": "**结果**"
    },
    {
      "id": "8e092482a47e46af",
      "type": "text",
      "x": -359,
      "y": -3580,
      "width": 220,
      "height": 80,
      "text": "**结果：**"
    },
    {
      "id": "0bbffdcadab043a7",
      "type": "text",
      "x": -109,
      "y": -3580,
      "width": 220,
      "height": 80,
      "text": "**绩效约束**"
    },
    {
      "id": "d17d3014283e4514",
      "type": "text",
      "x": 141,
      "y": -3580,
      "width": 220,
      "height": 80,
      "text": "**美国从中国进口占比**"
    },
    {
      "id": "14f0f0d89b8c4942",
      "type": "text",
      "x": -359,
      "y": -3470,
      "width": 220,
      "height": 80,
      "text": "**美国对华出口恢复迟滞**"
    },
    {
      "id": "943a236f6ee74105",
      "type": "text",
      "x": -109,
      "y": -3470,
      "width": 220,
      "height": 80,
      "text": "**聚焦高科技和中小企业**"
    },
    {
      "id": "3243ce71c75f4fe3",
      "type": "text",
      "x": 141,
      "y": -3470,
      "width": 220,
      "height": 80,
      "text": "**股市大幅波动**"
    },
    {
      "id": "1ff4440377a1425b",
      "type": "text",
      "x": -359,
      "y": -3360,
      "width": 220,
      "height": 80,
      "text": "**自发调节**"
    },
    {
      "id": "b4a789a6c8634655",
      "type": "text",
      "x": -109,
      "y": -3360,
      "width": 220,
      "height": 80,
      "text": "**自工业革命以来出现的一种国家经济持续快速增长的现象。**"
    },
    {
      "id": "0cf74d3159c54606",
      "type": "text",
      "x": 141,
      "y": -3360,
      "width": 220,
      "height": 80,
      "text": "**自然增长率$G_N = n$**"
    },
    {
      "id": "9e8c3313c66a4ae5",
      "type": "text",
      "x": -359,
      "y": -3250,
      "width": 220,
      "height": 80,
      "text": "**自然资源**"
    },
    {
      "id": "0705ad4bc3ff4864",
      "type": "text",
      "x": -109,
      "y": -3250,
      "width": 220,
      "height": 80,
      "text": "**补贴与财政激励：两国政府向重点产业提供直接或间接补贴，以降低其成本、提高竞争力。其中出口补贴**"
    },
    {
      "id": "01f74f4dcec647c4",
      "type": "text",
      "x": 141,
      "y": -3250,
      "width": 220,
      "height": 80,
      "text": "**调整与自由化阶段（1980-1990年代）**"
    },
    {
      "id": "de9c0776dd8c46fe",
      "type": "text",
      "x": -359,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**财政与金融负担：**"
    },
    {
      "id": "f4e26808b321453b",
      "type": "text",
      "x": -109,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**财阀**"
    },
    {
      "id": "e32b6349cc664434",
      "type": "text",
      "x": 141,
      "y": -3140,
      "width": 220,
      "height": 80,
      "text": "**贸易战带来的机遇与挑战：**"
    },
    {
      "id": "2d899912dc7c4bcb",
      "type": "text",
      "x": -359,
      "y": -3030,
      "width": 220,
      "height": 80,
      "text": "**贸易摩擦与市场压力：**"
    },
    {
      "id": "a3ef01cddbd04c81",
      "type": "text",
      "x": -109,
      "y": -3030,
      "width": 220,
      "height": 80,
      "text": "**贸易极限施压**"
    },
    {
      "id": "bb103c56957745bc",
      "type": "text",
      "x": 141,
      "y": -3030,
      "width": 220,
      "height": 80,
      "text": "**贸易转移与出口激增：**"
    },
    {
      "id": "b1b9dd4bca594b63",
      "type": "text",
      "x": -359,
      "y": -2920,
      "width": 220,
      "height": 80,
      "text": "**资本密集型和技术密集型产业**"
    },
    {
      "id": "7be01fdfe8d3486d",
      "type": "text",
      "x": -109,
      "y": -2920,
      "width": 220,
      "height": 80,
      "text": "**资源错配与低效风险：**"
    },
    {
      "id": "219e4a74e1354dd4",
      "type": "text",
      "x": 141,
      "y": -2920,
      "width": 220,
      "height": 80,
      "text": "**起步的进口替代阶段（1950年代）**"
    },
    {
      "id": "490a8928cabd4018",
      "type": "text",
      "x": -359,
      "y": -2810,
      "width": 220,
      "height": 80,
      "text": "**超100%关税**"
    },
    {
      "id": "e5247f0afc2d4078",
      "type": "text",
      "x": -109,
      "y": -2810,
      "width": 220,
      "height": 80,
      "text": "**越南**"
    },
    {
      "id": "26eb31f09a204fcd",
      "type": "text",
      "x": 141,
      "y": -2810,
      "width": 220,
      "height": 80,
      "text": "**越南对美出口**"
    },
    {
      "id": "0146246aa8244f3c",
      "type": "text",
      "x": -359,
      "y": -2700,
      "width": 220,
      "height": 80,
      "text": "**近六成**"
    },
    {
      "id": "82f3fee11ab54a47",
      "type": "text",
      "x": -109,
      "y": -2700,
      "width": 220,
      "height": 80,
      "text": "**适时开放**"
    },
    {
      "id": "dd6e45f8bdc149bd",
      "type": "text",
      "x": 141,
      "y": -2700,
      "width": 220,
      "height": 80,
      "text": "**选择性保护**"
    },
    {
      "id": "0bcd56f54ede4552",
      "type": "text",
      "x": -359,
      "y": -2590,
      "width": 220,
      "height": 80,
      "text": "**选择性保护+出口纪律**"
    },
    {
      "id": "3bbae7ef47f84a0b",
      "type": "text",
      "x": -109,
      "y": -2590,
      "width": 220,
      "height": 80,
      "text": "**选择性保护政策**"
    },
    {
      "id": "dfebe821c2ab4578",
      "type": "text",
      "x": 141,
      "y": -2590,
      "width": 220,
      "height": 80,
      "text": "**选择性和阶段性的保护**"
    },
    {
      "id": "e868f5eba7f54a04",
      "type": "text",
      "x": -359,
      "y": -2480,
      "width": 220,
      "height": 80,
      "text": "**重化工业化战略（HCI）**"
    },
    {
      "id": "b8b04b51b4ab4b30",
      "type": "text",
      "x": -109,
      "y": -2480,
      "width": 220,
      "height": 80,
      "text": "**重化工业推进阶段（1970年代）**"
    },
    {
      "id": "e318423f150d44ac",
      "type": "text",
      "x": 141,
      "y": -2480,
      "width": 220,
      "height": 80,
      "text": "**重要的推论与现实局限：**"
    },
    {
      "id": "97ae254bb8144fc9",
      "type": "text",
      "x": -359,
      "y": -2370,
      "width": 220,
      "height": 80,
      "text": "**长期效应**"
    },
    {
      "id": "35548e14ee7c4985",
      "type": "text",
      "x": -109,
      "y": -2370,
      "width": 220,
      "height": 80,
      "text": "**长期稳定增长**"
    },
    {
      "id": "ff8ca2ceccca426d",
      "type": "text",
      "x": 141,
      "y": -2370,
      "width": 220,
      "height": 80,
      "text": "**降低关税、取消出口税**"
    },
    {
      "id": "4b505353183b423f",
      "type": "text",
      "x": -359,
      "y": -2260,
      "width": 220,
      "height": 80,
      "text": "**降低进口关税**"
    },
    {
      "id": "2e9722f6a9944e23",
      "type": "text",
      "x": -109,
      "y": -2260,
      "width": 220,
      "height": 80,
      "text": "**降低部分关税、放宽进口管制**"
    },
    {
      "id": "b3437a38eaea49f9",
      "type": "text",
      "x": 141,
      "y": -2260,
      "width": 220,
      "height": 80,
      "text": "**需求上升：需求曲线从$d_0$移至$d_1$**"
    },
    {
      "id": "9efcd4e78ac54bbb",
      "type": "text",
      "x": -359,
      "y": -2150,
      "width": 220,
      "height": 80,
      "text": "**韩国初期产业结构：战后韩国依赖美援维持经济稳定，50年代末开始建立基础工业和进口替代的轻工业。1950年代实施过进口替代政策**"
    },
    {
      "id": "5b5d0b7d335d4659",
      "type": "text",
      "x": -109,
      "y": -2150,
      "width": 220,
      "height": 80,
      "text": "**预期目标难以实现**"
    },
    {
      "id": "984939928e4140ad",
      "type": "text",
      "x": 141,
      "y": -2150,
      "width": 220,
      "height": 80,
      "text": "**首次允许进口阿根廷豆粕（豆粉）**"
    },
    {
      "id": "239ca6664a074901",
      "type": "text",
      "x": -359,
      "y": -2040,
      "width": 220,
      "height": 80,
      "text": "**马尔萨斯陷阱的含义**"
    },
    {
      "id": "f2629392cf444ec1",
      "type": "text",
      "x": -109,
      "y": -2040,
      "width": 220,
      "height": 80,
      "text": "**马来西亚、泰国**"
    },
    {
      "id": "08790e0b2f7e4097",
      "type": "text",
      "x": 141,
      "y": -2040,
      "width": 220,
      "height": 80,
      "text": "**高关税与进口管制：**"
    },
    {
      "id": "849dcecefe524cde",
      "type": "text",
      "x": -359,
      "y": -1930,
      "width": 220,
      "height": 80,
      "text": "**高科技**"
    },
    {
      "id": "7fb6bdf56fec4a0c",
      "type": "text",
      "x": -109,
      "y": -1930,
      "width": 220,
      "height": 80,
      "text": "**高素质人力资本**"
    },
    {
      "id": "c31fbc44b4874b64",
      "type": "text",
      "x": 141,
      "y": -1930,
      "width": 220,
      "height": 80,
      "text": "**（1）人口增长率增加对稳态人均资本和人均产出的影响：**"
    },
    {
      "id": "1059956b7af64915",
      "type": "text",
      "x": -359,
      "y": -1820,
      "width": 220,
      "height": 80,
      "text": "**（1）储蓄率提高对稳态人均资本和人均产量的影响：**"
    },
    {
      "id": "7036d330183c4486",
      "type": "text",
      "x": -109,
      "y": -1820,
      "width": 220,
      "height": 80,
      "text": "**（1）市场多元化与贸易重组：**"
    },
    {
      "id": "2d6b9bb3ab734330",
      "type": "text",
      "x": 141,
      "y": -1820,
      "width": 220,
      "height": 80,
      "text": "**（1）经济量扩张**"
    },
    {
      "id": "08dd4fc0d0d34ad9",
      "type": "text",
      "x": -359,
      "y": -1710,
      "width": 220,
      "height": 80,
      "text": "**（2）人口增长的经济含义：**"
    },
    {
      "id": "475d04ad80a64efd",
      "type": "text",
      "x": -109,
      "y": -1710,
      "width": 220,
      "height": 80,
      "text": "**（2）参与自由贸易协定与降低关税壁垒：**"
    },
    {
      "id": "222839a77505427e",
      "type": "text",
      "x": 141,
      "y": -1710,
      "width": 220,
      "height": 80,
      "text": "**（2）短期和长期效应（图20-7）：**"
    },
    {
      "id": "9970ce4937164fdf",
      "type": "text",
      "x": -359,
      "y": -1600,
      "width": 220,
      "height": 80,
      "text": "**（2）经济社会结构变化**"
    },
    {
      "id": "16db4ec6daf44eae",
      "type": "text",
      "x": -109,
      "y": -1600,
      "width": 220,
      "height": 80,
      "text": "**（3）吸引投资与本地产业升级：**"
    },
    {
      "id": "e8e727e73d054904",
      "type": "text",
      "x": 141,
      "y": -1600,
      "width": 220,
      "height": 80,
      "text": "**（3）增长的国际贸易**"
    },
    {
      "id": "04345010ac5c4592",
      "type": "text",
      "x": -359,
      "y": -1490,
      "width": 220,
      "height": 80,
      "text": "**（4）财政金融支持与社会保障：**"
    },
    {
      "id": "02b98d1f391f4db2",
      "type": "text",
      "x": -109,
      "y": -1490,
      "width": 220,
      "height": 80,
      "text": "**，在引导经济方面“不亚于拉美国家政府的介入深度，但更具有效性” 。因此，选择性保护不是不干预，而是**"
    },
    {
      "id": "a178574170b346c1",
      "type": "text",
      "x": 141,
      "y": -1490,
      "width": 220,
      "height": 80,
      "text": "**，如韩国90年代几乎完全开放市场 ，台湾取消大部分补贴和管制。这种**"
    },
    {
      "id": "d743c7e7cd034fef",
      "type": "text",
      "x": -359,
      "y": -1380,
      "width": 220,
      "height": 80,
      "text": "**Opportunity Cost**"
    },
    {
      "id": "3330735540a44018",
      "type": "text",
      "x": -109,
      "y": -1380,
      "width": 220,
      "height": 80,
      "text": "**Classical Economics**"
    },
    {
      "id": "64f5f06520764169",
      "type": "text",
      "x": 141,
      "y": -1380,
      "width": 220,
      "height": 80,
      "text": "**Marginal VaR**"
    },
    {
      "id": "109e443741c04dd6",
      "type": "text",
      "x": -359,
      "y": -1270,
      "width": 220,
      "height": 80,
      "text": "**Partial Autocorrelation Function**"
    },
    {
      "id": "76caf358404749fe",
      "type": "text",
      "x": -109,
      "y": -1270,
      "width": 220,
      "height": 80,
      "text": "**payoffs**"
    },
    {
      "id": "5bf10f7330844ef3",
      "type": "text",
      "x": 141,
      "y": -1270,
      "width": 220,
      "height": 80,
      "text": "**Q Test**"
    },
    {
      "id": "d221d5cae7624b9e",
      "type": "text",
      "x": -359,
      "y": -1160,
      "width": 220,
      "height": 80,
      "text": "**Times Interest Earned Ratio**"
    },
    {
      "id": "8e59328ed6ac49f0",
      "type": "text",
      "x": -109,
      "y": -1160,
      "width": 220,
      "height": 80,
      "text": "**Common Resources**"
    },
    {
      "id": "e6f3e85fc5964c7e",
      "type": "text",
      "x": 141,
      "y": -1160,
      "width": 220,
      "height": 80,
      "text": "**derivative**"
    },
    {
      "id": "6d763bd693814fac",
      "type": "text",
      "x": -359,
      "y": -1050,
      "width": 220,
      "height": 80,
      "text": "**Derivative (2)**"
    },
    {
      "id": "302bee811dd445e0",
      "type": "text",
      "x": -109,
      "y": -1050,
      "width": 220,
      "height": 80,
      "text": "**Differential Equation**"
    },
    {
      "id": "ef5dff12edec485b",
      "type": "text",
      "x": 141,
      "y": -1050,
      "width": 220,
      "height": 80,
      "text": "**First Difference**"
    },
    {
      "id": "636ed1a795ae4d46",
      "type": "text",
      "x": -359,
      "y": -940,
      "width": 220,
      "height": 80,
      "text": "**Matrix Rank**"
    },
    {
      "id": "6da661b2d24a421e",
      "type": "text",
      "x": -109,
      "y": -940,
      "width": 220,
      "height": 80,
      "text": "**Model Misspecification**"
    },
    {
      "id": "9ae53bb2de2c4ee8",
      "type": "text",
      "x": 141,
      "y": -940,
      "width": 220,
      "height": 80,
      "text": "**Property Rights**"
    },
    {
      "id": "9ee28afa294a46f1",
      "type": "text",
      "x": -359,
      "y": -830,
      "width": 220,
      "height": 80,
      "text": "**Risk Structure of Interest Rates**"
    },
    {
      "id": "94877a2291134300",
      "type": "text",
      "x": -109,
      "y": -830,
      "width": 220,
      "height": 80,
      "text": "**Risk-free Rate**"
    },
    {
      "id": "7bd5a10500124f89",
      "type": "text",
      "x": 141,
      "y": -830,
      "width": 220,
      "height": 80,
      "text": "**Series**"
    },
    {
      "id": "3d3e5ecf878c4fc2",
      "type": "text",
      "x": -359,
      "y": -720,
      "width": 220,
      "height": 80,
      "text": "**Solow-Swan Model**"
    },
    {
      "id": "89e801e1b0464558",
      "type": "text",
      "x": -109,
      "y": -720,
      "width": 220,
      "height": 80,
      "text": "**Sustainable Growth Rate**"
    },
    {
      "id": "c62d37656b39465b",
      "type": "text",
      "x": 141,
      "y": -720,
      "width": 220,
      "height": 80,
      "text": "**t Test**"
    },
    {
      "id": "535a1436123d491a",
      "type": "group",
      "x": 6904,
      "y": -4682,
      "width": 800,
      "height": 930,
      "label": "framework",
      "color": "3"
    },
    {
      "id": "11fa527c815641cf",
      "type": "text",
      "x": 6944,
      "y": -4642,
      "width": 220,
      "height": 80,
      "text": "**Lewis Dual Sector Model**"
    },
    {
      "id": "18771234c57b48b3",
      "type": "text",
      "x": 7194,
      "y": -4642,
      "width": 220,
      "height": 80,
      "text": "**Growth Theory**"
    },
    {
      "id": "41d7cfe385754405",
      "type": "text",
      "x": 7444,
      "y": -4642,
      "width": 220,
      "height": 80,
      "text": "****1. 1. 刘易斯模型的基本思路****"
    },
    {
      "id": "d6d13b560f8748f8",
      "type": "text",
      "x": 6944,
      "y": -4532,
      "width": 220,
      "height": 80,
      "text": "**2 模型内容**"
    },
    {
      "id": "8d4e06a018ae4723",
      "type": "text",
      "x": 7194,
      "y": -4532,
      "width": 220,
      "height": 80,
      "text": "**Fei-Ranis Model**"
    },
    {
      "id": "c2b08f3d985d4aa9",
      "type": "text",
      "x": 7444,
      "y": -4532,
      "width": 220,
      "height": 80,
      "text": "**Todaro Migration Model**"
    },
    {
      "id": "0b6b15e3d63d46f0",
      "type": "text",
      "x": 6944,
      "y": -4422,
      "width": 220,
      "height": 80,
      "text": "**Kuznets Modern Economic Growth Theory**"
    },
    {
      "id": "26225285754a493a",
      "type": "text",
      "x": 7194,
      "y": -4422,
      "width": 220,
      "height": 80,
      "text": "**1. 刘易斯模型的基本思路**"
    },
    {
      "id": "9c950f54e5fa419b",
      "type": "text",
      "x": 7444,
      "y": -4422,
      "width": 220,
      "height": 80,
      "text": "**Solow Model**"
    },
    {
      "id": "7a39cef91ed04a9b",
      "type": "text",
      "x": 6944,
      "y": -4312,
      "width": 220,
      "height": 80,
      "text": "**(1)刘易斯模型**"
    },
    {
      "id": "5ec279ed31dd4699",
      "type": "text",
      "x": 7194,
      "y": -4312,
      "width": 220,
      "height": 80,
      "text": "**(2)中国的消费为什么跟不上**"
    },
    {
      "id": "cdbed5ad07544c93",
      "type": "text",
      "x": 7444,
      "y": -4312,
      "width": 220,
      "height": 80,
      "text": "**(5)为什么会发生贫穷**"
    },
    {
      "id": "6d2bf6bf76b14a9d",
      "type": "text",
      "x": 6944,
      "y": -4202,
      "width": 220,
      "height": 80,
      "text": "**3 模型的稳态分析**"
    },
    {
      "id": "cbf1b03756304029",
      "type": "text",
      "x": 7194,
      "y": -4202,
      "width": 220,
      "height": 80,
