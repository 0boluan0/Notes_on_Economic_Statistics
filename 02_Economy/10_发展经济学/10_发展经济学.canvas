      "type": "text",
      "x": 141,
      "y": -4680,
      "width": 220,
      "height": 80,
      "text": "**点$A$**"
    },
    {
      "id": "2a9d227ee9ec4012",
      "type": "text",
      "x": -359,
      "y": -4570,
      "width": 220,
      "height": 80,
      "text": "**点$B$**"
    },
