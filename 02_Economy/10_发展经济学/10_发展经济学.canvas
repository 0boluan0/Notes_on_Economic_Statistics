      "id": "5e832600ee084790",
      "type": "text",
      "x": -109,
      "y": -5229,
      "width": 220,
      "height": 80,
      "text": "**有效政府**"
    },
    {
      "id": "613c1590680f47f9",
      "type": "text",
      "x": 141,
      "y": -5229,
      "width": 220,
      "height": 80,
      "text": "**有进有退、动态优化**"
    },
