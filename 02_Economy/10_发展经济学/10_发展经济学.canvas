    },
    {
      "id": "56c3fbb1f8574acb",
      "type": "text",
      "x": 7444,
      "y": -4202,
      "width": 220,
      "height": 80,
      "text": "**3 模型解释**"
    },
    {
      "id": "76dc67a4a4cd41eb",
      "type": "text",
      "x": 6944,
      "y": -4092,
      "width": 220,
      "height": 80,
      "text": "**为什么从农业进入工业,经济可以实现快速的增长**"
    },
    {
      "id": "453f3daea6a14f87",
      "type": "text",
      "x": 7194,
      "y": -4092,
      "width": 220,
      "height": 80,
      "text": "**为什么从工业进入服务业,发达国家的经济增长都下降**"
    },
    {
      "id": "5dd8fa5004564c7c",
      "type": "text",
      "x": 7444,
      "y": -4092,
      "width": 220,
      "height": 80,
