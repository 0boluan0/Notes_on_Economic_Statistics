      "id": "0105a1bec64a4edd",
      "type": "text",
      "x": -359,
      "y": -4459,
      "width": 220,
      "height": 80,
      "text": "**现代意义**"
    },
    {
      "id": "6dc508327a95407f",
      "type": "text",
      "x": -109,
      "y": -4459,
      "width": 220,
      "height": 80,
      "text": "**生产具有规模报酬不变**"
    },
    {
      "id": "3befa64494564d81",
      "type": "text",
      "x": 141,
      "y": -4459,
      "width": 220,
      "height": 80,
      "text": "**生产率高速增长**"
    },
    {
      "id": "3ae9d829830147fd",
      "type": "text",
      "x": -359,
      "y": -4349,
      "width": 220,
      "height": 80,
      "text": "**用一个小例子来理解**"
    },
    {
      "id": "777297d78ba14e2c",
      "type": "text",
      "x": -109,
      "y": -4349,
      "width": 220,
      "height": 80,
      "text": "**直观解释：**"
    },
    {
      "id": "eee6b17857be4b53",
      "type": "text",
      "x": 141,
      "y": -4349,
      "width": 220,
      "height": 80,
      "text": "**社会、政治和意识形态快速变革**"
    },
    {
      "id": "36859e593742469c",
      "type": "text",
      "x": -359,
      "y": -4239,
      "width": 220,
      "height": 80,
      "text": "**社会储蓄函数**"
    },
    {
      "id": "1a26fb76984c4aba",
      "type": "text",
      "x": -109,
      "y": -4239,
      "width": 220,
      "height": 80,
      "text": "**税收减免**"
    },
    {
      "id": "12bcd82b6cb44ffd",
      "type": "text",
      "x": 141,
      "y": -4239,
      "width": 220,
      "height": 80,
      "text": "**第一段水平**"
