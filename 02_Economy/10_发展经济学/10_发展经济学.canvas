      "id": "db6c114e26754432",
      "type": "text",
      "x": -359,
      "y": -3910,
      "width": 220,
      "height": 80,
      "text": "**经济弹性**"
    },
    {
      "id": "354c8e68b9a04303",
      "type": "text",
      "x": -109,
      "y": -3910,
      "width": 220,
      "height": 80,
      "text": "**经济成熟的标志**"
    },
    {
      "id": "846ca0a6a5ff41a7",
      "type": "text",
      "x": 141,
      "y": -3910,
      "width": 220,
      "height": 80,
      "text": "**经济是封闭的**"
    },
