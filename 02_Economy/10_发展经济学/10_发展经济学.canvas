      "id": "64d6be8a37914f3b",
      "type": "text",
      "x": -109,
      "y": -3800,
      "width": 220,
      "height": 80,
      "text": "**经济结构快速变革**"
    },
    {
      "id": "d9fa1509247a4ac3",
      "type": "text",
      "x": 141,
      "y": -3800,
      "width": 220,
      "height": 80,
      "text": "**经济适应与区域合作：**"
    },
