      "id": "cc10f6f7d7d340d3",
      "type": "text",
      "x": 141,
      "y": -4130,
      "width": 220,
      "height": 80,
      "text": "**纵轴：人口增长率**"
    },
    {
      "id": "63307f9892724926",
      "type": "text",
      "x": -359,
      "y": -4020,
      "width": 220,
      "height": 80,
      "text": "**纵轴：工资 or 边际产出**"
