      "id": "9563ef3fe2e9420c",
      "type": "text",
      "x": -359,
      "y": -4240,
      "width": 220,
      "height": 80,
      "text": "**税收减免**"
    },
    {
      "id": "e520a578a2494850",
      "type": "text",
      "x": -109,
      "y": -4240,
      "width": 220,
      "height": 80,
      "text": "**第一段水平**"
    },
    {
      "id": "fb3213cc4f124500",
      "type": "text",
      "x": 141,
      "y": -4240,
      "width": 220,
      "height": 80,
      "text": "**第二段水平**"
    },
