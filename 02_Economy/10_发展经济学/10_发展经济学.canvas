      "id": "1730c11972f6402b",
      "type": "text",
      "x": 141,
      "y": -5670,
      "width": 220,
      "height": 80,
      "text": "**扩大报复**"
    },
    {
      "id": "42f143f25bb54f8a",
      "type": "text",
      "x": -359,
      "y": -5560,
      "width": 220,
      "height": 80,
      "text": "**技术水平**"
    },
