		{"id":"038cc565130b095c","fromNode":"724b60458a22773a","toNode":"e47c40e84d82c06d","fromSide":"right","toSide":"left","toEnd":"arrow","label":"课程首页提供连续阅读路径"},
		{"id":"71b260ff257fbd0c","fromNode":"5e20985feed7e569","fromSide":"right","toNode":"65104b201d7560ad","toSide":"left","toEnd":"arrow","label":"先建立基础语义，再进入内存模型"}
	]
}
