    {"id":"63e0000000000025","fromNode":"6300000000000119","fromSide":"right","toNode":"6300000000000120","toSide":"left","label":"纯策略失败后用分布制造无差异"},
    {"id":"63e0000000000026","fromNode":"6300000000000121","fromSide":"right","toNode":"6300000000000122","toSide":"left","label":"代入跟随者反应后倒推"},
