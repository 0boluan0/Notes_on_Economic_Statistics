    {"id":"63e0000000000017","fromNode":"6300000000000110","fromSide":"right","toNode":"6300000000000111","toSide":"left","label":"给定需求后求内点最优"},
    {"id":"63e0000000000018","fromNode":"6300000000000111","fromSide":"right","toNode":"6300000000000112","toSide":"left","label":"联立反应并比较全局角点"},
    {"id":"63e0000000000019","fromNode":"6300000000000113","fromSide":"right","toNode":"6300000000000114","toSide":"left","label":"从单值反应斜率回到收益差异"},
    {"id":"63e0000000000020","fromNode":"6300000000000115","fromSide":"right","toNode":"6300000000000116","toSide":"left","label":"固定对手投入后求完整反应"},
    {"id":"63e0000000000021","fromNode":"6300000000000116","fromSide":"right","toNode":"6300000000000117","toSide":"left","label":"两条正投入反应唯一相交"},
    {"id":"63e0000000000022","fromNode":"6300000000000116","fromSide":"top","toNode":"6300000000000114","toSide":"bottom","label":"先升后降排除单一全局标签"},
