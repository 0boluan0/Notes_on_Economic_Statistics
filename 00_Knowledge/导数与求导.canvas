		{"id":"e16","fromNode":"implicit","toNode":"inverse","fromSide":"right","toSide":"left","label":"反函数是隐式特例"},
		{"id":"e17","fromNode":"inverse","toNode":"inverse-trig","fromSide":"right","toSide":"left","label":"倒数斜率加主值分支"},
		{"id":"e18","fromNode":"trig-derivative","toNode":"inverse-trig","fromSide":"bottom","toSide":"top","label":"原三角导数"},
		{"id":"e19","fromNode":"exponential","toNode":"natural-exp","fromSide":"right","toSide":"left","label":"把比例斜率标准化为一"},
		{"id":"e20","fromNode":"natural-exp","toNode":"natural-log","fromSide":"right","toSide":"left","label":"互为反函数"},
		{"id":"e21","fromNode":"inverse","toNode":"natural-log","fromSide":"bottom","toSide":"top","label":"反函数导数给 $1/x$"},
		{"id":"e22","fromNode":"natural-log","toNode":"exp-derivative","fromSide":"right","toSide":"left","label":"换写为 $e^{x\\ln a}$"},
		{"id":"e23","fromNode":"natural-log","toNode":"log-derivative","fromSide":"bottom","toSide":"top","label":"对 $e^y=x$ 求导"},
		{"id":"e24","fromNode":"log-derivative","toNode":"log-diff","fromSide":"right","toSide":"left","label":"利用 $D\\ln y=y'/y$"},
		{"id":"e25","fromNode":"exp-derivative","toNode":"real-power","fromSide":"bottom","toSide":"top","label":"写成 $e^{r\\ln x}$"},
		{"id":"e26","fromNode":"log-diff","toNode":"real-power","fromSide":"bottom","toSide":"top","label":"固定指数的统一证明"},
		{"id":"e27","fromNode":"natural-exp","toNode":"e-limit","fromSide":"bottom","toSide":"top","label":"同一常数的序列刻画"},
		{"id":"e28","fromNode":"log-derivative","toNode":"e-limit","fromSide":"bottom","toSide":"top","label":"识别 $\\ln$ 在一处差商"},
		{"id":"e29","fromNode":"natural-exp","toNode":"hyperbolic","fromSide":"bottom","toSide":"top","label":"增长与衰减配对"},
		{"id":"e30","fromNode":"hyperbolic","toNode":"hyperbolic-derivative","fromSide":"right","toSide":"left","label":"按指数定义逐项求导"},
