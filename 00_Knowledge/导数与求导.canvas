      "fromSide": "right",
      "toSide": "left",
      "label": "把比例斜率标准化为一"
    },
    {
      "id": "e20",
      "fromNode": "natural-exp",
      "toNode": "natural-log",
      "fromSide": "right",
      "toSide": "left",
      "label": "Inverse functions · 互为反函数"
    },
    {
      "id": "e21",
      "fromNode": "inverse",
      "toNode": "log-derivative",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "Inverse rule gives log derivative · 反函数法则给出对数导数"
    },
    {
      "id": "e22",
      "fromNode": "natural-log",
      "toNode": "exp-derivative",
      "fromSide": "right",
      "toSide": "left",
      "label": "换写为 $e^{x\\ln a}$"
    },
    {
      "id": "e23",
      "fromNode": "natural-log",
      "toNode": "log-derivative",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "对 $e^y=x$ 求导"
    },
    {
      "id": "e24",
      "fromNode": "log-derivative",
      "toNode": "log-diff",
      "fromSide": "right",
      "toSide": "left",
      "label": "For differentiable $y\\ne0$, $D\\ln|y|=y'/y$ · 非零区间"
    },
    {
      "id": "e25",
      "fromNode": "exp-derivative",
      "toNode": "real-power",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "写成 $e^{r\\ln x}$"
    },
    {
      "id": "e26",
      "fromNode": "log-diff",
      "toNode": "real-power",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "固定指数的统一证明"
    },
    {
      "id": "e27",
      "fromNode": "natural-exp",
      "toNode": "e-limit",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "A sequence characterization of the same e · 同一常数的数列刻画"
    },
    {
      "id": "e28",
