		{"id":"e016","fromNode":"ur-015","fromSide":"bottom","toNode":"ur-016","toSide":"top","toEnd":"arrow","label":"由模型构造统计量"},
		{"id":"e019","fromNode":"ur-016","fromSide":"bottom","toNode":"ur-017","toSide":"top","toEnd":"arrow","label":"平稳侧证据"},
		{"id":"e021","fromNode":"ur-018","fromSide":"bottom","toNode":"ur-019","toSide":"top","toEnd":"arrow","label":"断点选择改变分布"},
		{"id":"e022","fromNode":"ur-017","fromSide":"right","toNode":"ur-019","toSide":"left","toEnd":"arrow","label":"冲突证据时检查断点"},
