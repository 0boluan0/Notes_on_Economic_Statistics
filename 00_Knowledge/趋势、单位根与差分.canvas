		{"id":"e027","fromNode":"ur-008","fromSide":"right","toNode":"ur-021","toSide":"left","toEnd":"arrow","label":"限制过度变换"},
		{"id":"e028","fromNode":"ur-021","fromSide":"right","toNode":"ur-022","toSide":"left","toEnd":"arrow","label":"长期关系需要保留水平"},
		{"id":"e029","fromNode":"ur-003","fromSide":"right","toNode":"ur-023","toSide":"left","toEnd":"arrow","label":"向前递推得到预测"},
