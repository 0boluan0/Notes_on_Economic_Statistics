		{"id":"edge-13","fromNode":"arma-011","fromSide":"right","toNode":"arma-009","toSide":"left","toEnd":"arrow","label":"ARMA 是纯非确定表示的有理特例"},
		{"id":"edge-14","fromNode":"arma-026","fromSide":"right","toNode":"arma-012","toSide":"left","toEnd":"arrow","label":"与 ACF 共同提出阶数候选"},
		{"id":"edge-15","fromNode":"arma-009","fromSide":"bottom","toNode":"arma-012","toSide":"top","toEnd":"arrow","label":"冲击响应塑造相关形状"},
		{"id":"edge-16","fromNode":"arma-012","fromSide":"right","toNode":"arma-015","toSide":"left","toEnd":"arrow","label":"只负责提出候选"},
		{"id":"edge-17","fromNode":"arma-015","fromSide":"right","toNode":"arma-014","toSide":"left","toEnd":"arrow","label":"按明确初值与 likelihood 估计"},
		{"id":"edge-18","fromNode":"arma-014","fromSide":"right","toNode":"arma-016","toSide":"left","toEnd":"arrow","label":"在可比拟合间计算"},
		{"id":"edge-19","fromNode":"arma-015","fromSide":"bottom","toNode":"arma-018","toSide":"top","toEnd":"arrow","label":"估计后必须诊断"},
