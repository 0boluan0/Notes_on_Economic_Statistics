		{"id":"edge-r03","fromNode":"rec-coherence","fromSide":"right","toNode":"rec-definition","toSide":"left","label":"独立建模后映射回集合"},
		{"id":"edge-r04","fromNode":"rec-definition","fromSide":"right","toNode":"rec-single","toSide":"left","label":"只采用某一层级"},
		{"id":"edge-r05","fromNode":"rec-definition","fromSide":"bottom","toNode":"rec-mint","toSide":"top","label":"改为利用所有层级"},
		{"id":"edge-r06","fromNode":"comb-cov","fromSide":"bottom","toNode":"rec-mint","toSide":"top","label":"误差协方差进入协调权重"},
		{"id":"edge-r07","fromNode":"rec-mint","fromSide":"right","toNode":"rec-cov-boundary","toSide":"left","label":"实际必须估计 W_h"},
		{"id":"edge-r08","fromNode":"rec-single","fromSide":"bottom","toNode":"rec-accuracy","toSide":"top","label":"相干后仍需检验"},
		{"id":"edge-r09","fromNode":"rec-cov-boundary","fromSide":"right","toNode":"rec-accuracy","toSide":"left","label":"估计误差可抵消理论收益"},
		{"id":"edge-r10","fromNode":"rec-accuracy","fromSide":"bottom","toNode":"rec-evaluate","toSide":"top","label":"逐层逐 horizon 比较"},
		{"id":"edge-r11","fromNode":"comb-validate","fromSide":"bottom","toNode":"rec-evaluate","toSide":"top","label":"共同沿时间重放"},
