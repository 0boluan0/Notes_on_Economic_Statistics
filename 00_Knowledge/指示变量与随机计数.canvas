      "toNode": "random-count",
      "toSide": "bottom",
      "toEnd": "arrow",
      "label": "有限和无需独立"
    },
    {
      "id": "e05",
      "fromNode": "random-count",
      "fromSide": "bottom",
      "toNode": "binomial-boundary",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "再核验同 p 与相互独立"
    },
    {
      "id": "e06",
      "fromNode": "indicator-definition",
      "fromSide": "bottom",
      "toNode": "complement",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "逻辑非"
    },
    {
      "id": "e07",
      "fromNode": "indicator-definition",
      "fromSide": "bottom",
      "toNode": "intersection",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "逻辑交"
    },
    {
      "id": "e08",
      "fromNode": "intersection",
      "fromSide": "bottom",
      "toNode": "union",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "修正并事件的重复计数"
    },
    {
      "id": "e09",
      "fromNode": "intersection",
      "fromSide": "right",
      "toNode": "indicator-covariance",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "取期望并扣除独立基准"
    },
    {
      "id": "e10",
      "fromNode": "indicator-covariance",
      "fromSide": "right",
      "toNode": "shared-index-boundary",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "联合机制决定符号"
    },
    {
      "id": "e11",
      "fromNode": "indicator-covariance",
      "fromSide": "bottom",
      "toNode": "variance-sum",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "代入随机和方差"
    },
    {
      "id": "e12",
      "fromNode": "indicator-covariance",
      "fromSide": "bottom",
      "toNode": "zero-covariance-boundary",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "对照一般零协方差边界"
    }
  ]
}
