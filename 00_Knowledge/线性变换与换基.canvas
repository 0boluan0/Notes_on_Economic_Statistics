      "fromNode": "basis-images",
      "fromSide": "right",
      "toNode": "matrix-columns",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "把基像写成列"
    },
    {
      "id": "e04",
      "fromNode": "matrix-columns",
      "fromSide": "right",
      "toNode": "basis-direction",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "读列判断坐标方向"
    },
    {
      "id": "e05",
      "fromNode": "basis-direction",
      "fromSide": "right",
      "toNode": "general-basis-change",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "两端分别换基"
    },
    {
      "id": "e06",
      "fromNode": "general-basis-change",
      "fromSide": "right",
      "toNode": "similarity",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "同一空间同一换基时化为相似"
    },
    {
      "id": "e07",
      "fromNode": "matrix-columns",
      "fromSide": "bottom",
      "toNode": "composition",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "复合仍可用矩阵表示"
    },
    {
      "id": "e08",
      "fromNode": "basis-images",
      "fromSide": "bottom",
      "toNode": "dependent-images",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "换成相关集时先保关系"
    },
    {
      "id": "e09",
      "fromNode": "basis-images",
      "fromSide": "bottom",
      "toNode": "nonspanning-images",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "不张成时失去唯一性"
    },
    {
      "id": "e10",
      "fromNode": "basis-direction",
      "fromSide": "bottom",
      "toNode": "orthonormal-change",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "标准正交基使逆等于转置或共轭转置"
    }
  ]
}
