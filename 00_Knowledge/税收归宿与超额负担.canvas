      "toNode": "taxi000000000009",
      "toSide": "left",
      "label": "定义社会损失"
    },
    {
      "id": "taxie0000000008",
      "fromNode": "taxi000000000009",
      "fromSide": "right",
      "toNode": "taxi00000000000a",
      "toSide": "left",
      "label": "在小税下局部近似"
    },
    {
      "id": "taxie0000000009",
      "fromNode": "taxi00000000000a",
      "fromSide": "right",
      "toNode": "taxi00000000000b",
      "toSide": "left",
      "label": "提供边际效率成本"
    },
