		{"id":"mx-e13","fromNode":"mx-009","fromSide":"bottom","toNode":"mx-021","toSide":"top","label":"解释价值增量的来源"},
		{"id":"mx-e14","fromNode":"mx-013","fromSide":"left","toNode":"mx-015","toSide":"right","label":"耗用旧值转入"},
		{"id":"mx-e15","fromNode":"mx-015","fromSide":"left","toNode":"mx-021","toSide":"right","label":"核算价值增量"},
		{"id":"mx-e16","fromNode":"mx-011","fromSide":"bottom","toNode":"mx-014","toSide":"top","label":"按价值购买所用资本"},
		{"id":"mx-e17","fromNode":"mx-016","fromSide":"bottom","toNode":"mx-017","toSide":"top","label":"工作日延续至必要以外"},
		{"id":"mx-e18","fromNode":"mx-014","fromSide":"bottom","toNode":"mx-019","toSide":"top","label":"活劳动新价值超过等价物"},
		{"id":"mx-e19","fromNode":"mx-017","fromSide":"bottom","toNode":"mx-018","toSide":"top","label":"先辨清时间分割的判据"},
		{"id":"mx-e20","fromNode":"mx-021","fromSide":"bottom","toNode":"mx-020","toSide":"top","label":"用剩余与可变资本相比"},
		{"id":"mx-e21","fromNode":"mx-022","fromSide":"left","toNode":"mx-020","toSide":"right","label":"延时提高比率"},
		{"id":"mx-e22","fromNode":"mx-022","fromSide":"right","toNode":"mx-023","toSide":"left","label":"改变控制条件"},
		{"id":"mx-e23","fromNode":"mx-023","fromSide":"right","toNode":"mx-019","toSide":"left","label":"同日扩大剩余"},
		{"id":"mx-e24","fromNode":"mx-024","fromSide":"right","toNode":"mx-025","toSide":"left","label":"追加要素须可得"},
		{"id":"mx-e25","fromNode":"mx-025","fromSide":"right","toNode":"mx-026","toSide":"left","label":"再问要素怎样组合"},
		{"id":"mx-e26","fromNode":"mx-026","fromSide":"right","toNode":"mx-027","toSide":"left","label":"还须按价值计量"},
		{"id":"mx-e27","fromNode":"mx-026","fromSide":"bottom","toNode":"mx-028","toSide":"top","label":"技术关系进入价值构成"},
		{"id":"mx-e28","fromNode":"mx-027","fromSide":"bottom","toNode":"mx-measure","toSide":"top","label":"为回报比较统一口径"},
		{"id":"mx-e29","fromNode":"mx-028","fromSide":"left","toNode":"mx-029","toSide":"right","label":"另算可变部分总量"},
		{"id":"mx-e30","fromNode":"mx-029","fromSide":"left","toNode":"mx-030","toSide":"right","label":"吸收与排斥劳动"},
		{"id":"mx-e31","fromNode":"mx-024","fromSide":"bottom","toNode":"mx-030","toSide":"top","label":"扩张与技术更新影响就业"},
		{"id":"mx-e32","fromNode":"mx-031","fromSide":"right","toNode":"mx-037","toSide":"left","label":"与增殖分类分开"},
		{"id":"mx-e33","fromNode":"mx-037","fromSide":"right","toNode":"mx-032","toSide":"left","label":"再核对计量期间"},
		{"id":"mx-e34","fromNode":"mx-032","fromSide":"right","toNode":"mx-033","toSide":"left","label":"分母取预付总额"},
		{"id":"mx-e35","fromNode":"mx-033","fromSide":"bottom","toNode":"mx-034","toSide":"top","label":"固定剩余率进行比较"},
		{"id":"mx-e36","fromNode":"mx-034","fromSide":"left","toNode":"mx-035","toSide":"right","label":"放开条件看反作用"},
		{"id":"mx-e37","fromNode":"mx-035","fromSide":"left","toNode":"mx-036","toSide":"right","label":"另分清率与量"},
		{"id":"mx-e38","fromNode":"mx-036","fromSide":"left","toNode":"mx-return","toSide":"right","label":"再投金额与用途"}
	]
