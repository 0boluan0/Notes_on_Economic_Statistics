		{"id":"d7b0000000000006","fromNode":"d7a0000000000003","fromSide":"bottom","toNode":"d7a0000000000015","toSide":"top","toEnd":"arrow","label":"Column nonzeros\n列非零数"},
		{"id":"d7b0000000000007","fromNode":"d7a0000000000015","fromSide":"right","toNode":"d7a0000000000016","toSide":"left","toEnd":"arrow","label":"AᵀC"},
		{"id":"d7b0000000000008","fromNode":"d7a0000000000007","fromSide":"right","toNode":"d7a0000000000008","toSide":"left","toEnd":"arrow","label":"Erase\n删闭段"},
		{"id":"d7b0000000000009","fromNode":"d7a0000000000008","fromSide":"right","toNode":"d7a0000000000009","toSide":"left","toEnd":"arrow","label":"Min edges\n最少边"},
		{"id":"d7b000000000000a","fromNode":"d7a0000000000009","fromSide":"right","toNode":"d7a000000000000a","toSide":"left","toEnd":"arrow","label":"Classes\n等价类"},
		{"id":"d7b000000000000b","fromNode":"d7a000000000000a","fromSide":"right","toNode":"d7a000000000000b","toSide":"left","toEnd":"arrow","label":"Strong /\nweak\n强弱"},
		{"id":"d7b000000000000c","fromNode":"d7a0000000000009","fromSide":"bottom","toNode":"d7a000000000000c","toSide":"top","toEnd":"arrow","label":"Search · 搜索"},
		{"id":"d7b000000000000d","fromNode":"d7a000000000000c","fromSide":"right","toNode":"d7a000000000000d","toSide":"left","toEnd":"arrow","label":"One scan\n单次扫描"},
		{"id":"d7b000000000000e","fromNode":"d7a000000000000c","fromSide":"bottom","toNode":"d7a000000000000e","toSide":"top","toEnd":"arrow","label":"FIFO"},
		{"id":"d7b000000000000f","fromNode":"d7a000000000000e","fromSide":"right","toNode":"d7a000000000000f","toSide":"left","toEnd":"arrow","label":"Parent\n父记录"},
		{"id":"d7b0000000000010","fromNode":"d7a000000000000c","fromSide":"bottom","toNode":"d7a0000000000010","toSide":"top","toEnd":"arrow","label":"Call frames · 递归栈帧"},
		{"id":"d7b0000000000011","fromNode":"d7a0000000000010","fromSide":"right","toNode":"d7a0000000000011","toSide":"left","toEnd":"arrow","label":"Active\n活动链"},
		{"id":"d7b0000000000012","fromNode":"d7a0000000000011","fromSide":"right","toNode":"d7a0000000000012","toSide":"left","toEnd":"arrow","label":"Parent\n父边"},
		{"id":"d7b0000000000013","fromNode":"d7a0000000000012","fromSide":"bottom","toNode":"d7a0000000000013","toSide":"top","toEnd":"arrow","label":"Restart · 重启"},
		{"id":"d7b0000000000015","fromNode":"d7a0000000000007","fromSide":"top","toNode":"d7a0000000000006","toSide":"bottom","toEnd":"arrow","label":"Walks · 游走"},
		{"id":"d7b0000000000016","fromNode":"d7a000000000000a","fromSide":"top","toNode":"d7a0000000000015","toSide":"bottom","toEnd":"arrow","label":"分量数决定关联矩阵的核维数"},
		{"id":"u1-close-inc-forest","fromNode":"d7a0000000000015","fromSide":"bottom","toNode":"u1-close-forest","toSide":"top","toEnd":"arrow","label":"Row independence selects a forest · 行独立选出森林"},
		{"id":"u1-close-inc-flow","fromNode":"d7a0000000000015","fromSide":"bottom","toNode":"u1-close-cycles","toSide":"top","toEnd":"arrow","label":"Transpose computes node balance · 转置计算节点净流入"},
		{"id":"u1-close-forest-flow","fromNode":"u1-close-forest","fromSide":"bottom","toNode":"u1-close-cycles","toSide":"bottom","toEnd":"arrow","label":"Each edge outside a spanning forest gives a basis cycle\n生成森林外每条边给一个基环"}
	]
}