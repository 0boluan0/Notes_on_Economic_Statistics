		{"id":"b8e000000000000f","fromNode":"b81000000000000c","fromSide":"right","toNode":"b81000000000000d","toSide":"left","toEnd":"arrow","label":"唯一且非空的行身份"},
		{"id":"b8e0000000000010","fromNode":"b81000000000000d","fromSide":"right","toNode":"b81000000000000e","toSide":"left","toEnd":"arrow","label":"引用候选唯一键"},
		{"id":"b8e0000000000011","fromNode":"b81000000000000e","fromSide":"right","toNode":"b81000000000000f","toSide":"left","toEnd":"none","label":"参照存在 ≠ 本行表达式"},
		{"id":"b8e0000000000013","fromNode":"b81000000000000f","fromSide":"right","toNode":"b810000000000010","toSide":"left","toEnd":"none","label":"单行表达式 ≠ 跨行唯一"},
		{"id":"b8e0000000000014","fromNode":"b810000000000010","fromSide":"bottom","toNode":"b810000000000011","toSide":"top","toEnd":"arrow","label":"unique B-tree 兼顾判重与访问"},
