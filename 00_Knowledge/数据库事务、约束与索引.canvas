		{"id":"b8e000000000000c","fromNode":"b81000000000000a","fromSide":"bottom","toNode":"b81000000000000b","toSide":"top","toEnd":"arrow","label":"取锁顺序可成循环"},
		{"id":"b8e000000000000d","fromNode":"b810000000000007","fromSide":"right","toNode":"b81000000000000b","toSide":"left","toEnd":"none","label":"成因不同，均重跑整事务"},
