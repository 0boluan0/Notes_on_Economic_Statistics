    },
    {
      "id": "c7e3000000000027",
      "fromNode": "c7c100000000001b",
      "fromSide": "right",
      "toNode": "c7b1000000000014",
      "toSide": "left",
      "toEnd": "arrow"
    },
    {
      "id": "c7e3000000000028",
      "fromNode": "c7b1000000000014",
      "fromSide": "right",
      "toNode": "c7c100000000001c",
      "toSide": "left",
      "toEnd": "arrow"
    },
    {
      "id": "c7e300000000000f",
      "fromNode": "c7c100000000000b",
      "fromSide": "right",
      "toNode": "c7b1000000000008",
      "toSide": "left",
      "toEnd": "arrow"
