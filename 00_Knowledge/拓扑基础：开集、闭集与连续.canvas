      "label": "Metric open sets satisfy the topology axioms · 度量开集族满足拓扑公理"
    },
    {
      "id": "topo-edge-topology-closed",
      "fromNode": "topo-topology",
      "fromSide": "right",
      "toNode": "topo-closed",
      "toSide": "left",
      "label": "An open complement defines closedness · 开补集定义闭性"
    },
    {
      "id": "topo-edge-closed-ops",
      "fromNode": "topo-closed",
      "fromSide": "top",
      "toNode": "topo-closed-ops",
      "toSide": "bottom",
      "label": "Complement identities give arbitrary intersections and finite unions · 补集恒等式推出任意交与有限并"
    },
    {
      "id": "topo-edge-topology-subspace",
      "fromNode": "topo-topology",
      "fromSide": "left",
      "toNode": "topo-subspace",
      "toSide": "right",
      "label": "Intersect ambient open sets with the subset · 环境开集与子集取交"
    },
    {
      "id": "topo-edge-topology-interior",
      "fromNode": "topo-topology",
      "fromSide": "top",
      "toNode": "topo-interior",
      "toSide": "bottom",
      "label": "Unite all open subsets contained in the set · 合并集合中的所有开子集"
    },
    {
      "id": "topo-edge-closed-closure",
      "fromNode": "topo-closed",
      "fromSide": "right",
      "toNode": "topo-closure",
      "toSide": "left",
      "label": "Intersect all closed supersets · 相交所有闭超集"
    },
    {
      "id": "topo-edge-interior-boundary",
      "fromNode": "topo-interior",
      "fromSide": "right",
      "toNode": "topo-boundary",
      "toSide": "left",
      "label": "Remove the interior from the closure · 从闭包中去掉内部"
    },
    {
      "id": "topo-edge-closure-boundary",
      "fromNode": "topo-closure",
      "fromSide": "top",
      "toNode": "topo-boundary",
      "toSide": "bottom",
      "label": "Closure minus interior gives the boundary · 闭包减内部得到边界"
    },
    {
      "id": "topo-edge-closure-closure-seq",
      "fromNode": "topo-closure",
      "fromSide": "bottom",
      "toNode": "topo-closure-seq",
      "toSide": "top",
      "label": "Metric spaces: approach closure points by sequences in the set · 度量空间中用集内序列逼近闭包点"
    },
    {
      "id": "topo-edge-closed-closed-seq",
      "fromNode": "topo-closed",
      "fromSide": "bottom",
      "toNode": "topo-closed-seq",
      "toSide": "top",
      "label": "Metric spaces: keep every ambient limit of sequences in the set · 度量空间中保留集内序列的全部环境极限"
    },
    {
      "id": "topo-edge-metric-equivalent",
      "fromNode": "topo-metric",
      "fromSide": "left",
      "toNode": "topo-equivalent-metrics",
      "toSide": "right",
      "label": "Compare the open sets induced by two metrics · 比较两个度量诱导的开集族"
    },
    {
      "id": "topo-edge-metric-sequence",
      "fromNode": "topo-metric",
      "fromSide": "bottom",
      "toNode": "topo-sequence",
      "toSide": "top",
      "label": "A distance bound must hold for every sufficiently late term · 距离界须对所有充分靠后的项成立"
    },
    {
      "id": "topo-edge-sequence-limit-unique",
      "fromNode": "topo-sequence",
      "fromSide": "bottom",
      "toNode": "topo-limit-unique",
      "toSide": "top",
      "label": "Metric separation rules out two distinct limits · 度量分离性排除两个不同极限"
    },
    {
      "id": "topo-edge-sequence-cluster",
      "fromNode": "topo-sequence",
      "fromSide": "bottom",
      "toNode": "topo-cluster-not-limit",
      "toSide": "top",
      "label": "Distinguish arbitrarily late visits from an entire tail · 区分任意晚的访问与整个尾部"
    },
    {
      "id": "topo-edge-sequence-closure-seq",
      "fromNode": "topo-sequence",
      "fromSide": "right",
      "toNode": "topo-closure-seq",
      "toSide": "left",
      "label": "In metric spaces, select points within distance 1/n · 度量空间中从距离小于1/n处逐项选点"
    },
    {
      "id": "topo-edge-sequence-closed-seq",
      "fromNode": "topo-sequence",
      "fromSide": "top",
      "toNode": "topo-closed-seq",
      "toSide": "bottom",
      "label": "Test every sequence with a limit in the ambient space · 检查每条在环境空间中有极限的序列"
    },
    {
      "id": "topo-edge-topology-continuity",
      "fromNode": "topo-topology",
      "fromSide": "bottom",
      "toNode": "topo-continuity",
      "toSide": "top",
      "label": "Pull codomain open sets back to domain open sets · 将陪域开集拉回为定义域开集"
    },
    {
      "id": "topo-edge-continuity-tests",
      "fromNode": "topo-continuity",
      "fromSide": "bottom",
      "toNode": "topo-continuity-tests",
      "toSide": "top",
      "label": "Between metric spaces, four equivalent tests · 度量空间之间的四种等价判据"
    },
    {
      "id": "topo-edge-sequence-continuity-tests",
      "fromNode": "topo-sequence",
      "fromSide": "top",
      "toNode": "topo-continuity-tests",
      "toSide": "bottom",
      "label": "Require preservation of every convergent sequence and its limit · 要求保持每条收敛序列及其极限"
    },
    {
      "id": "topo-edge-topology-compact",
      "fromNode": "topo-topology",
      "fromSide": "bottom",
      "toNode": "topo-compact",
      "toSide": "top",
      "label": "Every open cover must admit a finite subcover · 每个开覆盖都须含有限子覆盖"
    },
    {
      "id": "topo-edge-compact-seq-compact",
      "fromNode": "topo-compact",
      "fromSide": "bottom",
      "toNode": "topo-seq-compact",
      "toSide": "top",
      "label": "Equivalent in metric spaces · 在度量空间中等价"
    },
    {
      "id": "topo-edge-sequence-seq-compact",
      "fromNode": "topo-sequence",
      "fromSide": "top",
      "toNode": "topo-seq-compact",
      "toSide": "bottom",
      "label": "Every sequence needs a subsequence with limit inside the set · 每条序列都须有极限留在集内的子列"
    },
    {
      "id": "topo-edge-compact-heine",
      "fromNode": "topo-compact",
      "fromSide": "right",
      "toNode": "topo-heine",
      "toSide": "left",
      "label": "Usual finite-dimensional Euclidean space: compact iff closed and bounded · 通常有限维欧氏空间中紧致等价于闭且有界"
    },
    {
      "id": "topo-edge-compact-image",
      "fromNode": "topo-compact",
      "fromSide": "bottom",
      "toNode": "topo-compact-image",
      "toSide": "top",
      "label": "Continuous maps preserve compactness of the image · 连续映射保持像的紧致性"
    },
    {
      "id": "topo-edge-continuity-compact-image",
      "fromNode": "topo-continuity",
      "fromSide": "bottom",
      "toNode": "topo-compact-image",
      "toSide": "top",
      "label": "Supplies the continuous-map hypothesis · 提供连续映射这一假设"
    },
    {
      "id": "topo-edge-compact-image-extreme",
      "fromNode": "topo-compact-image",
      "fromSide": "bottom",
      "toNode": "topo-extreme",
      "toSide": "top",
      "label": "Nonempty domain and real-valued continuous map: compact image attains both extremes · 非空定义域且映射连续实值时，紧致像取得两端极值"
    },
    {
      "id": "topo-edge-topology-connected",
      "fromNode": "topo-topology",
      "fromSide": "bottom",
      "toNode": "topo-connected",
      "toSide": "top",
      "label": "Rule out a disjoint nonempty open cover by two sets · 排除两个不交非空开集覆盖全空间"
    },
    {
      "id": "topo-edge-subspace-connected",
      "fromNode": "topo-subspace",
      "fromSide": "bottom",
      "toNode": "topo-connected",
      "toSide": "top",
      "label": "Test a subset using its relative open sets · 用相对开集检验子集的连通性"
    },
    {
      "id": "topo-edge-connected-image",
      "fromNode": "topo-connected",
      "fromSide": "bottom",
      "toNode": "topo-connected-image",
      "toSide": "top",
      "label": "Continuous maps preserve connectedness of the image · 连续映射保持像的连通性"
    },
    {
      "id": "topo-edge-continuity-connected-image",
      "fromNode": "topo-continuity",
      "fromSide": "bottom",
      "toNode": "topo-connected-image",
      "toSide": "top",
      "label": "Supplies the continuous-map hypothesis · 提供连续映射这一假设"
    },
    {
      "id": "topo-edge-connected-real-interval",
      "fromNode": "topo-connected",
      "fromSide": "left",
      "toNode": "topo-real-interval",
      "toSide": "right",
      "label": "Usual real line, nonempty subset: connected iff interval · 通常实线中，非空子集连通当且仅当为区间"
    },
    {
      "id": "topo-edge-connected-image-ivt",
      "fromNode": "topo-connected-image",
      "fromSide": "left",
      "toNode": "topo-ivt",
      "toSide": "right",
      "label": "Continuous real-valued maps on a connected domain have connected image · 连通定义域上的连续实值映射具有连通像"
    },
    {
      "id": "topo-edge-real-interval-ivt",
      "fromNode": "topo-real-interval",
      "fromSide": "bottom",
      "toNode": "topo-ivt",
      "toSide": "top",
      "label": "A connected real image contains every value between two attained values · 连通实像包含两个已取值之间的全部数值"
    },
    {
      "id": "topo-edge-compact-total-bounded",
      "fromNode": "topo-compact",
      "fromSide": "bottom",
      "toNode": "topo-total-bounded",
      "toSide": "top",
      "label": "Metric compactness gives a finite ball cover at every radius · 度量紧致性给出每个半径的有限球覆盖"
    },
    {
      "id": "topo-edge-total-bounded-seq-proof",
      "fromNode": "topo-total-bounded",
      "fromSide": "bottom",
      "toNode": "topo-seq-compact",
      "toSide": "top",
      "label": "Finite ball covers enter the metric proof; alone they do not give compactness · 有限球覆盖用于度量证明，本身不足以推出紧致"
    },
    {
      "id": "topo-edge-supremum-completeness",
      "fromNode": "topo-supremum",
      "fromSide": "right",
      "toNode": "topo-real-completeness",
      "toSide": "left",
      "label": "Separate the definition from existence in the real numbers · 区分最小上界的定义与实数中的存在保证"
    },
    {
      "id": "topo-edge-completeness-heine",
      "fromNode": "topo-real-completeness",
      "fromSide": "top",
      "toNode": "topo-heine",
      "toSide": "bottom",
      "label": "Real completeness supplies points in nested closed coordinate intervals · 实数完备性给出嵌套闭坐标区间的公共点"
    },
    {
      "id": "topo-edge-completeness-real-interval",
      "fromNode": "topo-real-completeness",
      "fromSide": "left",
      "toNode": "topo-real-interval",
      "toSide": "bottom",
      "label": "A supremum rules out a separation of an interval in the usual real line · 上确界排除通常实线区间的分离"
    },
    {
      "id": "topo-edge-completeness-extreme",
      "fromNode": "topo-real-completeness",
      "fromSide": "bottom",
      "toNode": "topo-extreme",
      "toSide": "right",
      "label": "Bounded nonempty real image has a supremum; closedness retains it · 非空有界实像有上确界，闭性保留该值"
    },
    {
      "id": "topo-edge-continuity-compact-uniform",
      "fromNode": "topo-continuity",
      "fromSide": "bottom",
      "toNode": "topo-compact-uniform",
      "toSide": "top",
      "label": "Add a compact metric domain and a metric codomain · 再要求紧致度量定义域与度量陪域"
    },
    {
      "id": "topo-edge-compact-uniform-domain",
      "fromNode": "topo-compact",
      "fromSide": "bottom",
      "toNode": "topo-compact-uniform",
      "toSide": "right",
      "label": "With metrics on both spaces and a continuous map · 两端为度量空间且映射连续"
    },
    {
      "id": "topo-edge-compact-uniform-result",
      "fromNode": "topo-compact-uniform",
      "fromSide": "left",
      "toNode": "topo-uniform-continuity",
      "toSide": "right",
      "label": "Guarantees one tolerance for all input pairs · 保证所有输入对共用一个门槛"
    }
  ]
}
