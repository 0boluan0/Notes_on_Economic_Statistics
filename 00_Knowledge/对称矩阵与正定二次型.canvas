      "fromNode": "n021",
      "fromSide": "right",
      "toNode": "n022",
      "toSide": "left",
      "label": "二次几何成为局部曲率"
    },
    {
      "id": "e-d02",
      "fromNode": "n022",
      "fromSide": "right",
      "toNode": "n029",
      "toSide": "left",
      "label": "失去严格定号后无结论"
    },
    {
      "id": "e-d03",
      "fromNode": "n023",
      "fromSide": "right",
      "toNode": "n035",
      "toSide": "left",
      "label": "零投影方差刻画奇异性"
    },
    {
      "id": "e-x01",
      "fromNode": "n007",
      "fromSide": "right",
      "toNode": "n008",
      "toSide": "left",
      "label": "实对称谱定理是 Hermitian 谱定理的实数情形"
    },
    {
      "id": "e-x02",
      "fromNode": "n008",
      "fromSide": "right",
      "toNode": "n010",
      "toSide": "left",
      "label": "谱坐标把二次型符号化为特征值符号"
    },
    {
      "id": "e-x03",
      "fromNode": "n025",
      "fromSide": "bottom",
      "toNode": "n010",
      "toSide": "top",
      "label": "每个非零方向严格为正定义正定"
    },
    {
      "id": "e-x04",
      "fromNode": "n032",
      "fromSide": "bottom",
      "toNode": "n015",
      "toSide": "right",
      "label": "零方向是半正定的几何边界；全部主子式非负是完整代数判据"
    },
    {
      "id": "e-x05",
      "fromNode": "n016",
      "fromSide": "right",
      "toNode": "n015",
      "toSide": "left",
      "label": "从严格正放宽到非负时不能照搬正定判据"
    },
    {
      "id": "e-x06",
      "fromNode": "n017",
      "fromSide": "bottom",
      "toNode": "n021",
