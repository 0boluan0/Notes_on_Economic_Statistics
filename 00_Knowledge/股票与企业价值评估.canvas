		{"id":"f047100000000014","fromNode":"f047000000000026","fromSide":"bottom","toNode":"f047000000000027","toSide":"top","label":"从母公司权益分配到每股"},
		{"id":"f047100000000015","fromNode":"f047000000000031","fromSide":"right","toNode":"f047000000000032","toSide":"left","label":"增长分配风险"},
		{"id":"f047100000000016","fromNode":"f047000000000033","fromSide":"right","toNode":"f047000000000034","toSide":"left","label":"清洁盈余条件"},
		{"id":"f047100000000017","fromNode":"f047000000000035","fromSide":"right","toNode":"f047000000000036","toSide":"left","label":"比较还需条件"},
		{"id":"f047100000000020","fromNode":"f047000000000040","fromSide":"right","toNode":"f047000000000041","toSide":"left","label":"反求输入"},
		{"id":"f047100000000021","fromNode":"f047000000000041","fromSide":"right","toNode":"f047000000000042","toSide":"left","label":"对照证据"}
	]
}