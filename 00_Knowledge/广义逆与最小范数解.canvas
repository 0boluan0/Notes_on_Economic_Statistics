      "fromSide": "bottom",
      "toNode": "pinv-existence-0007",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "验证四条件并证明唯一性"
    },
    {
      "id": "pinv-edge-0010",
      "fromNode": "pinv-mp-0004",
      "fromSide": "bottom",
      "toNode": "pinv-project-col",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "输出侧得到列空间正交投影"
