      "toSide": "left",
      "toEnd": "arrow",
      "label": "Numerical rank needs a scale and tolerance · 数值秩需声明尺度与容差"
    },
    {
      "id": "pinv-edge-0016",
      "fromNode": "pinv-numrank-0009",
      "fromSide": "right",
      "toNode": "pinv-cpqr-boundary",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "CPQR and SVD use different rank tests · CPQR 与 SVD 的判秩规则不同"
    },
    {
      "id": "pinv-edge-0017",
      "fromNode": "pinv-noise-0005",
      "fromSide": "bottom",
      "toNode": "pinv-ridge-0013",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "A penalty changes the recovery rule · 惩罚项改变恢复规则"
    },
    {
      "id": "pinv-edge-0024",
      "fromNode": "pinv-ridge-0013",
      "fromSide": "bottom",
      "toNode": "pinv-ridge-filter-0017",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "Separate the penalized objective by singular direction · 按奇异方向分开受罚目标"
    },
    {
      "id": "pinv-edge-0018",
      "fromNode": "pinv-numrank-0009",
      "fromSide": "bottom",
      "toNode": "pinv-tsvd-0012",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "Retain only $\\sigma_i>\\tau$ · 按声明阈值硬截断"
    },
    {
      "id": "pinv-edge-0019",
      "fromNode": "pinv-ridge-filter-0017",
      "fromSide": "right",
      "toNode": "pinv-compare-0008",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "Smooth gains shrink each positive direction · 连续增益收缩各正方向"
    },
    {
      "id": "pinv-edge-0020",
      "fromNode": "pinv-tsvd-0012",
      "fromSide": "bottom",
      "toNode": "pinv-compare-0008",
      "toSide": "top",
      "toEnd": "arrow",
