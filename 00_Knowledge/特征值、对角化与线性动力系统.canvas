    {"id":"edge002","fromNode":"eig001","fromSide":"right","toNode":"eig024","toSide":"left","label":"非零解要求行列式为零"},
    {"id":"edge003","fromNode":"eig002","fromSide":"right","toNode":"eig004","toSide":"left","label":"空间维数给几何重数"},
    {"id":"edge005","fromNode":"eig024","fromSide":"right","toNode":"eig003","toSide":"left","label":"根依赖底层域"},
    {"id":"edge006","fromNode":"eig004","fromSide":"bottom","toNode":"eig005","toSide":"top","label":"按代数重数计数"},

