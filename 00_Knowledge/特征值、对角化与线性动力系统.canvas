    {"id":"edge008","fromNode":"eig006","fromSide":"right","toNode":"eig043","toSide":"left","label":"搬运特征空间"},
    {"id":"edge009","fromNode":"eig025","fromSide":"right","toNode":"eig026","toSide":"left","label":"这些信息仍不够"},
    {"id":"edge010","fromNode":"eig043","fromSide":"right","toNode":"eig026","toSide":"left","label":"用几何重数排除同谱候选"},
    {"id":"edge011","fromNode":"eig006","fromSide":"bottom","toNode":"eig028","toSide":"top","label":"相似到对角矩阵"},
    {"id":"edge012","fromNode":"eig028","fromSide":"right","toNode":"eig007","toSide":"left","label":"转化为特征向量基判据"},
    {"id":"edge013","fromNode":"eig007","fromSide":"right","toNode":"eig008","toSide":"left","label":"重根时逐个比较重数"},
    {"id":"edge014","fromNode":"eig007","fromSide":"right","toNode":"eig010","toSide":"left","label":"判定成功后计算矩阵幂"},
    {"id":"edge015","fromNode":"eig028","fromSide":"bottom","toNode":"eig009","toSide":"top","label":"不要混同行操作"},

    {"id":"edge016","fromNode":"eig030","fromSide":"right","toNode":"eig012","toSide":"left","label":"按层级组成链"},
    {"id":"edge017","fromNode":"eig012","fromSide":"right","toNode":"eig031","toSide":"left","label":"一条链对应一个块"},
    {"id":"edge042","fromNode":"eig012","fromSide":"bottom","toNode":"eig045","toSide":"top","label":"递推关系保证线性无关"},
    {"id":"edge018","fromNode":"eig031","fromSide":"right","toNode":"eig033","toSide":"left","label":"各块拼成标准形"},
    {"id":"edge019","fromNode":"eig014","fromSide":"bottom","toNode":"eig034","toSide":"top","label":"存在后块数据除排列外唯一"},
    {"id":"edge020","fromNode":"eig031","fromSide":"bottom","toNode":"eig013","toSide":"top","label":"有限二项展开"},
    {"id":"edge021","fromNode":"eig031","fromSide":"bottom","toNode":"eig032","toSide":"top","label":"幂零部分给出有限项"},
    {"id":"edge022","fromNode":"eig033","fromSide":"right","toNode":"eig014","toSide":"left","label":"先检查所在的域"},
    {"id":"edge023","fromNode":"eig011","fromSide":"left","toNode":"eig029","toSide":"right","label":"可对角化时逐项指数化"},
    {"id":"edge024","fromNode":"eig011","fromSide":"right","toNode":"eig032","toSide":"left","label":"把指数作用到 Jordan 块"},
    {"id":"edge043a","fromNode":"eig011","fromSide":"top","toNode":"bridge-exp-solution","toSide":"top","label":"幂级数定义"},
    {"id":"edge043b","fromNode":"bridge-exp-solution","fromSide":"left","toNode":"eig047","toSide":"left","label":"作用于初值"},
    {"id":"edge025","fromNode":"depSchur","fromSide":"right","toNode":"eig035","toSide":"left","label":"等距换基前提"},
    {"id":"edge037","fromNode":"eig035","fromSide":"right","toNode":"eig044","toSide":"left","label":"定义之外还需存在定理"},
    {"id":"edge038","fromNode":"eig044","fromSide":"right","toNode":"depSVD","toSide":"left","label":"比较前再补 SVD 定义"},
    {"id":"edge039","fromNode":"depSVD","fromSide":"right","toNode":"eig015","toSide":"left","label":"区分三种分解的任务"},

    {"id":"edge026","fromNode":"eig036","fromSide":"right","toNode":"eig016","toSide":"left","label":"全部模态是否衰减"},
    {"id":"edge027","fromNode":"eig016","fromSide":"right","toNode":"eig018","toSide":"left","label":"得到离散渐近稳定"},
    {"id":"edge028","fromNode":"eig018","fromSide":"right","toNode":"eig037","toSide":"left","label":"放宽为只要求有界"},
    {"id":"edge044","fromNode":"eig047","fromSide":"right","toNode":"eig019","toSide":"left","label":"再由谱判断是否衰减"},
    {"id":"edge029","fromNode":"eig019","fromSide":"right","toNode":"eig038","toSide":"left","label":"放宽为只要求有界"},
    {"id":"edge030","fromNode":"eig017","fromSide":"right","toNode":"eig020","toSide":"left","label":"有限时间观察可能误导"},
    {"id":"edge040","fromNode":"depNormal","fromSide":"right","toNode":"eig017","toSide":"left","label":"先定义正规，再看非正规边界"},

    {"id":"edge031","fromNode":"eig039","fromSide":"right","toNode":"eig021","toSide":"left","label":"先固定行列约定"},
    {"id":"edge032","fromNode":"eig039","fromSide":"right","toNode":"eig040","toSide":"left","label":"概率保持约束谱"},
    {"id":"edge048","fromNode":"eig039","fromSide":"right","toNode":"eig049","toSide":"left","label":"有界矩阵幂排除高阶边界块"},
    {"id":"edge045","fromNode":"eig039","fromSide":"bottom","toNode":"eig046","toSide":"top","label":"归一化保证特征值一"},
    {"id":"edge033","fromNode":"eig021","fromSide":"right","toNode":"eig022","toSide":"left","label":"在正确一侧写固定点"},
    {"id":"edge034","fromNode":"eig022","fromSide":"right","toNode":"depFinite","toSide":"left","label":"用闭类结构解释稳态个数"},
    {"id":"edge035","fromNode":"eig040","fromSide":"right","toNode":"eig042","toSide":"left","label":"其余单位圆谱决定收敛"},
    {"id":"edge049","fromNode":"eig049","fromSide":"right","toNode":"eig042","toSide":"bottom","label":"半单性排除边界 Jordan 增长"},
    {"id":"edge046","fromNode":"eig042","fromSide":"right","toNode":"eig048","toSide":"left","label":"收敛先留下固定点投影"},
    {"id":"edge047","fromNode":"eig041","fromSide":"bottom","toNode":"eig048","toSide":"top","label":"一维固定点使投影秩一"},
