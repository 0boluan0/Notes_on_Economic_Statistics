		{"id":"e07","fromNode":"gpd","fromSide":"right","toNode":"moments","toSide":"left","toEnd":"arrow","label":"矩有限性"},
		{"id":"e08","fromNode":"prob","fromSide":"right","toNode":"quantile","toSide":"left","toEnd":"arrow","label":"反解分位"},
		{"id":"e09","fromNode":"quantile","fromSide":"right","toNode":"stable","toSide":"left","toEnd":"arrow","label":"更换起点"},
		{"id":"e10","fromNode":"stable","fromSide":"right","toNode":"es","toSide":"left","toEnd":"arrow","label":"平均超额"},
		{"id":"e11","fromNode":"mle","fromSide":"right","toNode":"diagnostics","toSide":"left","toEnd":"arrow","label":"拟合检查"},
		{"id":"e12","fromNode":"mean","fromSide":"right","toNode":"threshold","toSide":"left","toEnd":"arrow","label":"辅助选阈"},
		{"id":"e13","fromNode":"filter","fromSide":"right","toNode":"clusters","toSide":"left","toEnd":"arrow","label":"过滤后仍检查聚集"},
		{"id":"e14","fromNode":"clusters","fromSide":"right","toNode":"uncertainty","toSide":"left","toEnd":"arrow","label":"依赖影响有效样本"},
		{"id":"e15","fromNode":"max","fromSide":"bottom","toNode":"pot","toSide":"top","toEnd":"arrow","label":"同一吸引域连接两条极限定理"},
		{"id":"e16","fromNode":"pot","fromSide":"bottom","toNode":"risk","toSide":"top","toEnd":"arrow","label":"从条件超额还原无条件尾部"},
		{"id":"e17","fromNode":"risk","fromSide":"bottom","toNode":"fit","toSide":"top","toEnd":"arrow","label":"回头估计参数与选择阈值"},
		{"id":"e18","fromNode":"fit","fromSide":"bottom","toNode":"time","toSide":"top","toEnd":"arrow","label":"检查时间依赖及其估计影响"}
	]
