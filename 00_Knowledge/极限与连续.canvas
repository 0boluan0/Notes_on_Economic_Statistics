      "toEnd": "arrow",
      "label": "Use matching upper and lower limits when available · 有同极限的上下界时可用"
    },
    {
      "id": "le-workflow-lhopital",
      "fromNode": "lc-workflow",
      "fromSide": "bottom",
      "toNode": "lc-lhopital",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "Use only under its differentiability and limit hypotheses · 仅在可导性与极限条件成立时使用"
    },
    {
      "id": "le-tools-contrast",
      "fromNode": "lc-squeeze",
