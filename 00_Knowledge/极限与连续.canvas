      "toSide": "top",
      "toEnd": "arrow",
      "label": "Continuity throughout the interval gives intermediate outputs · 整段区间连续保证取到中间输出"
    },
    {
      "id": "le-classification-removable",
      "fromNode": "lc-discontinuity",
