      "toSide": "top",
      "toEnd": "none",
      "label": "A finite local limit gives the filling · 有限局部极限决定补值"
    },
    {
      "id": "le-classification-jump",
      "fromNode": "lc-discontinuity",
      "fromSide": "bottom",
      "toNode": "lc-jump",
      "toSide": "top",
      "toEnd": "none",
      "label": "Unequal finite side limits defeat any point filling · 有限侧极限不等时，补点不能修复"
    },
    {
