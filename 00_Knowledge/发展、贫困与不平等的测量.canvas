		{"id":"d054000000008016","fromNode":"d054000000000041","fromSide":"bottom","toNode":"d054000000000042","toSide":"top","label":"转移反应"},
		{"id":"d054000000008017","fromNode":"d054000000000041","fromSide":"left","toNode":"d054000000000043","toSide":"right","label":"同值不唯一"},
		{"id":"d054000000008018","fromNode":"d054000000000044","fromSide":"right","toNode":"d054000000000045","toSide":"left","fromEnd":"none","toEnd":"none","label":"不同问题"},
		{"id":"d054000000008019","fromNode":"d054000000000045","fromSide":"right","toNode":"d054000000000046","toSide":"left","label":"具体方案"},
		{"id":"d054000000008020","fromNode":"d054000000000045","fromSide":"bottom","toNode":"d054000000003003","toSide":"top","label":"需要联合信息"},
		{"id":"d054000000008021","fromNode":"d054000000000002","fromSide":"right","toNode":"d054000000003004","toSide":"left","label":"固定人口"},
		{"id":"d054000000008022","fromNode":"d054000000009001","fromSide":"right","toNode":"d054000000009002","toSide":"left","label":"跨国换算"},
		{"id":"d054000000008023","fromNode":"d054000000009001","fromSide":"bottom","toNode":"d054000000009003","toSide":"top","label":"转向家庭分布"},
