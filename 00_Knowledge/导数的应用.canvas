      "label": "On a convex feasible set: convex minima, concave maxima · 凸可行域：凸目标最小、凹目标最大"
    },
    {
      "id": "e21",
      "fromNode": "derivative",
      "fromSide": "bottom",
      "toNode": "related-rates",
