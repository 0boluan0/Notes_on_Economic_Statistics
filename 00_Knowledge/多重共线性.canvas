      "id": "6c20000000000017",
      "fromNode": "6c10000000000014",
      "fromSide": "bottom",
      "toNode": "6c10000000000016",
      "toSide": "top",
      "label": "Next examine influential observations · 接着检查有影响的观测"
    },
    {
