		{"id":"be06","fromNode":"bf-weight","fromSide":"right","toNode":"bf-cpt","toSide":"left","toEnd":"arrow","label":"计算方法"},
		{"id":"be07","fromNode":"bf-disposition","fromSide":"right","toNode":"bf-disposition-boundary","toSide":"left","toEnd":"arrow","label":"解释条件"},
		{"id":"be08","fromNode":"bf-overconfidence","fromSide":"bottom","toNode":"bf-dhs","toSide":"top","toEnd":"arrow","label":"精度偏差"},
		{"id":"be09","fromNode":"bf-attribution","fromSide":"bottom","toNode":"bf-dhs-feedback","toSide":"top","toEnd":"arrow","label":"信心变化"},
		{"id":"be10","fromNode":"bf-dhs","fromSide":"right","toNode":"bf-dhs-feedback","toSide":"left","toEnd":"arrow","label":"动态扩展"},
		{"id":"be11","fromNode":"bf-representative","fromSide":"right","toNode":"bf-bsv","toSide":"left","toEnd":"arrow","label":"心理动机"},
		{"id":"be12","fromNode":"bf-attention","fromSide":"right","toNode":"bf-hs","toSide":"left","toEnd":"none","label":"对照假设"},
		{"id":"be13","fromNode":"bf-hs","fromSide":"bottom","toNode":"bf-momentum","toSide":"top","toEnd":"arrow","label":"图形非唯一"},
		{"id":"be14","fromNode":"bf-arbitrage","fromSide":"right","toNode":"bf-spread","toSide":"left","toEnd":"arrow","label":"风险边界"},
		{"id":"be15","fromNode":"bf-spread","fromSide":"bottom","toNode":"bf-fundamental","toSide":"top","toEnd":"arrow","label":"现金流变化"},
		{"id":"be16","fromNode":"bf-limits","fromSide":"right","toNode":"bf-fundamental","toSide":"left","toEnd":"arrow","label":"一种风险"},
		{"id":"be17","fromNode":"bf-noisetrader","fromSide":"right","toNode":"bf-noiserisk","toSide":"left","toEnd":"arrow","label":"未来情绪"},
		{"id":"be18","fromNode":"bf-noiserisk","fromSide":"bottom","toNode":"bf-capital-feedback","toSide":"top","toEnd":"arrow","label":"头寸亏损"},
		{"id":"be19","fromNode":"bf-capital","fromSide":"right","toNode":"bf-capital-feedback","toSide":"left","toEnd":"arrow","label":"资金敏感"},
		{"id":"be20","fromNode":"bf-capital-feedback","fromSide":"bottom","toNode":"bf-exit","toSide":"top","toEnd":"arrow","label":"被迫减仓"}
	]
}