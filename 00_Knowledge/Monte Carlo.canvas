      "toNode": "mc-risk-validate",
      "toSide": "left",
      "label": "数值收敛≠模型有效"
    },
    {
      "id": "mc-e26",
      "fromNode": "mc-snis",
      "fromSide": "bottom",
      "toNode": "mc-snis-bias",
      "toSide": "top",
      "label": "有限 N 的比率偏差"
    },
    {
      "id": "mc-e27",
      "fromNode": "mc-snis",
      "fromSide": "bottom",
      "toNode": "mc-snis-consistency",
      "toSide": "top",
      "label": "大样本收敛条件"
    },
    {
      "id": "mc-e28",
      "fromNode": "mc-se",
      "fromSide": "bottom",
      "toNode": "mc-ci",
      "toSide": "top",
      "label": "估计 sigma→近似区间"
    },
    {
      "id": "mc-e29",
      "fromNode": "mc-se",
      "fromSide": "bottom",
      "toNode": "mc-cost",
      "toSide": "top",
      "label": "N^{-1/2}→成本律"
    },
    {
      "id": "mc-e30",
      "fromNode": "mc-crn",
      "fromSide": "bottom",
