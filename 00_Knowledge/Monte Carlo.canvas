      "toNode": "mc-is",
      "toSide": "top",
      "label": "改变抽样分布"
    },
    {
      "id": "mc-e16",
      "fromNode": "mc-crn",
      "fromSide": "bottom",
      "toNode": "mc-pair-sign",
