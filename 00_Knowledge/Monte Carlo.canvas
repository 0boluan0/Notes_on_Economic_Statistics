      "label": "最优固定系数"
    },
    {
      "id": "mc-e19",
      "fromNode": "mc-control",
      "fromSide": "bottom",
      "toNode": "mc-control-mean",
      "toSide": "top",
      "label": "错误均值→偏差"
    },
    {
      "id": "mc-e20",
      "fromNode": "mc-control",
      "fromSide": "bottom",
      "toNode": "mc-control-fit",
      "toSide": "top",
      "label": "估计系数≠固定系数"
    },
    {
      "id": "mc-e21",
      "fromNode": "mc-is",
      "fromSide": "bottom",
      "toNode": "mc-is-support",
      "toSide": "top",
      "label": "先保证目标正确"
    },
    {
      "id": "mc-e22",
      "fromNode": "mc-is",
      "fromSide": "bottom",
      "toNode": "mc-is-variance",
      "toSide": "top",
      "label": "再检查二阶矩"
    },
    {
      "id": "mc-e23",
      "fromNode": "mc-is",
      "fromSide": "bottom",
      "toNode": "mc-snis",
      "toSide": "top",
      "label": "未知常数→自归一"
    },
    {
      "id": "mc-e24",
      "fromNode": "mc-vr",
      "fromSide": "right",
      "toNode": "mc-risk",
      "toSide": "left",
      "label": "应用于风险估计"
    },
    {
      "id": "mc-e25",
      "fromNode": "mc-risk",
