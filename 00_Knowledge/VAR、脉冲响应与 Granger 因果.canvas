		{"id":"edge-08","fromNode":"var-010","fromSide":"right","toNode":"var-022","toSide":"left","toEnd":"arrow","label":"先划清统计与结构身份"},
		{"id":"edge-09","fromNode":"var-022","fromSide":"right","toNode":"var-023","toSide":"left","toEnd":"arrow","label":"引入可解释结构冲击"},
		{"id":"edge-10","fromNode":"var-023","fromSide":"right","toNode":"var-011","toSide":"left","toEnd":"arrow","label":"结构恢复需要识别"},
		{"id":"edge-11","fromNode":"var-015","fromSide":"right","toNode":"var-024","toSide":"left","toEnd":"arrow","label":"方法成立依赖工具有效性"},
		{"id":"edge-12","fromNode":"var-025","fromSide":"right","toNode":"var-017","toSide":"left","toEnd":"arrow","label":"定义之后限定解释"},
		{"id":"edge-13","fromNode":"var-016","fromSide":"bottom","toNode":"var-018","toSide":"bottom","toEnd":"arrow","label":"同一识别用于分摊预测不确定性"},
		{"id":"edge-14","fromNode":"var-026","fromSide":"right","toNode":"var-019","toSide":"left","toEnd":"arrow","label":"在线性 VAR 中化为联合零限制"},
		{"id":"edge-15","fromNode":"var-019","fromSide":"right","toNode":"var-020","toSide":"left","toEnd":"arrow","label":"检验后收紧解释语言"},
