      "fromSide": "bottom",
      "toNode": "2000000000000009",
      "toSide": "top",
      "label": "同时满足无关与张成"
    },
    {
      "id": "3000000000000007",
      "fromNode": "2000000000000009",
      "fromSide": "bottom",
      "toNode": "2000000000000020",
      "toSide": "top",
      "label": "所有基的共同长度"
    },
    {
      "id": "3000000000000009",
      "fromNode": "2000000000000033",
      "fromSide": "bottom",
      "toNode": "2000000000000006",
      "toSide": "top",
      "label": "决定存在"
    },
    {
      "id": "300000000000000a",
      "fromNode": "2000000000000005",
      "fromSide": "bottom",
      "toNode": "2000000000000006",
      "toSide": "top",
      "label": "决定唯一"
    },
    {
      "id": "300000000000000b",
      "fromNode": "2000000000000006",
      "fromSide": "bottom",
      "toNode": "2000000000000007",
      "toSide": "top",
      "label": "前置"
    },
    {
      "id": "300000000000000c",
      "fromNode": "2000000000000001",
      "fromSide": "right",
      "toNode": "2000000000000016",
      "toSide": "left",
      "label": "推广到多列"
    },
    {
      "id": "300000000000000d",
      "fromNode": "2000000000000016",
      "fromSide": "bottom",
      "toNode": "2000000000000029",
      "toSide": "top",
      "label": "展开为"
    },
    {
      "id": "300000000000000e",
      "fromNode": "2000000000000029",
      "fromSide": "bottom",
      "toNode": "2000000000000017",
      "toSide": "top",
      "label": "非零单项恰为秩一"
    },
    {
      "id": "300000000000000f",
      "fromNode": "2000000000000031",
      "fromSide": "right",
      "toNode": "2000000000000042",
      "toSide": "left",
      "label": "产生"
    },
