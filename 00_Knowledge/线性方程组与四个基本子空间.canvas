      "toSide": "top",
      "label": "比较"
    },
    {
      "id": "3000000000000005",
      "fromNode": "2000000000000019",
      "fromSide": "bottom",
      "toNode": "2000000000000008",
      "toSide": "top",
      "label": "比较"
    },
    {
      "id": "3000000000000006",
      "fromNode": "2000000000000008",
      "fromSide": "bottom",
      "toNode": "2000000000000009",
      "toSide": "top",
      "label": "二者合成"
    },
    {
      "id": "3000000000000007",
      "fromNode": "2000000000000009",
      "fromSide": "bottom",
      "toNode": "2000000000000020",
      "toSide": "top",
      "label": "定义"
    },
    {
      "id": "3000000000000009",
      "fromNode": "2000000000000033",
      "fromSide": "bottom",
      "toNode": "2000000000000006",
      "toSide": "top",
      "label": "决定存在"
    },
