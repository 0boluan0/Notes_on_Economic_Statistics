		{"id":"e12","fromNode":"n032","fromSide":"right","toNode":"n033","toSide":"left","label":"结合算力与带宽"},
		{"id":"e13","fromNode":"n034","fromSide":"top","toNode":"n032","toSide":"bottom","label":"复用可提高强度"},
		{"id":"e14","fromNode":"n033","fromSide":"bottom","toNode":"n041","toSide":"top","label":"形成待测假设"},
		{"id":"e15","fromNode":"n041","fromSide":"bottom","toNode":"n039","toSide":"top","label":"对照实验需可比"},
		{"id":"e16","fromNode":"n011","fromSide":"right","toNode":"n012","toSide":"left","label":"改为逐轮选成员"},
		{"id":"e17","fromNode":"n012","fromSide":"bottom","toNode":"n015","toSide":"top","label":"可搭配切分提示"},
		{"id":"e18","fromNode":"n036","fromSide":"right","toNode":"n037","toSide":"left","label":"跨块保持归一化"},
		{"id":"e19","fromNode":"n036","fromSide":"bottom","toNode":"tf027","toSide":"top","label":"少物化仍有计算"},
		{"id":"e20","fromNode":"n037","fromSide":"bottom","toNode":"n038","toSide":"top","label":"仍需共同重标定"},
		{"id":"e21","fromNode":"tf008","fromSide":"right","toNode":"n017","toSide":"left","label":"按组共享 K/V"},
		{"id":"e22","fromNode":"n017","fromSide":"bottom","toNode":"n016","toSide":"top","label":"只有一组的端点"},
		{"id":"e23","fromNode":"tf008","fromSide":"bottom","toNode":"n018","toSide":"top","label":"合并不是恒等式"},
		{"id":"e24","fromNode":"n019","fromSide":"right","toNode":"n020","toSide":"left","label":"两种误差来源"},
		{"id":"e25","fromNode":"n019","fromSide":"bottom","toNode":"n021","toSide":"top","label":"参数如何共享"},
		{"id":"e26","fromNode":"n020","fromSide":"bottom","toNode":"n026","toSide":"top","label":"误差经输入传播"},
		{"id":"e27","fromNode":"n022","fromSide":"right","toNode":"n023","toSide":"left","toEnd":"none","label":"是否在训练中模拟"},
		{"id":"e28","fromNode":"n024","fromSide":"right","toNode":"n025","toSide":"left","label":"检查实际省在哪里"},
		{"id":"e29","fromNode":"n027","fromSide":"right","toNode":"n028","toSide":"left","label":"保持分布的依据"},
		{"id":"e30","fromNode":"n027","fromSide":"bottom","toNode":"n029","toSide":"top","label":"按前缀依次验收"},
