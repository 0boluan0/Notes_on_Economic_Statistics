		{"id":"e02","fromNode":"m015","toNode":"m016","fromSide":"right","toSide":"left","toEnd":"none","label":"组织安排不同"},
		{"id":"e03","fromNode":"m011","toNode":"m012","fromSide":"bottom","toSide":"top","toEnd":"arrow","label":"发行融资"},
		{"id":"e04","fromNode":"m012","toNode":"m013","fromSide":"right","toSide":"left","toEnd":"none","label":"新发行 / 已发行"},
		{"id":"e05","fromNode":"m013","toNode":"m014","fromSide":"right","toSide":"left","toEnd":"arrow","label":"预期退出成本"},
		{"id":"e06","fromNode":"m061","toNode":"m063","fromSide":"bottom","toSide":"top","toEnd":"arrow","label":"一种加权规则"},
		{"id":"e07","fromNode":"m062","toNode":"m070","fromSide":"right","toSide":"left","toEnd":"arrow","label":"跨期比较先核单位"},
		{"id":"e08","fromNode":"m063","toNode":"m064","fromSide":"right","toSide":"left","toEnd":"none","label":"股价权重 ≠ 市值权重"},
		{"id":"e09","fromNode":"m064","toNode":"m065","fromSide":"right","toSide":"left","toEnd":"none","label":"市值份额 / 等额"},
		{"id":"e10","fromNode":"m073","toNode":"m071","fromSide":"bottom","toSide":"top","toEnd":"arrow","label":"先核收益口径"},
		{"id":"e11","fromNode":"m066","toNode":"m067","fromSide":"right","toSide":"left","toEnd":"none","label":"算术 / 几何"},
		{"id":"e12","fromNode":"m067","toNode":"m074","fromSide":"right","toSide":"left","toEnd":"none","label":"几何平均的对象不同"},
		{"id":"e13","fromNode":"m068","toNode":"m069","fromSide":"right","toSide":"left","toEnd":"none","label":"旧篮子 / 新篮子"},
		{"id":"e14","fromNode":"m068","toNode":"m074","fromSide":"top","toSide":"bottom","toEnd":"arrow","label":"输入拉氏"},
		{"id":"e15","fromNode":"m069","toNode":"m074","fromSide":"top","toSide":"bottom","toEnd":"arrow","label":"输入派氏"},
		{"id":"e16","fromNode":"m072","toNode":"m071","fromSide":"top","toSide":"bottom","toEnd":"arrow","label":"也须区分收入口径"},
		{"id":"e17","fromNode":"m021","toNode":"m023","fromSide":"right","toSide":"left","toEnd":"arrow","label":"报价交易对手"},
		{"id":"e18","fromNode":"m023","toNode":"m022","fromSide":"right","toSide":"left","toEnd":"arrow","label":"也可在此做市"},
		{"id":"e19","fromNode":"m022","toNode":"m024","fromSide":"right","toSide":"left","toEnd":"arrow","label":"组织存量委托"},
		{"id":"e20","fromNode":"m024","toNode":"m031","fromSide":"bottom","toSide":"top","toEnd":"arrow","label":"按价位读数量"},
		{"id":"e21","fromNode":"m028","toNode":"m029","fromSide":"right","toSide":"left","toEnd":"none","label":"集中时点 / 持续撮合"},
		{"id":"e22","fromNode":"m029","toNode":"m027","fromSide":"right","toSide":"left","toEnd":"arrow","label":"可采用"},
		{"id":"e23","fromNode":"m036","toNode":"m025","fromSide":"right","toSide":"left","toEnd":"arrow","label":"触发后转为"},
		{"id":"e24","fromNode":"m037","toNode":"m026","fromSide":"left","toSide":"right","toEnd":"arrow","label":"触发后转为"},
		{"id":"e25","fromNode":"m026","toNode":"m034","fromSide":"bottom","toSide":"top","toEnd":"arrow","label":"限价约束可成交档"},
		{"id":"e26","fromNode":"m032","toNode":"m030","fromSide":"right","toSide":"left","toEnd":"none","label":"价差是一个维度"},
		{"id":"e27","fromNode":"m034","toNode":"m033","fromSide":"right","toSide":"left","toEnd":"none","label":"走簿 ≠ 永久冲击"},
		{"id":"e28","fromNode":"m034","toNode":"m035","fromSide":"bottom","toSide":"top","toEnd":"arrow","label":"基准比较 + 费用"},
		{"id":"e29","fromNode":"m041","toNode":"m042","fromSide":"right","toSide":"left","toEnd":"arrow","label":"履行已核定义务"},
		{"id":"e30","fromNode":"m042","toNode":"m043","fromSide":"right","toSide":"left","toEnd":"arrow","label":"一种券款联结安排"},
		{"id":"e31","fromNode":"m043","toNode":"m044","fromSide":"right","toSide":"left","toEnd":"arrow","label":"不消除全部风险"},
