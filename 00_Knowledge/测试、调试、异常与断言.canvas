{
	"nodes":[
		{"id":"map-title","type":"text","x":0,"y":-430,"width":3520,"height":220,"text":"# 测试、调试、异常与断言\n\n[[03_Computer_Science/03_MIT 6.100L/12_测试与失败处理|从课程例子连续阅读]] · [[知识原子.base|找定义入口]]\n\n先确定预期，再发现与定位偏差，最后选择失败行为。各区向右阅读；颜色区分职责，不表示掌握度。点击卡片标题进入唯一共享原子。"},
		{"id":"testing-group","type":"group","x":-40,"y":-80,"width":3560,"height":850,"label":"1 · 判断结果：规格、判据与覆盖","color":"4"},
		{"id":"debug-group","type":"group","x":-40,"y":930,"width":3560,"height":470,"label":"2 · 解释偏差：复现与假设","color":"5"},
		{"id":"exception-group","type":"group","x":-40,"y":1560,"width":3560,"height":1130,"label":"3 · 选择失败行为：机制与策略","color":"3"},
		{"id":"profile-group","type":"group","x":-40,"y":2850,"width":3560,"height":470,"label":"4 · 功能正确但慢：测量资源","color":"6"},
		{"id":"test","type":"text","x":0,"y":40,"width":480,"height":180,"text":"## [[软件测试]]\n\n运行程序，将实际行为与预期比较。"},
		{"id":"case","type":"text","x":600,"y":40,"width":480,"height":180,"text":"## [[测试用例]]\n\n规定前置状态、输入、操作与预期行为。"},
		{"id":"oracle","type":"text","x":1200,"y":40,"width":480,"height":180,"text":"## [[测试判据]]\n\n由规格判断结果、异常与状态是否正确。"},
		{"id":"black","type":"text","x":1800,"y":40,"width":480,"height":180,"text":"## [[黑盒测试]]\n\n从接口规格选择输入。"},
		{"id":"white","type":"text","x":2400,"y":40,"width":480,"height":180,"text":"## [[白盒测试]]\n\n按实现结构寻找待执行路径。"},
		{"id":"contract","type":"text","x":3000,"y":40,"width":480,"height":180,"text":"## [[函数契约]]\n\n共享输入、结果、失败与副作用约定。"},
		{"id":"unit","type":"text","x":0,"y":440,"width":480,"height":180,"text":"## [[单元测试]]\n\n组件层检查；说明隔离边界。"},
		{"id":"integration","type":"text","x":600,"y":440,"width":480,"height":180,"text":"## [[集成测试]]\n\n检查组件组合后的交互。"},
		{"id":"regression","type":"text","x":1200,"y":440,"width":480,"height":180,"text":"## [[回归测试]]\n\n改动后重查已有行为；不是另一层级。"},
		{"id":"partition","type":"text","x":1800,"y":440,"width":480,"height":180,"text":"## [[分区与边界选例]]\n\n按不同处理情形和边界选代表。"},
		{"id":"coverage","type":"text","x":2400,"y":440,"width":480,"height":180,"text":"## [[代码覆盖率]]\n\n已执行项目占规定度量范围的比例。"},
		{"id":"coverage-boundary","type":"text","x":3000,"y":440,"width":480,"height":180,"text":"## [[覆盖率不能证明正确]]\n\n两条分支都走过，输入 -1 仍可错误。"},
		{"id":"debug","type":"text","x":0,"y":1050,"width":480,"height":180,"text":"## [[调试]]\n\n根据已观察失败寻找并修复原因。"},
		{"id":"reproduce","type":"text","x":600,"y":1050,"width":480,"height":180,"text":"## [[最小失败复现]]\n\n缩小输入和环境，但保持同一失败。"},
		{"id":"hypothesis","type":"text","x":1200,"y":1050,"width":480,"height":180,"text":"## [[调试假设检验]]\n\n先预测可观察差异，再做受控实验。"},
		{"id":"alias","type":"text","x":1800,"y":1050,"width":480,"height":180,"text":"## [[对象别名]]\n\n两个名称可能指向同一列表。"},
		{"id":"copy","type":"text","x":2400,"y":1050,"width":480,"height":180,"text":"## [[复制层级边界]]\n\n只隔离外层顺序时，浅复制即可。"},
		{"id":"exception","type":"text","x":0,"y":1680,"width":480,"height":180,"text":"## [[Python异常]]\n\n异常对象承载异常情况，并改变控制流。"},
		{"id":"propagate","type":"text","x":600,"y":1680,"width":480,"height":180,"text":"## [[异常传播]]\n\n跳过剩余正常语句，沿调用链找处理器。"},
		{"id":"match","type":"text","x":1200,"y":1680,"width":480,"height":180,"text":"## [[异常类型匹配]]\n\n采用首个匹配异常类或基类的处理器。"},
		{"id":"catch","type":"text","x":1800,"y":1680,"width":480,"height":180,"text":"## [[异常捕获边界]]\n\n只捕获自己能正确解释和处理的失败。"},
		{"id":"policy","type":"text","x":2400,"y":1680,"width":480,"height":180,"text":"## [[异常处理策略]]\n\n传播、重试、跳过或默认由契约决定。"},
		{"id":"raise","type":"text","x":0,"y":2060,"width":480,"height":180,"text":"## [[主动抛出异常]]\n\n报告新失败，或重抛当前异常。"},
		{"id":"chain","type":"text","x":600,"y":2060,"width":480,"height":180,"text":"## [[异常链]]\n\n以隐式上下文或显式原因关联异常。"},
		{"id":"custom","type":"text","x":1200,"y":2060,"width":480,"height":180,"text":"## [[自定义异常]]\n\n提供调用者能区分的领域失败类型。"},
		{"id":"else","type":"text","x":1800,"y":2060,"width":480,"height":180,"text":"## [[try的else分支]]\n\ntry 正常走到末尾后再执行成功路径。"},
		{"id":"finally","type":"text","x":2400,"y":2060,"width":480,"height":180,"text":"## [[finally清理]]\n\n离开时清理，不等于回滚。"},
		{"id":"assert","type":"text","x":1800,"y":2440,"width":480,"height":180,"text":"## [[Python断言]]\n\n启用时检查条件；失败可被捕获。"},
		{"id":"validation","type":"text","x":2400,"y":2440,"width":480,"height":180,"text":"## [[断言不替代输入验证]]\n\n-O 可删除整句；必做检查显式验证。"},
		{"id":"profile","type":"text","x":0,"y":2970,"width":480,"height":180,"text":"## [[性能剖析]]\n\n在指定工作负载下定位资源消耗。"},
		{"id":"profile-times","type":"text","x":600,"y":2970,"width":480,"height":180,"text":"## [[剖析自身与累计时间]]\n\n父调用累计时间已经包含子调用。"},
		{"id":"timing","type":"text","x":1200,"y":2970,"width":480,"height":180,"text":"## [[计时与渐近分析]]\n\n实测运行不等于普遍增长界。"},
		{"id":"grade-bridge","type":"text","x":3000,"y":1680,"width":480,"height":300,"text":"## 同一空成绩，不同接口政策\n\n[[13_Exceptions and Assertions#课堂长例：空成绩列表|完整成绩例子]]\n\navg1 传播；avg2 隐式 None；avg3 按政策记零；avg4 受断言是否启用影响。\n\n复用 [[一等函数对象]] 与 [[返回值与打印]]。"},
		{"id":"debug-bridge","type":"text","x":3000,"y":1050,"width":480,"height":180,"text":"## 从修复回到证据\n\n修复前后用同一判据比较，再检查其他调用者。\n\n[[伪随机复现|随机失败的重放条件]]"},
		{"id":"source-bridge","type":"text","x":1800,"y":2970,"width":1680,"height":180,"text":"## 课程与来源\n\nMIT 6.100L Lectures 12–13：测试、回文调试、pairwise_div、空成绩策略。[[03_Computer_Science/99_Miscellaneous/the_missing_semester#第 7 讲 调试及性能分析|Missing Semester 第 7 讲]]复用同一组调试与性能原子。\n\n精确 Python 机制按语言参考核验，来源保存在各原子末尾。"}
	],
	"edges":[
		{"id":"edge-1","fromNode":"test","toNode":"case","fromSide":"right","toSide":"left","toEnd":"arrow","label":"执行安排"},
