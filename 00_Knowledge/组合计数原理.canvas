      "fromNode": "count-convolution",
      "fromSide": "bottom",
      "toNode": "count-geometric",
      "toSide": "top",
      "label": "Finite geometric factors give convolution examples · 有限几何因子提供卷积例子"
    },
    {
      "id": "count-e022",
      "fromNode": "count-geometric",
      "fromSide": "right",
      "toNode": "count-weighted-geometric",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "逐项求导后乘回公比"
    },
    {
      "id": "count-e023",
      "fromNode": "count-harmonic",
      "fromSide": "bottom",
      "toNode": "count-harmonic-growth",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "积分比较确定增长速度"
    },
    {
      "id": "count-e024",
      "fromNode": "count-asymptotic",
      "fromSide": "left",
      "toNode": "count-harmonic-growth",
      "toSide": "right",
      "toEnd": "arrow",
      "label": "用渐近记号表述增长阶"
    },
    {
      "id": "p0012-ogf-pgf",
