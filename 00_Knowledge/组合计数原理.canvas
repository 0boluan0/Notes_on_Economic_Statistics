      "fromNode": "count-multinomial",
      "fromSide": "bottom",
      "toNode": "count-multitheorem",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "再成为展开系数"
    },
    {
      "id": "count-e017",
      "fromNode": "count-group-proof",
      "fromSide": "bottom",
      "toNode": "count-double",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "同一集合两次分组"
    },
    {
      "id": "count-e019",
      "fromNode": "count-group-series",
      "fromSide": "bottom",
      "toNode": "count-ogf",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "把整列计数编码为系数"
    },
    {
      "id": "count-e020",
      "fromNode": "count-ogf",
      "fromSide": "bottom",
      "toNode": "count-convolution",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "相乘后系数卷积"
    },
    {
