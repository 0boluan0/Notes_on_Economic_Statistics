    {"id":"count-e011","fromNode":"count-division","fromSide":"bottom","toNode":"count-combination","toSide":"top","toEnd":"arrow","label":"除去 k! 个内部顺序"},
    {"id":"count-e012","fromNode":"count-combination","fromSide":"bottom","toNode":"count-symmetry","toSide":"top","toEnd":"arrow","label":"取补集得到对称性"},
    {"id":"count-e015","fromNode":"count-group-multi","fromSide":"bottom","toNode":"count-multinomial","toSide":"top","toEnd":"arrow","label":"先定义有标签多组计数"},
    {"id":"count-e016","fromNode":"count-multinomial","fromSide":"bottom","toNode":"count-multitheorem","toSide":"top","toEnd":"arrow","label":"再成为展开系数"},
    {"id":"count-e017","fromNode":"count-group-proof","fromSide":"bottom","toNode":"count-double","toSide":"top","toEnd":"arrow","label":"同一集合两次分组"},
    {"id":"count-e019","fromNode":"count-group-series","fromSide":"bottom","toNode":"count-ogf","toSide":"top","toEnd":"arrow","label":"把整列计数编码为系数"},
    {"id":"count-e020","fromNode":"count-ogf","fromSide":"bottom","toNode":"count-convolution","toSide":"top","toEnd":"arrow","label":"相乘后系数卷积"},
