      "fromNode": "count-combination",
      "fromSide": "bottom",
      "toNode": "count-symmetry",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "取补集得到对称性"
    },
    {
      "id": "count-e015",
      "fromNode": "count-group-multi",
      "fromSide": "bottom",
      "toNode": "count-multinomial",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "先定义有标签多组计数"
    },
    {
