    {"id":"count-e023","fromNode":"count-harmonic","fromSide":"bottom","toNode":"count-harmonic-growth","toSide":"top","toEnd":"arrow","label":"积分比较确定增长速度"},
    {"id":"count-e024","fromNode":"count-asymptotic","fromSide":"left","toNode":"count-harmonic-growth","toSide":"right","toEnd":"arrow","label":"用渐近记号表述增长阶"}
