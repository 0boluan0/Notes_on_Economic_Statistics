      "fromSide": "left",
      "toNode": "err0000000000010",
      "toSide": "right",
      "label": "A rejection does not identify an AR(1) law · 拒绝不识别 AR(1) 定律",
      "toEnd": "arrow"
    },
    {
      "id": "erre000000000010",
      "fromNode": "err000000000000f",
      "fromSide": "left",
      "toNode": "err0000000000010",
      "toSide": "right",
      "label": "Rejection does not identify the omitted dynamics · 拒绝不识别遗漏的动态机制",
      "toEnd": "arrow"
    },
    {
      "id": "erre000000000011",
      "fromNode": "err0000000000010",
      "fromSide": "bottom",
      "toNode": "err0000000000017",
      "toSide": "top",
      "label": "Return to the estimand, design and mechanism · 回到目标、设计与机制",
      "toEnd": "arrow"
    },
    {
      "id": "erre000000000012",
      "fromNode": "err0000000000004",
