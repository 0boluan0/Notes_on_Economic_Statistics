      "label": "反向命题另需凸性与转移"
    },
    {
      "id": "c8f42a19d6053e7b",
      "fromNode": "b6e108d4f32a7c59",
      "fromSide": "left",
      "toNode": "2c7f95a0e4b831d6",
      "toSide": "right",
      "label": "可分权不等于可无成本实施"
    },
    {
