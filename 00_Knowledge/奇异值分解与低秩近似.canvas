    {"id":"e-value-rank","fromNode":"singular-value-gram","fromSide":"bottom","toNode":"rank","toSide":"top","label":"数正值"},
    {"id":"e-rank-compact","fromNode":"rank","fromSide":"right","toNode":"compact","toSide":"left","label":"保留全部正值"},
    {"id":"e-vector-compact","fromNode":"singular-vector-gram","fromSide":"bottom","toNode":"compact","toSide":"top","label":"保留正方向"},
    {"id":"e-vector-subspaces","fromNode":"singular-vector","fromSide":"bottom","toNode":"four-subspaces","toSide":"top","label":"正与零方向归位"},
    {"id":"e-compact-rank-one","fromNode":"compact","fromSide":"bottom","toNode":"rank-one-expansion","toSide":"top","label":"展开"},
    {"id":"e-rank-one-phase","fromNode":"rank-one-expansion","fromSide":"left","toNode":"paired-phase","toSide":"right","label":"共同相位不改变秩一项"},
    {"id":"e-vector-repeated","fromNode":"singular-vector","fromSide":"bottom","toNode":"repeated-value","toSide":"top","label":"重复正奇异值"},
    {"id":"e-subspaces-zero","fromNode":"four-subspaces","fromSide":"bottom","toNode":"zero-block","toSide":"top","label":"左右零空间"},
    {"id":"e-spectral-definition","fromNode":"spectral-norm","fromSide":"bottom","toNode":"spectral-identity","toSide":"top","label":"由 SVD 读取"},
    {"id":"e-frobenius-definition","fromNode":"frobenius-norm","fromSide":"bottom","toNode":"frobenius-identity","toSide":"top","label":"由 SVD 读取"},
    {"id":"e-rank-one-eym","fromNode":"rank-one-expansion","fromSide":"bottom","toNode":"eym","toSide":"top","label":"展开截断误差"},
    {"id":"e-low-rank-truncation","fromNode":"low-rank","fromSide":"right","toNode":"truncated-svd","toSide":"left","label":"一种候选构造"},
    {"id":"e-truncation-eym","fromNode":"truncated-svd","fromSide":"right","toNode":"eym","toSide":"left","label":"证明最优"},
    {"id":"e-spectral-eym","fromNode":"spectral-identity","fromSide":"bottom","toNode":"eym","toSide":"top","label":"谱误差"},
    {"id":"e-frobenius-eym","fromNode":"frobenius-identity","fromSide":"bottom","toNode":"eym","toSide":"top","label":"平方总误差"},
    {"id":"e-eym-frobenius-unique","fromNode":"eym","fromSide":"right","toNode":"frobenius-uniqueness","toSide":"left","label":"何时唯一"},
    {"id":"e-eym-spectral-nonunique","fromNode":"eym","fromSide":"right","toNode":"spectral-nonuniqueness","toSide":"left","label":"为什么不唯一"},
