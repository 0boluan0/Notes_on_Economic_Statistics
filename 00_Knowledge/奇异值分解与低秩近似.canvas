    },
    {
      "id": "e-frobenius-eym",
      "fromNode": "frobenius-identity",
      "fromSide": "bottom",
      "toNode": "eym",
      "toSide": "top",
      "label": "Sum squared omitted singular values, then take a square root · 舍弃奇异值平方和开平方"
    },
    {
      "id": "e-eym-frobenius-unique",
      "fromNode": "eym",
      "fromSide": "right",
