      "fromNode": "truncated-svd",
      "fromSide": "right",
      "toNode": "eym",
      "toSide": "left",
      "label": "Prove no same-budget matrix has smaller error · 证明同预算候选不能更优"
    },
    {
      "id": "e-spectral-eym",
      "fromNode": "spectral-identity",
      "fromSide": "bottom",
      "toNode": "eym",
      "toSide": "top",
