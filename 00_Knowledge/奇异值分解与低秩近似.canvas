    {"id":"e-value-gram","fromNode":"singular-value","fromSide":"bottom","toNode":"singular-value-gram","toSide":"top","label":"由 Gram 谱读取"},
    {"id":"e-svd-vector","fromNode":"svd","fromSide":"bottom","toNode":"singular-vector","toSide":"top","label":"两侧方向"},
    {"id":"e-vector-gram","fromNode":"singular-vector","fromSide":"bottom","toNode":"singular-vector-gram","toSide":"top","label":"由 Gram 特征向量构造"},
    {"id":"e-svd-eigen","fromNode":"svd","fromSide":"bottom","toNode":"svd-vs-eigen","toSide":"top","label":"区别"},
