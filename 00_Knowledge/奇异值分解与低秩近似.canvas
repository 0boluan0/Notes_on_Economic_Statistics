    },
    {
      "id": "e-vector-compact",
      "fromNode": "singular-vector-gram",
      "fromSide": "bottom",
      "toNode": "compact",
      "toSide": "top",
      "label": "Retain the paired positive directions · 保留配对的正方向"
    },
    {
      "id": "e-vector-subspaces",
      "fromNode": "singular-vector",
      "fromSide": "bottom",
      "toNode": "four-subspaces",
      "toSide": "top",
      "label": "Separate positive and null directions on each side · 两侧分别区分正方向与零空间"
    },
    {
      "id": "e-compact-rank-one",
      "fromNode": "compact",
      "fromSide": "bottom",
      "toNode": "rank-one-expansion",
      "toSide": "top",
      "label": "Expand into weighted outer products · 展开为加权外积之和"
    },
    {
      "id": "e-rank-one-phase",
      "fromNode": "rank-one-expansion",
      "fromSide": "left",
      "toNode": "paired-phase",
      "toSide": "right",
      "label": "Common phase cancels in the outer product · 共同相位在外积中抵消"
    },
    {
      "id": "e-vector-repeated",
      "fromNode": "singular-vector",
      "fromSide": "bottom",
      "toNode": "repeated-value",
      "toSide": "top",
      "label": "Rotate a repeated positive block with one shared unitary matrix · 重复正值组采用共同酉换基"
    },
    {
      "id": "e-subspaces-zero",
      "fromNode": "four-subspaces",
      "fromSide": "bottom",
      "toNode": "zero-block",
      "toSide": "top",
      "label": "Complete the two nullspace bases independently · 两侧零空间独立补基"
    },
    {
      "id": "e-spectral-definition",
      "fromNode": "spectral-norm",
      "fromSide": "bottom",
      "toNode": "spectral-identity",
      "toSide": "top",
      "label": "SVD identifies the largest stretch · SVD给出最大伸缩"
    },
    {
      "id": "e-frobenius-definition",
      "fromNode": "frobenius-norm",
      "fromSide": "bottom",
      "toNode": "frobenius-identity",
      "toSide": "top",
      "label": "Unitary changes preserve the total squared size · 酉变换保持整体平方大小"
    },
    {
      "id": "e-rank-one-eym",
      "fromNode": "rank-one-expansion",
      "fromSide": "bottom",
      "toNode": "eym",
      "toSide": "top",
      "label": "Discard trailing terms and evaluate the norm of the residual · 删除尾项并衡量残差范数"
    },
    {
      "id": "e-low-rank-truncation",
      "fromNode": "low-rank",
      "fromSide": "right",
      "toNode": "truncated-svd",
      "toSide": "left",
