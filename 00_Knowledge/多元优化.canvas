		{"id":"f100000000000007","fromNode":"a10000000000000f","fromSide":"bottom","toNode":"a100000000000010","toSide":"top","label":"四类 KKT 条件中的不等式联结项"},
		{"id":"f100000000000008","fromNode":"a100000000000010","fromSide":"bottom","toNode":"c100000000000006","toSide":"top","label":"乘积为零不提供绑定 → 正乘子"},
		{"id":"f100000000000009","fromNode":"a10000000000000d","fromSide":"left","toNode":"c100000000000007","toSide":"top","label":"法向量线性无关使乘子系数唯一"},
		{"id":"f10000000000000a","fromNode":"a10000000000000d","fromSide":"left","toNode":"c100000000000008","toSide":"top","label":"充分资格失败不能逆推 KKT 失败"},
		{"id":"f10000000000000b","fromNode":"a10000000000000d","fromSide":"left","toNode":"c100000000000005","toSide":"right","label":"LICQ 是一条局部必要性路线"},
		{"id":"f10000000000000c","fromNode":"a10000000000000d","fromSide":"right","toNode":"c100000000000004","toSide":"left","label":"局部活动梯度检查"},
		{"id":"f10000000000000d","fromNode":"a10000000000000e","fromSide":"left","toNode":"c100000000000004","toSide":"right","label":"全局严格可行性与局部活动梯度不是同一条件"},
		{"id":"f10000000000000e","fromNode":"a10000000000000e","fromSide":"top","toNode":"c100000000000009","toSide":"bottom","label":"严格可行性启动强对偶"},
		{"id":"f10000000000000f","fromNode":"c100000000000009","fromSide":"left","toNode":"c100000000000005","toSide":"right","label":"凸问题中强对偶与乘子存在补上最优 → KKT"},
		{"id":"f100000000000010","fromNode":"a100000000000011","fromSide":"bottom","toNode":"c10000000000000a","toSide":"top","label":"选择唯一不等于乘子唯一"},
		{"id":"f100000000000011","fromNode":"a100000000000012","fromSide":"right","toNode":"e100000000000001","toSide":"left","label":"数值与实现它的选择集合分开"},
		{"id":"f100000000000012","fromNode":"a100000000000012","fromSide":"bottom","toNode":"a100000000000015","toSide":"top","label":"Envelope 直接追踪最优价值"},
		{"id":"f100000000000013","fromNode":"e100000000000001","fromSide":"bottom","toNode":"a100000000000014","toSide":"top","label":"IFT 追踪一条局部选择分支"},
		{"id":"f100000000000014","fromNode":"e100000000000001","fromSide":"right","toNode":"e100000000000002","toSide":"left","label":"当前最优集决定价值的方向导数"},
		{"id":"f100000000000015","fromNode":"e100000000000002","fromSide":"bottom","toNode":"a100000000000016","toSide":"top","label":"多解时直接检查价值方向导数"},
		{"id":"f100000000000016","fromNode":"a100000000000015","fromSide":"bottom","toNode":"a100000000000017","toSide":"top","label":"约束右端的包络导数给影子价格"},
		{"id":"f100000000000017","fromNode":"a100000000000009","fromSide":"right","toNode":"b100000000000001","toSide":"left"},
		{"id":"f100000000000018","fromNode":"b100000000000001","fromSide":"right","toNode":"a10000000000000f","toSide":"left"},
		{"id":"f10000000000001a","fromNode":"a100000000000003","fromSide":"right","toNode":"a100000000000004","toSide":"left","label":"取得性先回答有没有，一阶条件再找内部候选"},
		{"id":"f100000000000019","fromNode":"a10000000000000f","fromSide":"bottom","toNode":"c100000000000005","toSide":"top","label":"必要性回答：局部最优在合适约束资格下为何必须进入 KKT"},
		{"id":"f10000000000001b","fromNode":"a10000000000000f","fromSide":"bottom","toNode":"a100000000000011","toSide":"top","label":"充分性回答：凸结构下 KKT 为何足以认证全局最优"},
		{"id":"f10000000000001c","fromNode":"a100000000000009","fromSide":"left","toNode":"c100000000000002","toSide":"right","label":"法向系数不等于罚函数参数"},
