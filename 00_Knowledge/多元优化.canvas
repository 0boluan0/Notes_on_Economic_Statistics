      "fromSide": "bottom",
      "toNode": "c100000000000006",
      "toSide": "top",
      "label": "乘积为零不提供绑定 → 正乘子"
    },
    {
      "id": "f100000000000009",
      "fromNode": "a10000000000000d",
      "fromSide": "left",
      "toNode": "c100000000000007",
      "toSide": "top",
      "label": "Existing multipliers at the same point / 同一点已有乘子的唯一性"
    },
    {
      "id": "f10000000000000a",
      "fromNode": "a10000000000000d",
      "fromSide": "left",
      "toNode": "c100000000000008",
      "toSide": "top",
      "label": "Failure still allows KKT / 失败仍可能有 KKT"
    },
    {
      "id": "f10000000000000b",
      "fromNode": "a10000000000000d",
      "fromSide": "left",
      "toNode": "c100000000000005",
      "toSide": "right",
      "label": "C¹ local optimum + LICQ / C¹ 局部最优与 LICQ"
    },
    {
      "id": "f10000000000000c",
      "fromNode": "a10000000000000d",
      "fromSide": "right",
      "toNode": "c100000000000004",
      "toSide": "left",
      "label": "Given-point gradient test / 指定可行点的梯度检查"
    },
    {
      "id": "f10000000000000d",
      "fromNode": "a10000000000000e",
      "fromSide": "left",
      "toNode": "c100000000000004",
      "toSide": "right",
      "label": "全局严格可行性与局部活动梯度不是同一条件"
    },
    {
      "id": "f10000000000000e",
      "fromNode": "a10000000000000e",
      "fromSide": "top",
      "toNode": "c100000000000009",
      "toSide": "bottom",
