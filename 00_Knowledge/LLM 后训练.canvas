    {"id":"c7e000000000000b","fromNode":"c710000000000009","fromSide":"right","toNode":"c71000000000000a","toSide":"left","toEnd":"arrow","label":"分数差决定提示内可识别部分"},
    {"id":"c7e000000000000c","fromNode":"c710000000000009","fromSide":"right","toNode":"c71000000000000b","toSide":"left","toEnd":"arrow","label":"DPO 继承成对偏好建模"},
    {"id":"c7e000000000000d","fromNode":"c71000000000000a","fromSide":"right","toNode":"c71000000000000b","toSide":"top","toEnd":"arrow","label":"等价类进入直接偏好目标"},
    {"id":"c7e000000000000e","fromNode":"c71000000000000b","fromSide":"right","toNode":"c71000000000000c","toSide":"left","toEnd":"arrow","label":"管线简化不省去假设核验"},
    {"id":"c7e000000000000f","fromNode":"c710000000000012","fromSide":"right","toNode":"c710000000000013","toSide":"left","toEnd":"arrow","label":"以参考策略限制漂移"},
    {"id":"c7e0000000000010","fromNode":"c710000000000013","fromSide":"right","toNode":"c710000000000015","toSide":"left","toEnd":"arrow","label":"约束范围不等于有效性保证"},
    {"id":"c7e0000000000011","fromNode":"c71000000000000d","fromSide":"right","toNode":"c71000000000000e","toSide":"left","toEnd":"arrow","label":"长度可能成为评分捷径"},
    {"id":"c7e0000000000012","fromNode":"c71000000000000d","fromSide":"right","toNode":"c71000000000000f","toSide":"left","toEnd":"arrow","label":"标签可能奖励立场迎合"},
    {"id":"c7e0000000000013","fromNode":"c71000000000000d","fromSide":"right","toNode":"c710000000000011","toSide":"left","toEnd":"arrow","label":"分数解释必须回到独立评测"},
    {"id":"c7e0000000000014","fromNode":"c71000000000000d","fromSide":"bottom","toNode":"c710000000000010","toSide":"left","toEnd":"arrow","label":"先定义目标与人群"},
    {"id":"c7e0000000000015","fromNode":"c71000000000000e","fromSide":"right","toNode":"c710000000000011","toSide":"left","toEnd":"arrow","label":"独立检验长度因素"},
    {"id":"c7e0000000000016","fromNode":"c71000000000000f","fromSide":"right","toNode":"c710000000000011","toSide":"left","toEnd":"arrow","label":"独立检验迎合行为"},
    {"id":"c7e0000000000017","fromNode":"c710000000000010","fromSide":"right","toNode":"c710000000000011","toSide":"bottom","toEnd":"arrow","label":"目标分解决定评测分账"},
    {"id":"c7e0000000000018","fromNode":"c710000000000015","fromSide":"right","toNode":"c710000000000014","toSide":"left","toEnd":"arrow","label":"代理有效性缺口可被持续优化放大"},
    {"id":"c7e0000000000019","fromNode":"c71000000000000b","fromSide":"right","toNode":"c710000000000013","toSide":"left","toEnd":"arrow","label":"DPO 同样以参考策略和 KL 系数定标"}
  ]
}
