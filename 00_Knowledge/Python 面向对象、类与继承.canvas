      "toNode": "4e1d8b603a97f25c",
      "toSide": "left",
      "label": "明确状态归属后才能维护不变量"
    },
    {
      "id": "2864db3e0a9f71c5",
      "fromNode": "4e1d8b603a97f25c",
      "fromSide": "right",
      "toNode": "958ca4301b76e2df",
      "toSide": "left",
      "label": "协议入口也必须保持对象契约"
    },
    {
      "id": "75bd03af69e1284c",
      "fromNode": "958ca4301b76e2df",
      "fromSide": "right",
      "toNode": "21d7e50b9c84a136",
      "toSide": "left",
      "label": "自定义相等必须同时检查哈希契约"
    },
    {
      "id": "8c257f01be34d69a",
      "fromNode": "34fc19a78e2d650b",
      "fromSide": "right",
      "toNode": "8a53d16e40b729cf",
      "toSide": "left",
      "label": "super 按同一 MRO 继续"
    },
    {
      "id": "fc01a8b73d529e64",
      "fromNode": "8a53d16e40b729cf",
      "fromSide": "right",
      "toNode": "d62b8ef5013ca479",
      "toSide": "left",
      "label": "协作复用仍需保持覆盖契约"
    },
    {
      "id": "46da981b25c703ef",
      "fromNode": "d62b8ef5013ca479",
      "fromSide": "right",
      "toNode": "7ce91a5f26b438d0",
      "toSide": "left",
      "label": "统一调用可只依赖行为接口"
    },
    {
      "id": "1a0c5bd4e896f237",
      "fromNode": "e208b54f91c73a60",
      "fromSide": "right",
      "toNode": "5db8a1e340f7692c",
      "toSide": "left",
      "label": "先判断是否真的需要类"
    },
    {
      "id": "d53a27e6081bf49c",
      "fromNode": "5db8a1e340f7692c",
      "fromSide": "right",
      "toNode": "69b2ce7058a134fd",
