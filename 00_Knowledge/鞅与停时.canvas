		{"id":"ae00000000000014","fromNode":"a102000000000003","fromSide":"bottom","toNode":"a102000000000005","toSide":"bottom","label":"分离随机波动与可预测漂移"},
		{"id":"ae00000000000016","fromNode":"a101000000000001","fromSide":"left","toNode":"a103000000000001","toSide":"left","label":"用当时信息判断是否已停止"},
		{"id":"ae00000000000017","fromNode":"a103000000000001","fromSide":"right","toNode":"a103000000000002","toSide":"left","label":"首次进入满足停时条件"},
		{"id":"ae00000000000018","fromNode":"a103000000000002","fromSide":"right","toNode":"a103000000000003","toSide":"left","label":"对照未来依赖"},
		{"id":"ae00000000000019","fromNode":"a103000000000001","fromSide":"bottom","toNode":"a103000000000004","toSide":"bottom","label":"拼接停止分支信息"},
		{"id":"ae00000000000020","fromNode":"a102000000000002","fromSide":"top","toNode":"a100000000000005","toSide":"left","label":"提供条件均值约束"},
		{"id":"ae00000000000020b","fromNode":"a100000000000005","fromSide":"bottom","toNode":"a103000000000005","toSide":"right","label":"与停时信息共同确定"},
		{"id":"ae00000000000021","fromNode":"a103000000000001","fromSide":"top","toNode":"a103000000000005","toSide":"top","label":"确定停前指示"},
		{"id":"ae00000000000022","fromNode":"a103000000000005","fromSide":"right","toNode":"a103000000000007","toSide":"right","label":"先固定每个确定截断"},
		{"id":"ae00000000000023","fromNode":"a103000000000012","fromSide":"left","toNode":"a103000000000007","toSide":"right","label":"S≤T 保证较早信息可用"},
		{"id":"ae00000000000024","fromNode":"a103000000000006","fromSide":"top","toNode":"a103000000000011","toSide":"top","label":"与几乎必然收敛合用升级为 L¹"},
		{"id":"ae00000000000025","fromNode":"a103000000000007","fromSide":"right","toNode":"a103000000000008","toSide":"left","label":"缺少控制时可能失效"},
		{"id":"ae00000000000029","fromNode":"a103000000000009","fromSide":"right","toNode":"a103000000000006","toSide":"left","label":"说明一阶矩界仍不足够"},
		{"id":"ae00000000000031","fromNode":"a102000000000009","fromSide":"top","toNode":"a102000000000002","toSide":"bottom","label":"部分和满足鞅条件"},
		{"id":"ae00000000000027","fromNode":"a103000000000010","fromSide":"left","toNode":"a103000000000006","toSide":"right","label":"高阶矩给出统一尾部界"},
		{"id":"ae00000000000028","fromNode":"a103000000000011","fromSide":"bottom","toNode":"a103000000000007","toSide":"top","label":"为随机终值提供极限交换"},
		{"id":"ae00000000000026","fromNode":"a102000000000002","fromSide":"bottom","toNode":"a101000000000004","toSide":"top","label":"适应仍不足以满足鞅条件"}
