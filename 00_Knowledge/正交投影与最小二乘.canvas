		{"id":"c10000000000000b","fromNode":"b100000000000006","fromSide":"right","toNode":"b100000000000007","toSide":"left","toEnd":"arrow","label":"由标准正交基推广到一般满秩基"},
		{"id":"c10000000000000c","fromNode":"b100000000000013","fromSide":"top","toNode":"b100000000000007","toSide":"bottom","toEnd":"arrow","label":"满列秩保证 Gram 逆存在"},
		{"id":"c10000000000000d","fromNode":"b100000000000007","fromSide":"right","toNode":"b100000000000008","toSide":"left","toEnd":"arrow","label":"伪逆把列空间投影推广到任意秩"},
		{"id":"c10000000000000e","fromNode":"b100000000000008","fromSide":"bottom","toNode":"b100000000000011","toSide":"top","toEnd":"arrow","label":"输出侧唯一拟合支撑最小范数定理"},
		{"id":"c10000000000001a","fromNode":"b10000000000000e","fromSide":"bottom","toNode":"b100000000000011","toSide":"top","toEnd":"arrow","label":"输入侧删除零空间分量支撑最小范数定理"},
		{"id":"c10000000000000f","fromNode":"b100000000000004","fromSide":"bottom","toNode":"b100000000000012","toSide":"top","toEnd":"arrow","label":"最近点问题写成残差范数最小化"},
		{"id":"c100000000000010","fromNode":"b100000000000012","fromSide":"right","toNode":"b100000000000018","toSide":"left","toEnd":"arrow","label":"一阶条件给出残差正交"},
		{"id":"c100000000000011","fromNode":"b100000000000018","fromSide":"right","toNode":"b100000000000019","toSide":"left","toEnd":"arrow","label":"秩决定系数是否唯一"},
		{"id":"c100000000000012","fromNode":"b100000000000019","fromSide":"right","toNode":"b100000000000011","toSide":"left","toEnd":"arrow","label":"不唯一时再选择唯一最小范数者"},
		{"id":"c100000000000013","fromNode":"b10000000000000f","fromSide":"top","toNode":"b10000000000001d","toSide":"bottom","toEnd":"arrow","label":"逐列正交化构造薄因子"},
		{"id":"c100000000000014","fromNode":"b10000000000000f","fromSide":"right","toNode":"b100000000000009","toSide":"left","toEnd":"arrow","label":"经典实现进入浮点后可能失去正交"},
		{"id":"c100000000000015","fromNode":"b100000000000010","fromSide":"right","toNode":"b10000000000001d","toSide":"left","toEnd":"arrow","label":"删去乘到零块的补基"},
		{"id":"c10000000000001d","fromNode":"b10000000000001d","fromSide":"right","toNode":"b10000000000000a","toSide":"left","toEnd":"arrow","label":"满列秩使三角因子可逆"},
		{"id":"c100000000000016","fromNode":"b10000000000000b","fromSide":"top","toNode":"b10000000000000a","toSide":"bottom","toEnd":"arrow","label":"避免显式形成条件数平方的 Gram 矩阵"},
		{"id":"c100000000000017","fromNode":"b10000000000000a","fromSide":"right","toNode":"b100000000000017","toSide":"left","toEnd":"arrow","label":"近秩亏时先检查有效秩"},
		{"id":"c100000000000018","fromNode":"b100000000000017","fromSide":"bottom","toNode":"b10000000000001e","toSide":"top","toEnd":"arrow","label":"秩证据不等于规范解保证"},
		{"id":"c10000000000001e","fromNode":"b10000000000001e","fromSide":"bottom","toNode":"b10000000000000c","toSide":"top","toEnd":"arrow","label":"用 COD 或 SVD 删除零空间分量"},
		{"id":"c10000000000001f","fromNode":"b10000000000001f","fromSide":"top","toNode":"b10000000000000c","toSide":"bottom","toEnd":"arrow","label":"只有低于形状最大秩才进入秩亏分支"},
		{"id":"c100000000000019","fromNode":"b100000000000016","fromSide":"bottom","toNode":"b100000000000010","toSide":"top","toEnd":"arrow","label":"标准正交列构成 QR 分解中的 Q"},
		{"id":"c10000000000001b","fromNode":"b100000000000011","fromSide":"bottom","toNode":"b10000000000000c","toSide":"right","toEnd":"arrow","label":"算法必须实现并验证最小范数选择"}
	]
}
