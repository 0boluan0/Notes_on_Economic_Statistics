    },
    {
      "id": "e05",
      "fromNode": "implications",
      "fromSide": "right",
      "toNode": "in-distribution",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "给出正向蕴含"
    },
    {
      "id": "e05b",
      "fromNode": "in-distribution",
      "fromSide": "bottom",
      "toNode": "distribution-no-probability",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "一般不能控制指定耦合"
    },
    {
      "id": "e05c",
      "fromNode": "constant-limit-converse",
      "fromSide": "right",
      "toNode": "in-probability",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "例外地恢复概率收敛"
    },
    {
      "id": "e05d",
      "fromNode": "distribution-no-probability",
      "fromSide": "bottom",
      "toNode": "constant-limit-converse",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "极限分布退化为常数时例外"
    },
    {
      "id": "e06",
      "fromNode": "strong-law",
      "fromSide": "left",
      "toNode": "almost-sure",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "结论是几乎必然收敛"
    },
    {
      "id": "e07",
      "fromNode": "bounded-variance-weak-law",
      "fromSide": "top",
      "toNode": "mean-square",
      "toSide": "bottom",
      "toEnd": "arrow",
      "label": "同一方差计算给出"
    },
    {
      "id": "e07b",
      "fromNode": "weak-law",
      "fromSide": "left",
      "toNode": "bounded-variance-weak-law",
      "toSide": "right",
      "toEnd": "arrow",
      "label": "一组明确充分条件"
    },
    {
      "id": "e08",
      "fromNode": "clt",
      "fromSide": "right",
      "toNode": "in-distribution",
      "toSide": "right",
      "toEnd": "arrow",
      "label": "结论是依分布收敛"
    },
    {
      "id": "e10",
      "fromNode": "continuous-mapping",
      "fromSide": "top",
      "toNode": "slutsky",
      "toSide": "bottom",
      "toEnd": "arrow",
      "label": "连续映射处理和、积与商"
    },
    {
      "id": "e12",
      "fromNode": "slutsky",
      "fromSide": "left",
      "toNode": "in-distribution",
      "toSide": "right",
      "toEnd": "arrow",
      "label": "结论仍是分布极限"
    }
  ]
}
