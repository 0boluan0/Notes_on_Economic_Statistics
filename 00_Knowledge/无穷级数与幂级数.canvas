    {"id":"e17","fromNode":"s030","fromSide":"top","toNode":"s022","toSide":"bottom","label":"操作后重查端点"},
    {"id":"e18","fromNode":"taylor-poly","fromSide":"right","toNode":"s023","toSide":"left","label":"依次作部分和"},
    {"id":"e19","fromNode":"s023","fromSide":"right","toNode":"s024","toSide":"left","label":"还需余项趋零"},
    {"id":"e20","fromNode":"s025","fromSide":"left","toNode":"s024","toSide":"right","label":"余项不趋零的反例"},
    {"id":"e21","fromNode":"taylor-poly","fromSide":"bottom","toNode":"taylor-rem","toSide":"top","label":"量化与函数的差"},
    {"id":"e22","fromNode":"taylor-rem","fromSide":"right","toNode":"s026","toSide":"left","label":"固定 x 时界趋零"},
    {"id":"e23","fromNode":"s024","fromSide":"bottom","toNode":"s027","toSide":"top","label":"导数界为 1"},
    {"id":"e24","fromNode":"s027","fromSide":"right","toNode":"s036","toSide":"left","label":"逐项求导"},
    {"id":"e25","fromNode":"s032","fromSide":"right","toNode":"s035","toSide":"left","label":"再逐项积分"},
    {"id":"e26","fromNode":"s034","fromSide":"left","toNode":"s035","toSide":"right","label":"同一函数的展开"},
    {"id":"e27","fromNode":"gaussian","fromSide":"top","toNode":"s034","toSide":"bottom","label":"确定归一化常数"},
    {"id":"g01","fromNode":"g-foundation","fromSide":"bottom","toNode":"g-tests","toSide":"top","label":"从计算部分和到控制尾部"},
    {"id":"g02","fromNode":"g-tests","fromSide":"bottom","toNode":"g-signs","toSide":"top","label":"非负项工具先用于绝对值"},
    {"id":"g03","fromNode":"g-signs","fromSide":"bottom","toNode":"g-power","toSide":"top","label":"每个输入得到一条数项级数"},
