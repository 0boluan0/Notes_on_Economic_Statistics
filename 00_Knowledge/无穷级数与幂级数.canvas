    {"id":"e12","fromNode":"s016","fromSide":"right","toNode":"s017","toSide":"left","label":"相邻部分和夹逼"},
    {"id":"e13","fromNode":"s016","fromSide":"top","fromEnd":"none","toNode":"s007","toSide":"bottom","toEnd":"none","label":"两种收敛证明机制"},
    {"id":"e14","fromNode":"s020","fromSide":"right","toNode":"s021","toSide":"left","label":"几何比较定范围"},
