    {"id":"7ce0000000000005","fromNode":"7c00000000000007","fromSide":"right","toNode":"7c00000000000008","toSide":"left","toEnd":"arrow","label":"进入配对"},
    {"id":"7ce0000000000006","fromNode":"7c00000000000002","fromSide":"bottom","toNode":"7c00000000000005","toSide":"top","toEnd":"arrow","label":"检查承诺边界"},
