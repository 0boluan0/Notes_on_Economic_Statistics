      "fromNode": "4c91000000000003",
      "fromSide": "right",
      "toNode": "4c91000000000004",
      "toSide": "left",
      "label": "比较真实路径尺度与期权定价参数时须处理风险溢价"
    },
    {
      "id": "4c92000000000006",
      "fromNode": "4c91000000000004",
      "fromSide": "bottom",
      "toNode": "4c91000000000009",
      "toSide": "top",
      "label": "非零 Vega 决定反解的局部斜率"
    },
    {
      "id": "4c92000000000007",
      "fromNode": "4c91000000000005",
      "fromSide": "bottom",
      "toNode": "4c9100000000000a",
      "toSide": "top",
      "label": "零截距积分递推进入更一般的 ARCH／GARCH 体系"
    },
    {
      "id": "4c92000000000008",
      "fromNode": "4c91000000000005",
      "fromSide": "right",
      "toNode": "4c9100000000000b",
      "toSide": "left",
      "label": "同一衰减因子把方差递推扩展到协方差矩阵"
    }
  ]
}
