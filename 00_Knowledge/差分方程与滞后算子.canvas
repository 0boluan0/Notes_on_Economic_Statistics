		{"id":"de40000000000018","fromNode":"de10000000000005","fromSide":"bottom","toNode":"de20000000000004","toSide":"top","label":"把随机强迫解释为创新"},
		{"id":"de40000000000019","fromNode":"de20000000000004","fromSide":"right","toNode":"de20000000000005","toSide":"left","label":"预测型解还需因果根条件"},
		{"id":"de40000000000020","fromNode":"de20000000000005","fromSide":"right","toNode":"de20000000000006","toSide":"left","label":"允许当前与过去创新展开"},
		{"id":"de40000000000021","fromNode":"de10000000000014","fromSide":"right","toNode":"de20000000000006","toSide":"bottom","label":"加入 MA 分子并核对收敛"},
