		{"id":"mig57-edge-03","fromNode":"mig57-001","fromSide":"bottom","toNode":"mig57-004","toSide":"top","label":"说明工资供给条件"},
		{"id":"mig57-edge-04","fromNode":"mig57-004","fromSide":"right","toNode":"mig57-005","toSide":"left","label":"招工条件固定"},
		{"id":"mig57-edge-05","fromNode":"mig57-003","fromSide":"bottom","toNode":"mig57-income-bridge","toSide":"top","label":"写明收入分享规则"},
		{"id":"mig57-edge-06","fromNode":"mig57-010","fromSide":"right","toNode":"mig57-011","toSide":"left","label":"区分两个阈值"},
		{"id":"mig57-edge-07","fromNode":"mig57-010","fromSide":"bottom","toNode":"mig57-012","toSide":"top","label":"先扣留农消费"},
		{"id":"mig57-edge-08","fromNode":"mig57-012","fromSide":"right","toNode":"mig57-013","toSide":"left","label":"除以工业人数"},
		{"id":"mig57-edge-09","fromNode":"mig57-013","fromSide":"top","toNode":"mig57-011","toSide":"bottom","label":"供养量界定短缺"},
		{"id":"mig57-edge-10","fromNode":"mig57-013","fromSide":"right","toNode":"mig57-food-bridge","toSide":"left","label":"另给价格条件"},
		{"id":"mig57-edge-11","fromNode":"mig57-food-bridge","fromSide":"top","toNode":"mig57-014","toSide":"bottom","label":"价格变化且工资挂钩"},
		{"id":"mig57-edge-12","fromNode":"mig57-020","fromSide":"right","toNode":"mig57-022","toSide":"left","label":"明确分配规则"},
		{"id":"mig57-edge-13","fromNode":"mig57-022","fromSide":"right","toNode":"mig57-021","toSide":"left","label":"对应收入时期"},
		{"id":"mig57-edge-14","fromNode":"mig57-020","fromSide":"bottom","toNode":"mig57-023","toSide":"top","label":"把均衡译回图线"},
		{"id":"mig57-edge-15","fromNode":"mig57-023","fromSide":"right","toNode":"mig57-probability-bridge","toSide":"left","label":"识别预期收入"},
		{"id":"mig57-edge-16","fromNode":"mig57-024","fromSide":"right","toNode":"mig57-025","toSide":"left","toEnd":"none","label":"改变工资 ≠ 外生增岗"},
		{"id":"mig57-edge-17","fromNode":"mig57-informal","fromSide":"right","toNode":"mig57-unemployment","toSide":"left","toEnd":"none","label":"非正规工作仍是就业"},
		{"id":"mig57-edge-18","fromNode":"mig57-040","fromSide":"right","toNode":"mig57-041","toSide":"left","toEnd":"none","label":"风险分担机制 ≠ 往返形态"}
	]
}