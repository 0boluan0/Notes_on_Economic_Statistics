		{"id":"premium-to-pull","fromNode":"premium","fromSide":"right","toNode":"pull","toSide":"left","label":"固定收益率，逐期付息"},
		{"id":"spread-to-pd","fromNode":"spread","fromSide":"right","toNode":"spread-pd","toSide":"left","label":"报价差 ≠ 历史概率"},
		{"id":"credit-to-small","fromNode":"credit-value","fromSide":"right","toNode":"small-loss","toSide":"left","label":"小损失展开"},
		{"id":"credit-to-spread","fromNode":"credit-value","fromSide":"top","toNode":"spread","toSide":"bottom","label":"指定回收模型解释收益率差"},
		{"id":"call-to-value","fromNode":"call","fromSide":"bottom","toNode":"call-value","toSide":"top","label":"其余相同：减去发行人选择权"},
		{"id":"put-to-value","fromNode":"put","fromSide":"bottom","toNode":"put-value","toSide":"top","label":"其余相同：增加持有人选择权"},
		{"id":"convert-to-value","fromNode":"convert","fromSide":"bottom","toNode":"convert-value","toSide":"top","label":"可保留债权：转股选择不减值"},
		{"id":"call-to-yield","fromNode":"call-value","fromSide":"bottom","toNode":"option-yield","toSide":"left","label":"现金流可被提前终止"},
		{"id":"put-to-yield","fromNode":"put-value","fromSide":"bottom","toNode":"option-yield","toSide":"top","label":"退出日期由持有人选择"},
