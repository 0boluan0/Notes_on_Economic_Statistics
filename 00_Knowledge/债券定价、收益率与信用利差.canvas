		{"id":"put","type":"text","x":830,"y":1900,"width":420,"height":90,"text":"## [[可回售债券]]","color":"3"},
		{"id":"put-value","type":"text","x":830,"y":2140,"width":600,"height":90,"text":"## [[回售权的价值效应]]","color":"3"},
		{"id":"convert","type":"text","x":1620,"y":1900,"width":420,"height":90,"text":"## [[可转换债券]]","color":"3"},
		{"id":"convert-value","type":"text","x":1620,"y":2140,"width":600,"height":90,"text":"## [[转股权的价值效应]]","color":"3"},
