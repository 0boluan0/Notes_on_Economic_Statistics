      "fromSide": "bottom",
      "toNode": "38495a6b7c8d9eaf",
      "toSide": "top",
      "label": "Cross-observation covariance contributes to sampling variability · 跨观测协方差参与抽样波动"
    },
    {
      "id": "bccddeef01234567",
      "fromNode": "1b2c3d4e5f607182",
      "fromSide": "bottom",
      "toNode": "718293a4b5c6d7e8",
      "toSide": "top",
      "label": "中心化外积汇总样本共同变化"
    },
    {
      "id": "56789abcdef01234",
