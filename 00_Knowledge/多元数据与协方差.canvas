      "toNode": "60718293a4b5c6d7",
      "toSide": "top",
      "label": "Average across observations, coordinate by coordinate · 跨观测逐坐标平均"
    },
    {
      "id": "899aabbccddeef01",
      "fromNode": "4e5f60718293a4b5",
      "fromSide": "bottom",
      "toNode": "60718293a4b5c6d7",
      "toSide": "top",
      "label": "样本统计量估计总体中心"
    },
    {
      "id": "9aabbccddeef0123",
      "fromNode": "60718293a4b5c6d7",
