    {"id":"bb0000000000000f","fromNode":"aa00000000000010","fromSide":"bottom","toNode":"aa00000000000011","toSide":"top","label":"再区分因果主张"},
    {"id":"bb00000000000010","fromNode":"aa00000000000012","fromSide":"bottom","toNode":"aa00000000000015","toSide":"top","label":"扰动后重拟合检查"},
    {"id":"bb00000000000011","fromNode":"aa0000000000000b","fromSide":"right","toNode":"aa00000000000015","toSide":"left","label":"检验所选子空间"},
    {"id":"bb00000000000012","fromNode":"aa0000000000000f","fromSide":"bottom","toNode":"aa00000000000014","toSide":"top","label":"另立概率生成模型"}
  ]
}
