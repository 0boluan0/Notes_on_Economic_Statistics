      "toNode": "rec-calltree",
      "toSide": "right",
      "label": "调用展开成树"
    },
    {
      "id": "edge-frame-explicit",
      "fromNode": "rec-frame",
      "fromSide": "right",
      "toNode": "rec-explicit",
      "toSide": "left",
      "label": "显式保存待办状态"
    },
    {
      "id": "edge-frame-backtrack",
      "fromNode": "rec-frame",
      "fromSide": "bottom",
      "toNode": "rec-backtrack",
      "toSide": "top",
      "label": "frame 分离不隔离对象"
    },
    {
      "id": "edge-calltree-memo",
      "fromNode": "rec-calltree",
      "fromSide": "bottom",
      "toNode": "rec-memo",
      "toSide": "top",
      "label": "重复有效键可缓存"
    },
    {
      "id": "edge-calltree-divide",
      "fromNode": "rec-calltree",
      "fromSide": "right",
      "toNode": "rec-divide",
      "toSide": "left",
      "label": "按规模写递推"
    },
    {
      "id": "edge-divide-merge",
      "fromNode": "rec-divide",
      "fromSide": "bottom",
      "toNode": "rec-merge",
      "toSide": "top",
      "label": "对半递归加线性归并"
    },
    {
      "id": "edge-termination-calltree",
      "fromNode": "rec-termination",
      "fromSide": "bottom",
      "toNode": "rec-calltree",
      "toSide": "top",
      "label": "逐边检查"
    }
  ]
}
