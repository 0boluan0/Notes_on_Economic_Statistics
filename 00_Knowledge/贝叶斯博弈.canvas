    {"id":"ba9e52000000000a","fromNode":"ba9e51000000000b","fromSide":"right","toNode":"ba9e51000000000c","toSide":"left","label":"完整计划可用两种方式随机化"},
    {"id":"ba9e52000000000b","fromNode":"ba9e51000000000c","fromSide":"right","toNode":"ba9e510000000015","toSide":"left","label":"对象不同但可比较结果分布"},
    {"id":"ba9e52000000000c","fromNode":"ba9e510000000015","fromSide":"right","toNode":"ba9e51000000000d","toSide":"left","label":"给定策略口径后逐类型验最优"},
    {"id":"ba9e52000000000d","fromNode":"ba9e51000000000d","fromSide":"right","toNode":"ba9e510000000014","toSide":"left","label":"行动传递信息时进入序贯分析"},
    {"id":"ba9e52000000000e","fromNode":"ba9e510000000002","fromSide":"bottom","toNode":"ba9e51000000000e","toSide":"top","label":"事中定义不强制共同先验"},
    {"id":"ba9e52000000000f","fromNode":"ba9e51000000000e","fromSide":"right","toNode":"ba9e51000000000f","toSide":"left","label":"额外相容性才给出共同先验"},
    {"id":"ba9e520000000010","fromNode":"ba9e51000000000f","fromSide":"right","toNode":"ba9e510000000010","toSide":"left","label":"共享联合分布支持 Nature 抽取"},
    {"id":"ba9e520000000011","fromNode":"ba9e510000000010","fromSide":"right","toNode":"ba9e510000000011","toSide":"left","label":"Bayes 条件化遇到零概率边界"},
    {"id":"ba9e520000000012","fromNode":"ba9e510000000011","fromSide":"right","toNode":"ba9e510000000013","toSide":"left","label":"零概率类型分开事中与事前检验"},
    {"id":"ba9e520000000013","fromNode":"ba9e51000000000f","fromSide":"bottom","toNode":"ba9e510000000012","toSide":"top","label":"主观相容性不识别客观 DGP"},
    {"id":"ba9e520000000014","fromNode":"ba9e51000000000d","fromSide":"bottom","toNode":"ba9e510000000013","toSide":"top","label":"有限类型下比较事中与事前均衡"},
    {"id":"ba9e520000000015","fromNode":"ba9e510000000013","fromSide":"bottom","toNode":"ba9e510000000016","toSide":"top","label":"连续类型改用 a.e. 或逐点口径"},
    {"id":"ba9e520000000016","fromNode":"ba9e51000000000d","fromSide":"bottom","toNode":"ba9e510000000017","toSide":"top","label":"连续类型应用常寻找临界值"},
    {"id":"ba9e520000000017","fromNode":"ba9e510000000017","fromSide":"right","toNode":"ba9e510000000018","toSide":"left","label":"共同基本面把阈值推理带入全局博弈"},
    {"id":"ba9e520000000018","fromNode":"ba9e510000000018","fromSide":"right","toNode":"ba9e510000000019","toSide":"left","label":"唯一性需要额外结构"},
    {"id":"ba9e520000000019","fromNode":"ba9e51000000000d","fromSide":"bottom","toNode":"ba9e51000000001a","toSide":"top","label":"采购机制也按类型条件策略求解"}
  ]
}
