		{"id":"60f0000000000017","fromNode":"60d0000000000023","fromSide":"bottom","toNode":"60d0000000000024","toSide":"top","label":"由研发强度得到增长分布"},
		{"id":"60f0000000000018","fromNode":"60e0000000000025","fromSide":"bottom","toNode":"60e0000000000026","toSide":"top","label":"技术基础与租金归属分开"},
