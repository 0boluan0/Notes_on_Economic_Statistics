		{"id":"f048000000000043","type":"text","x":1140,"y":970,"width":310,"height":90,"text":"## [[上吊线]]"},
		{"id":"f048000000000044","type":"text","x":40,"y":1120,"width":310,"height":90,"text":"## [[吞没形态]]"},
		{"id":"f048000000000045","type":"text","x":590,"y":1120,"width":310,"height":90,"text":"## [[孕育形态]]"},
		{"id":"f048000000000046","type":"text","x":1140,"y":1120,"width":310,"height":90,"text":"## [[倒锤头线]]"},
