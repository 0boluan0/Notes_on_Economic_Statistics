		{"id":"f048000000000048","type":"text","x":590,"y":1270,"width":310,"height":90,"text":"## [[刺穿形态]]"},
		{"id":"f048000000000049","type":"text","x":1140,"y":1270,"width":310,"height":90,"text":"## [[乌云盖顶]]"},
		{"id":"f048000000000050","type":"text","x":40,"y":1420,"width":310,"height":90,"text":"## [[启明星]]"},
		{"id":"f048000000000051","type":"text","x":590,"y":1420,"width":310,"height":90,"text":"## [[黄昏星]]"},
		{"id":"f048000000000052","type":"text","x":1140,"y":1420,"width":310,"height":90,"text":"## [[白色三兵]]"},
		{"id":"f048000000000053","type":"text","x":40,"y":1570,"width":310,"height":90,"text":"## [[三只乌鸦]]"},
		{"id":"f048000000000054","type":"text","x":590,"y":1570,"width":310,"height":90,"text":"## [[上升三法]]"},
		{"id":"f048000000000055","type":"text","x":1140,"y":1570,"width":310,"height":90,"text":"## [[下降三法]]"},
		{"id":"f048000000000802","type":"text","x":40,"y":1720,"width":1420,"height":170,"text":"同一根形状可因先前走势而改名。完整 K 线与后续确认各有可用时点；形态名称本身不完成交易规则。\n\n<!-- bilingual-en:start -->\nThe same candle shape can receive a different name after a different preceding trend. Complete candles and subsequent confirmations have distinct availability times; a pattern name alone does not complete a trading rule.\n<!-- bilingual-en:end -->"},
		{"id":"f048000000000056","type":"text","x":1790,"y":970,"width":310,"height":90,"text":"## [[双重顶]]"},
		{"id":"f048000000000057","type":"text","x":2340,"y":970,"width":310,"height":90,"text":"## [[双重底]]"},
		{"id":"f048000000000058","type":"text","x":2890,"y":970,"width":310,"height":90,"text":"## [[三重顶]]"},
		{"id":"f048000000000059","type":"text","x":1790,"y":1120,"width":310,"height":90,"text":"## [[头肩顶]]"},
		{"id":"f048000000000060","type":"text","x":2340,"y":1120,"width":310,"height":90,"text":"## [[头肩底]]"},
		{"id":"f048000000000061","type":"text","x":2890,"y":1120,"width":310,"height":90,"text":"## [[圆弧形态]]"},
		{"id":"f048000000000062","type":"text","x":1790,"y":1270,"width":310,"height":90,"text":"## [[对称三角形]]"},
		{"id":"f048000000000063","type":"text","x":2340,"y":1270,"width":310,"height":90,"text":"## [[对称三角测幅]]"},
		{"id":"f048000000000064","type":"text","x":2890,"y":1270,"width":310,"height":90,"text":"## [[上升三角形]]"},
		{"id":"f048000000000065","type":"text","x":1790,"y":1420,"width":310,"height":90,"text":"## [[矩形整理]]"},
		{"id":"f048000000000066","type":"text","x":2340,"y":1420,"width":310,"height":90,"text":"## [[喇叭形态]]"},
		{"id":"f048000000000067","type":"text","x":2890,"y":1420,"width":310,"height":90,"text":"## [[菱形形态]]"},
		{"id":"f048000000000068","type":"text","x":1790,"y":1570,"width":310,"height":90,"text":"## [[旗形]]"},
		{"id":"f048000000000069","type":"text","x":2340,"y":1570,"width":310,"height":90,"text":"## [[楔形]]"},
		{"id":"f048000000000803","type":"text","x":1790,"y":1720,"width":1420,"height":170,"text":"候选轮廓 → 按预定条件确认突破 → 另定执行。测幅给出候选目标；不是保底空间。几何容差与转折点确认窗口须事先固定。\n\n<!-- bilingual-en:start -->\nCandidate outline → pre-specified breakout confirmation → separately specified execution. Measured moves give candidate targets, not guaranteed minima. Fix geometric tolerances and pivot-confirmation windows in advance.\n<!-- bilingual-en:end -->"},
		{"id":"f048000000000072","type":"text","x":40,"y":2170,"width":1420,"height":90,"text":"## [[艾略特波浪]]"},
		{"id":"f048000000000073","type":"text","x":40,"y":2340,"width":600,"height":90,"text":"## [[标准推动浪]]"},
		{"id":"f048000000000075","type":"text","x":840,"y":2340,"width":600,"height":90,"text":"## [[艾略特修正浪]]"},
		{"id":"f048000000000074","type":"text","x":40,"y":2510,"width":600,"height":90,"text":"## [[推动浪计数约束]]"},
		{"id":"f048000000000076","type":"text","x":840,"y":2510,"width":600,"height":90,"text":"## [[艾略特交替原则]]"},
		{"id":"f048000000000070","type":"text","x":40,"y":2710,"width":600,"height":90,"text":"## [[价格缺口]]"},
		{"id":"f048000000000071","type":"text","x":840,"y":2710,"width":600,"height":90,"text":"## [[缺口分类时点]]"},
		{"id":"f048000000000804","type":"text","x":40,"y":2900,"width":1420,"height":290,"text":"### 结构标签与未来路径分开\n\n<!-- bilingual-en:start -->\nSeparate structural labels from future paths\n<!-- bilingual-en:end -->\n\n推动浪的有效计数条件与交替指引有不同职责。缺口当期可确认区间空档；依赖后续持续或回补的类别，要等相应信息出现。\n\n<!-- bilingual-en:start -->\nImpulse-validity constraints differ from alternation guidelines. A gap's interval can be confirmed once its period is complete; categories relying on later continuation or filling become available only after those outcomes.\n<!-- bilingual-en:end -->"},
		{"id":"f048000000000005","type":"text","x":1790,"y":2160,"width":310,"height":90,"text":"## [[技术指标]]"},
		{"id":"f048000000000006","type":"text","x":2340,"y":2160,"width":310,"height":90,"text":"## [[指标同源边界]]"},
		{"id":"f048000000000020","type":"text","x":2890,"y":2160,"width":310,"height":90,"text":"## [[简单移动平均]]"},
		{"id":"f048000000000021","type":"text","x":1790,"y":2310,"width":310,"height":90,"text":"## [[指数移动平均]]"},
		{"id":"f048000000000022","type":"text","x":2340,"y":2310,"width":310,"height":90,"text":"## [[MACD]]"},
		{"id":"f048000000000023","type":"text","x":2890,"y":2310,"width":310,"height":90,"text":"## [[RSI]]"},
		{"id":"f048000000000024","type":"text","x":1790,"y":2460,"width":310,"height":90,"text":"## [[威廉指标]]"},
		{"id":"f048000000000025","type":"text","x":2340,"y":2460,"width":310,"height":90,"text":"## [[随机指标KDJ]]"},
		{"id":"f048000000000026","type":"text","x":2890,"y":2460,"width":310,"height":90,"text":"## [[OBV]]"},
		{"id":"f048000000000027","type":"text","x":1790,"y":2610,"width":310,"height":90,"text":"## [[OBOS]]"},
		{"id":"f048000000000028","type":"text","x":2340,"y":2610,"width":310,"height":90,"text":"## [[腾落线]]"},
		{"id":"f048000000000029","type":"text","x":2890,"y":2610,"width":310,"height":90,"text":"## [[涨跌比率]]"},
		{"id":"f048000000000007","type":"text","x":1790,"y":2760,"width":310,"height":90,"text":"## [[超买超卖]]"},
		{"id":"f048000000000008","type":"text","x":2340,"y":2760,"width":310,"height":90,"text":"## [[超买超卖不保证反转]]"},
		{"id":"f048000000000030","type":"text","x":1790,"y":2910,"width":310,"height":90,"text":"## [[指标背离]]"},
		{"id":"f048000000000031","type":"text","x":2340,"y":2910,"width":310,"height":90,"text":"## [[背离不能确定反转]]"},
		{"id":"f048000000000805","type":"text","x":1790,"y":3040,"width":1420,"height":150,"text":"固定输入、窗口、初值与单位后再复算；阈值状态和背离关系，均不自动决定下一段价格方向。\n\n<!-- bilingual-en:start -->\nRecalculate after fixing inputs, windows, seeds, and units. Neither threshold states nor divergence relations determine the next price segment's direction.\n<!-- bilingual-en:end -->"},
		{"id":"f048000000000106","type":"text","x":40,"y":3460,"width":310,"height":90,"text":"## [[均线交叉规则]]"},
		{"id":"f048000000000102","type":"text","x":590,"y":3460,"width":310,"height":90,"text":"## [[交易信号时序]]"},
		{"id":"f048000000000104","type":"text","x":1140,"y":3460,"width":310,"height":90,"text":"## [[复权与成交价格]]"},
		{"id":"f048000000000107","type":"text","x":40,"y":3660,"width":310,"height":90,"text":"## [[突破确认规则]]"},
		{"id":"f048000000000103","type":"text","x":590,"y":3660,"width":310,"height":90,"text":"## [[历史股票池]]"},
		{"id":"f048000000000101","type":"text","x":1140,"y":3660,"width":310,"height":90,"text":"## [[交易策略回测]]"},
		{"id":"f048000000000806","type":"text","x":40,"y":3860,"width":1420,"height":460,"text":"### 两条示例规则，共用一条执行时间线\n\n<!-- bilingual-en:start -->\nTwo example rules share one execution timeline\n<!-- bilingual-en:end -->\n\n收盘后确认信号 → 下一个合资格交易时段提交订单 → 按真实可成交条件记录全部、部分或零成交 → 更新现金与实际持仓。\n\n<!-- bilingual-en:start -->\nConfirm the signal after the close → submit at the next eligible session → record full, partial, or zero fills under executable conditions → update cash and actual holdings.\n<!-- bilingual-en:end -->\n\n股票池按历史时点重建；复权用于一致信号尺度，真实成交价与公司行动进入账户。先对齐费用和价格处理，再计算扣费净值路径。\n\n<!-- bilingual-en:start -->\nReconstruct historical universe eligibility. Adjustments align signal scales; actual execution prices and corporate actions enter the account. Reconcile fees and price treatment before calculating the net-of-cost account-value path.\n<!-- bilingual-en:end -->"},
		{"id":"f048000000000105","type":"text","x":1790,"y":3460,"width":310,"height":90,"text":"## [[最大回撤]]"},
		{"id":"f048000000000901","type":"text","x":2340,"y":3460,"width":310,"height":90,"text":"## [[Sharpe比率]]"},
		{"id":"f048000000000902","type":"text","x":2890,"y":3460,"width":310,"height":90,"text":"## [[负Sharpe排序边界]]"},
		{"id":"f048000000000903","type":"text","x":1790,"y":3660,"width":310,"height":90,"text":"## [[训练验证测试划分]]"},
		{"id":"f048000000000904","type":"text","x":2340,"y":3660,"width":310,"height":90,"text":"## [[滚动起点评估]]"},
		{"id":"f048000000000905","type":"text","x":2890,"y":3660,"width":310,"height":90,"text":"## [[测试集自适应复用]]"},
		{"id":"f048000000000906","type":"text","x":1790,"y":3830,"width":310,"height":90,"text":"## [[证券交易成本]]"},
		{"id":"f048000000000907","type":"text","x":2340,"y":3830,"width":310,"height":90,"text":"## [[市场冲击]]"},
		{"id":"f048000000000908","type":"text","x":2890,"y":3830,"width":310,"height":90,"text":"## [[Alpha基准依赖性]]"},
		{"id":"f048000000000807","type":"text","x":1790,"y":4030,"width":1420,"height":390,"text":"### 不同量各回答一个问题\n\n<!-- bilingual-en:start -->\nDifferent measures answer different questions\n<!-- bilingual-en:end -->\n\n最大回撤看峰后损失路径；Sharpe 比较逐期超额收益均值与其标准差，负值排序另有边界；Alpha 依赖基准。冻结规则后按时间顺序检验，不能看完测试结果再保留“获胜”版本。\n\n<!-- bilingual-en:start -->\nMaximum drawdown measures loss along the path after a peak. Sharpe compares the mean of period-by-period excess returns with their standard deviation, with a separate boundary for negative rankings. Alpha depends on the benchmark. Freeze rules before time-ordered tests; do not select the winning version after seeing test outcomes.\n<!-- bilingual-en:end -->\n\n策略收益证据与市场效率命题的联系，见[[市场异象复核]]与[[市场效率检验口径]]。\n\n<!-- bilingual-en:start -->\nRelate strategy-return evidence to market-efficiency claims through [[市场异象复核|anomaly reassessment]] and [[市场效率检验口径|the scope of efficiency tests]].\n<!-- bilingual-en:end -->"}
	],
