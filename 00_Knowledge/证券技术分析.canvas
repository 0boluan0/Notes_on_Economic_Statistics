		{"id":"f048000000000019","type":"text","x":2340,"y":520,"width":310,"height":90,"text":"## [[速度线]]"},
		{"id":"f048000000000040","type":"text","x":2890,"y":520,"width":310,"height":90,"text":"## [[甘氏线]]"},
