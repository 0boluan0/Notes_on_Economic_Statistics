		{"id":"f048000000000013","type":"text","x":2340,"y":220,"width":310,"height":90,"text":"## [[支撑位]]"},
		{"id":"f048000000000014","type":"text","x":2890,"y":220,"width":310,"height":90,"text":"## [[阻力位]]"},
		{"id":"f048000000000015","type":"text","x":1790,"y":370,"width":310,"height":90,"text":"## [[支阻转换]]"},
