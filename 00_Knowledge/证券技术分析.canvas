{
	"nodes":[
		{"id":"f048a00000000001","type":"group","x":0,"y":0,"width":1500,"height":800,"label":"1 · 研究输入与假设","color":"4"},
		{"id":"f048a00000000002","type":"group","x":1750,"y":0,"width":1500,"height":800,"label":"2 · 趋势与支阻线","color":"5"},
