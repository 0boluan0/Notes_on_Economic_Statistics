		{"id":"e00000000000000c","fromNode":"000000000000000c","fromSide":"bottom","toNode":"000000000000000e","toSide":"top","label":"到达概率为零时转入离轨检查"},
		{"id":"e00000000000000d","fromNode":"000000000000000b","fromSide":"bottom","toNode":"0000000000000010","toSide":"top","label":"weak PBE 的最优性条件"},
		{"id":"e00000000000000e","fromNode":"000000000000000c","fromSide":"bottom","toNode":"0000000000000010","toSide":"top","label":"weak PBE 的路径上一致性"},
		{"id":"e00000000000000f","fromNode":"0000000000000010","fromSide":"right","toNode":"000000000000000e","toSide":"left","label":"路径外仍须序贯最优"},
		{"id":"e000000000000010","fromNode":"000000000000000e","fromSide":"right","toNode":"000000000000000f","toSide":"left","label":"belief 与离轨反应须联合可行"},
		{"id":"e000000000000011","fromNode":"0000000000000010","fromSide":"bottom","toNode":"0000000000000011","toSide":"top","label":"先声明采用哪种 PBE"},
		{"id":"e000000000000012","fromNode":"0000000000000010","fromSide":"bottom","toNode":"0000000000000012","toSide":"top","label":"固定同一扩展式后比较"},
		{"id":"e000000000000013","fromNode":"0000000000000010","fromSide":"bottom","toNode":"0000000000000013","toSide":"top","label":"weak consistency 留下精炼边界"},
		{"id":"e000000000000014","fromNode":"0000000000000010","fromSide":"bottom","toNode":"0000000000000014","toSide":"top","label":"共同 tremble 序列加强 consistency"},
		{"id":"e000000000000015","fromNode":"000000000000000e","fromSide":"bottom","toNode":"000000000000001f","toSide":"top","label":"限制离轨信号的类型解释"},
		{"id":"e000000000000016","fromNode":"000000000000000f","fromSide":"bottom","toNode":"0000000000000015","toSide":"top","label":"进入完整 weak-PBE 检验"},
		{"id":"e000000000000017","fromNode":"000000000000001f","fromSide":"bottom","toNode":"0000000000000020","toSide":"top","label":"按偏离动机集合进一步筛选"},
		{"id":"e000000000000024","fromNode":"0000000000000014","fromSide":"bottom","toNode":"0000000000000023","toSide":"top","label":"共同可达不保证 belief 唯一"},
		{"id":"e000000000000025","fromNode":"000000000000001f","fromSide":"bottom","toNode":"0000000000000024","toSide":"top","label":"所有类型均被支配时准则沉默"},
		{"id":"e000000000000026","fromNode":"0000000000000020","fromSide":"bottom","toNode":"0000000000000025","toSide":"top","label":"应用前固定集合包含口径"},
		{"id":"e000000000000027","fromNode":"0000000000000020","fromSide":"right","toNode":"0000000000000026","toSide":"top","label":"两道收紧使 D1 更严格"},
		{"id":"e000000000000018","fromNode":"0000000000000010","fromSide":"bottom","toNode":"0000000000000016","toSide":"top","label":"均衡成立后再按信号分布分类"},
		{"id":"e000000000000019","fromNode":"0000000000000016","fromSide":"bottom","toNode":"0000000000000017","toSide":"top","label":"各类型分布相同"},
		{"id":"e00000000000001a","fromNode":"0000000000000016","fromSide":"bottom","toNode":"0000000000000018","toSide":"top","label":"各类型支持互不相交"},
		{"id":"e00000000000001b","fromNode":"0000000000000016","fromSide":"bottom","toNode":"000000000000001c","toSide":"top","label":"既非合并也非分离"},
		{"id":"e00000000000001c","fromNode":"0000000000000017","fromSide":"bottom","toNode":"0000000000000021","toSide":"top","label":"共同支持可选为纯策略"},
		{"id":"e00000000000001d","fromNode":"0000000000000018","fromSide":"bottom","toNode":"0000000000000019","toSide":"top","label":"识别之外还须激励相容"},
		{"id":"e00000000000001e","fromNode":"0000000000000018","fromSide":"bottom","toNode":"000000000000001a","toSide":"top","label":"先检查组合可行性"},
		{"id":"e00000000000001f","fromNode":"0000000000000018","fromSide":"bottom","toNode":"000000000000001b","toSide":"top","label":"限定路径上 posterior 的不变性"},
		{"id":"e000000000000020","fromNode":"0000000000000018","fromSide":"bottom","toNode":"0000000000000022","toSide":"top","label":"不交支持可逐类型选取"},
