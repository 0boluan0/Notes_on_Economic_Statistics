      "toNode": "a71000000000000a",
      "toSide": "left",
      "label": "Interpret intervals in units and prespecified bounds · 按单位与预设界解释区间",
      "toEnd": "arrow"
    },
    {
      "id": "b710000000000009",
      "fromNode": "a71000000000000c",
