      "fromSide": "right",
      "toNode": "a71000000000000d",
      "toSide": "left",
      "label": "Use a positive definite restriction covariance · 用正定的限制协方差构成二次型",
      "toEnd": "arrow"
    },
    {
      "id": "b71000000000000b",
      "fromNode": "a71000000000000b",
      "fromSide": "bottom",
      "toNode": "a71000000000000e",
      "toSide": "left",
      "label": "Localise with prespecified contrasts · 用预先有意义的对比定位",
      "toEnd": "arrow"
    },
    {
