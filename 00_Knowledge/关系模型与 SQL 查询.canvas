		{"id":"a7e000000000000e","fromNode":"a70000000000000a","fromSide":"bottom","toNode":"a700000000000010","toSide":"top","toEnd":"arrow","label":"UNKNOWN 会被过滤"},
		{"id":"a7e000000000000f","fromNode":"a70000000000000e","fromSide":"left","toNode":"a700000000000011","toSide":"right","toEnd":"arrow","label":"多侧匹配复制度量"},
		{"id":"a7e0000000000010","fromNode":"a700000000000003","fromSide":"bottom","toNode":"a700000000000011","toSide":"top","toEnd":"arrow","label":"度量粒度决定能否直加"},
		{"id":"a7e0000000000011","fromNode":"a700000000000007","fromSide":"right","toNode":"a700000000000011","toSide":"left","toEnd":"arrow","label":"保留重复使倍增延续"},
		{"id":"a7e0000000000012","fromNode":"a700000000000012","fromSide":"top","toNode":"a700000000000011","toSide":"bottom","toEnd":"arrow","label":"先压回目标粒度再连接"},
		{"id":"a7e0000000000013","fromNode":"a700000000000008","fromSide":"top","toNode":"a700000000000012","toSide":"bottom","toEnd":"arrow","label":"命名中间阶段"},
