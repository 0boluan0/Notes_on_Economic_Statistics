		{"id":"cp-e20","fromNode":"cp-020","fromSide":"left","toNode":"cp-021","toSide":"right","label":"价格因果前提"},
		{"id":"cp-e21","fromNode":"cp-022","fromSide":"right","toNode":"cp-023","toSide":"left","label":"反馈的参照标准"},
		{"id":"cp-e22","fromNode":"cp-022","fromSide":"bottom","toNode":"cp-024","toSide":"top","label":"生活成本进入工资"},
		{"id":"cp-e23","fromNode":"cp-024","fromSide":"right","toNode":"cp-025","toSide":"left","label":"区分计价冲击"},
		{"id":"cp-e24","fromNode":"cp-024","fromSide":"bottom","toNode":"cp-026","toSide":"top","label":"利润回报影响再投资"},
