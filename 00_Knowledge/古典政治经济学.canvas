		{"id":"cp-e16","fromNode":"cp-016","fromSide":"right","toNode":"cp-018","toSide":"left","label":"同地追加投入"},
		{"id":"cp-e17","fromNode":"cp-016","fromSide":"bottom","toNode":"cp-017","toSide":"top","label":"辨清农场付款构成"},
		{"id":"cp-e18","fromNode":"cp-018","fromSide":"right","toNode":"cp-019","toSide":"left","label":"检验生产边际"},
