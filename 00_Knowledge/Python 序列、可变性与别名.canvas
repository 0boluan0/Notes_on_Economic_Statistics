      "fromNode": "a510000000000007",
      "fromSide": "right",
      "toNode": "a510000000000008",
      "toSide": "left",
      "label": "契约要求隔离时才引入复制"
    },
    {
      "id": "b510000000000007",
      "fromNode": "a510000000000009",
      "fromSide": "right",
      "toNode": "a51000000000000a",
      "toSide": "left",
      "label": "把清晰的遍历筛选压成构造表达式"
    },
    {
      "id": "b510000000000008",
      "fromNode": "a51000000000000a",
      "fromSide": "right",
      "toNode": "a51000000000000b",
      "toSide": "left",
      "label": "无需完整列表时改为按需生成"
    },
    {
      "id": "b510000000000009",
      "fromNode": "a510000000000008",
      "fromSide": "bottom",
      "toNode": "a51000000000000b",
      "toSide": "top",
      "label": "已有对象图的复制与未来值的生成是两类问题"
    }
  ]
}
