    {"id":"200000000000000b","fromNode":"1000000000000006","fromSide":"bottom","toNode":"1000000000000009","toSide":"top","label":"跨簇点对平均"},
    {"id":"200000000000000c","fromNode":"1000000000000006","fromSide":"bottom","toNode":"100000000000000a","toSide":"top","label":"WSS 增量"},
    {"id":"200000000000000d","fromNode":"100000000000000a","fromSide":"bottom","toNode":"100000000000001b","toSide":"top","label":"Ward 解释先满足平方 Euclidean 条件"},
    {"id":"200000000000001e","fromNode":"100000000000000a","fromSide":"bottom","toNode":"1000000000000020","toSide":"top","label":"树上高度还需声明实现口径"},
    {"id":"200000000000000e","fromNode":"1000000000000007","fromSide":"bottom","toNode":"100000000000000b","toSide":"top","label":"连接规则生成一棵可切的树"},
    {"id":"200000000000000f","fromNode":"1000000000000008","fromSide":"bottom","toNode":"100000000000000b","toSide":"top","label":"连接规则生成一棵可切的树"},
    {"id":"2000000000000010","fromNode":"1000000000000009","fromSide":"bottom","toNode":"100000000000000b","toSide":"top","label":"连接规则生成一棵可切的树"},
    {"id":"2000000000000011","fromNode":"100000000000001b","fromSide":"bottom","toNode":"100000000000000b","toSide":"top","label":"相容 Ward 合并也形成完整层次"},
    {"id":"200000000000001f","fromNode":"1000000000000020","fromSide":"bottom","toNode":"100000000000000b","toSide":"top","label":"读取纵轴前先核对口径"},
    {"id":"2000000000000012","fromNode":"100000000000000b","fromSide":"left","toNode":"100000000000001f","toSide":"top","label":"读图时区分分支高度与横向叶序"},
    {"id":"2000000000000013","fromNode":"100000000000000c","fromSide":"bottom","toNode":"100000000000000d","toSide":"top","label":"Lloyd 步骤交替下降该目标"},
    {"id":"2000000000000014","fromNode":"100000000000000d","fromSide":"bottom","toNode":"100000000000001c","toSide":"top","label":"下降性质只给出局部收敛边界"},
    {"id":"2000000000000015","fromNode":"100000000000000d","fromSide":"bottom","toNode":"100000000000001e","toSide":"top","label":"均值更新遇到空簇时需要实现规则"},
    {"id":"2000000000000016","fromNode":"100000000000001c","fromSide":"bottom","toNode":"100000000000000e","toSide":"top","label":"局部结果使起点成为求解器的一部分"},
    {"id":"2000000000000017","fromNode":"100000000000000e","fromSide":"left","toNode":"100000000000001d","toSide":"top","label":"一次运行可用 D² 概率播种"},
    {"id":"2000000000000020","fromNode":"100000000000000e","fromSide":"bottom","toNode":"1000000000000021","toSide":"top","label":"也可独立重复整次求解"},
    {"id":"2000000000000018","fromNode":"100000000000000b","fromSide":"bottom","toNode":"1000000000000010","toSide":"left","label":"不同切树位置给出候选分辨率"},
    {"id":"2000000000000019","fromNode":"1000000000000021","fromSide":"bottom","toNode":"1000000000000010","toSide":"top","label":"对各个候选 K 先充分求解"},
    {"id":"200000000000001a","fromNode":"100000000000000f","fromSide":"bottom","toNode":"1000000000000010","toSide":"top","label":"紧密与分离只是选择 K 的一种证据"},
    {"id":"200000000000001b","fromNode":"1000000000000010","fromSide":"bottom","toNode":"1000000000000011","toSide":"top","label":"选定分辨率后检查多层证据"},
    {"id":"2000000000000021","fromNode":"1000000000000010","fromSide":"right","toNode":"1000000000000022","toSide":"left","label":"选择过程不会产生无条件真值"},
    {"id":"200000000000001c","fromNode":"1000000000000011","fromSide":"bottom","toNode":"1000000000000012","toSide":"top","label":"验证强度约束可赋予的实质含义"},
    {"id":"200000000000001d","fromNode":"1000000000000012","fromSide":"bottom","toNode":"1000000000000013","toSide":"top","label":"数据生成的簇标签进入选择后推断边界"}
  ]
}
