      "toNode": "c81000000000000b",
      "toSide": "left",
      "label": "相同拟合项，不同惩罚与目标",
      "toEnd": "arrow"
    },
    {
      "id": "d81000000000000a",
      "fromNode": "c81000000000000b",
      "fromSide": "right",
      "toNode": "c81000000000000c",
      "toSide": "left",
      "label": "若据数据选择，后续推断另行校准",
      "toEnd": "arrow"
    },
    {
      "id": "d81000000000000b",
      "fromNode": "c810000000000006",
      "fromSide": "bottom",
      "toNode": "c81000000000000d",
      "toSide": "top",
      "label": "训练改善不代表未见数据改善",
      "toEnd": "arrow"
    },
    {
      "id": "d81000000000000c",
      "fromNode": "c81000000000000d",
