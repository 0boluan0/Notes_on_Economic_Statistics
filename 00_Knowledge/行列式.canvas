    {"id":"edge-inverse-adjugate-inverse","fromNode":"dep-inverse-second","fromSide":"right","toNode":"det-adjugate-inverse","toSide":"left","toEnd":"arrow","label":"把乘积恒等式读成逆矩阵"},
    {"id":"edge-adjugate-inverse-cramer","fromNode":"det-adjugate-inverse","fromSide":"bottom","toNode":"det-cramer","toSide":"top","toEnd":"arrow","label":"代入 x=A⁻¹b"}
  ]
}
