    {"id":"edge-elimination-invertible","fromNode":"det-elimination","fromSide":"bottom","toNode":"det-invertible","toSide":"top","toEnd":"arrow","label":"主元全在 ⇔ 行列式非零"},

    {"id":"edge-rowops-scale","fromNode":"det-rowops","fromSide":"right","toNode":"det-scale","toSide":"left","toEnd":"arrow","label":"n 行各贡献一次 c"},
    {"id":"edge-elimination-transpose","fromNode":"det-elimination","fromSide":"right","toNode":"det-transpose","toSide":"left","toEnd":"arrow","label":"消元分解提供证明"},
    {"id":"edge-product-transpose","fromNode":"det-product","fromSide":"bottom","toNode":"det-transpose","toSide":"top","toEnd":"arrow","label":"乘法性配合分解"},
    {"id":"edge-spectrum-eigen","fromNode":"dep-spectrum","fromSide":"bottom","toNode":"det-eigen-product","toSide":"top","toEnd":"arrow","label":"按底层域和代数重数计根"},

    {"id":"edge-product-volume","fromNode":"det-product","fromSide":"right","toNode":"det-volume","toSide":"left","toEnd":"arrow","label":"复合缩放验证体积解释"},
    {"id":"edge-volume-simplex","fromNode":"det-volume","fromSide":"bottom","toNode":"det-simplex-volume","toSide":"top","toEnd":"arrow","label":"平行多面体体积除以 n!"},
    {"id":"edge-volume-condition","fromNode":"det-volume","fromSide":"left","toNode":"det-condition","toSide":"left","toEnd":"arrow","label":"总体积乘积看不见最弱方向"},
    {"id":"edge-product-condition","fromNode":"det-product","fromSide":"right","toNode":"det-condition","toSide":"left","toEnd":"arrow","label":"对 SVD 取行列式"},
    {"id":"edge-svd-condition","fromNode":"dep-svd","fromSide":"left","toNode":"det-condition","toSide":"right","toEnd":"arrow","label":"比较最大与最小奇异值"},
    {"id":"edge-volume-bridge","fromNode":"det-volume","fromSide":"bottom","toNode":"bridge-jacobian-volume","toSide":"left","toEnd":"arrow","label":"提供线性体积解释"},
    {"id":"edge-jacobian-bridge","fromNode":"dep-jacobian","fromSide":"bottom","toNode":"bridge-jacobian-volume","toSide":"top","toEnd":"arrow","label":"先判断导数矩阵的形状"},
    {"id":"edge-bridge-square","fromNode":"bridge-jacobian-volume","fromSide":"left","toNode":"det-jacobian-square","toSide":"right","toEnd":"arrow","label":"n 维到 n 维：det J"},
    {"id":"edge-bridge-rect","fromNode":"bridge-jacobian-volume","fromSide":"bottom","toNode":"det-jacobian-rect","toSide":"top","toEnd":"arrow","label":"k 维到 n 维：√det(JᵀJ)"},

    {"id":"edge-leibniz-cofactor","fromNode":"det-leibniz","fromSide":"bottom","toNode":"det-cofactor-expansion","toSide":"top","toEnd":"arrow","label":"按固定行列分组排列项"},
