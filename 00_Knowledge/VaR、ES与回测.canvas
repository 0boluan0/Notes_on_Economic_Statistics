		{"id":"edge-var-008","fromNode":"rm-var-020","fromSide":"bottom","toNode":"rm-var-005","toSide":"top","label":"VaR 可能违背次可加"},
		{"id":"edge-var-009","fromNode":"rm-var-005","fromSide":"bottom","toNode":"rm-var-021","toSide":"top","label":"ES 给出相反的聚合性质"},
		{"id":"edge-var-010","fromNode":"rm-var-021","fromSide":"bottom","toNode":"rm-var-011","toSide":"top","label":"推广到分位权重族"},
		{"id":"edge-var-011","fromNode":"rm-var-011","fromSide":"left","toNode":"rm-var-040","toSide":"right","label":"ES 谱权重"},
		{"id":"edge-var-012","fromNode":"rm-var-011","fromSide":"left","toNode":"rm-var-041","toSide":"right","label":"VaR 单点类比不属于普通光谱"},
		{"id":"edge-var-013","fromNode":"rm-var-014","fromSide":"bottom","toNode":"rm-var-004","toSide":"top","label":"解析模型仍需期限假设"},
		{"id":"edge-var-014","fromNode":"rm-var-004","fromSide":"bottom","toNode":"rm-var-063","toSide":"top","label":"持有期与估计窗口分开"},
		{"id":"edge-var-015","fromNode":"rm-var-063","fromSide":"bottom","toNode":"rm-var-006","toSide":"top","label":"窗口设计形成统计权衡"},
		{"id":"edge-var-016","fromNode":"rm-var-006","fromSide":"bottom","toNode":"rm-var-013","toSide":"top","label":"窗口决定尾部信息量"},
		{"id":"edge-var-033","fromNode":"rm-var-006","fromSide":"right","toNode":"rm-var-060","toSide":"right","label":"先冻结"},
		{"id":"edge-var-017","fromNode":"rm-var-012","fromSide":"bottom","toNode":"rm-var-026","toSide":"top","label":"先求局部导数"},
		{"id":"edge-var-018","fromNode":"rm-var-026","fromSide":"bottom","toNode":"rm-var-027","toSide":"top","label":"乘以当前头寸得到成分"},
		{"id":"edge-var-019","fromNode":"rm-var-027","fromSide":"bottom","toNode":"rm-var-043","toSide":"top","label":"再检查 Euler 精确加总条件"},
		{"id":"edge-var-020","fromNode":"rm-var-012","fromSide":"right","toNode":"rm-var-028","toSide":"right","label":"有限变动"},
		{"id":"edge-var-021","fromNode":"rm-var-027","fromSide":"right","toNode":"rm-var-042","toSide":"right","label":"CVaR 缩写必须按公式消歧"},
		{"id":"edge-var-022","fromNode":"rm-var-007","fromSide":"right","toNode":"bridge-frtb-regulatory","toSide":"left","label":"监管损益分支"},
		{"id":"edge-var-023","fromNode":"rm-var-007","fromSide":"bottom","toNode":"rm-var-008","toSide":"top","label":"一般回测先统计例外总数"},
		{"id":"edge-var-024","fromNode":"rm-var-008","fromSide":"bottom","toNode":"rm-var-023","toSide":"top","label":"再检查例外顺序"},
		{"id":"edge-var-025","fromNode":"rm-var-023","fromSide":"bottom","toNode":"rm-var-009","toSide":"top","label":"联合频率与独立性"},
		{"id":"edge-var-026","fromNode":"rm-var-010","fromSide":"bottom","toNode":"rm-var-025","toSide":"top","label":"说明朴素超越均值为何不够"},
		{"id":"edge-var-027","fromNode":"rm-var-010","fromSide":"left","toNode":"rm-var-024","toSide":"left","fromEnd":"none","toEnd":"none","label":"校准 ≠ 评分"},
		{"id":"edge-var-028","fromNode":"bridge-frtb-regulatory","fromSide":"right","toNode":"rm-var-022","toSide":"left","label":"APL/HPL/RTPL"},
		{"id":"edge-var-029","fromNode":"rm-var-022","fromSide":"bottom","toNode":"rm-var-052","toSide":"top","label":"监管结果仍需进入验证框架"},
		{"id":"edge-var-030","fromNode":"rm-var-052","fromSide":"bottom","toNode":"rm-var-016","toSide":"top","label":"回测只覆盖结果分析的一部分"},
		{"id":"edge-var-031","fromNode":"rm-var-015","fromSide":"bottom","toNode":"rm-var-050","toSide":"top","label":"历史资本块同时保留两类 VaR"},
